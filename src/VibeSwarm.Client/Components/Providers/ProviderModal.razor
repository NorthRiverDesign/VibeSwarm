@* Modal component for adding and editing providers *@
@inject IProviderService ProviderService
@inject NotificationService NotificationService

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="HandleModalVisibilityChanged"
			 Title="@(IsEdit ? "Edit Provider" : "Add Provider")" Icon="@(IsEdit ? "pencil" : "plus-circle")"
			 Size="ModalDialog.ModalSize.Default" OnClose="HandleClose">
	<ChildContent>
		<EditForm Model="@Provider" OnValidSubmit="HandleValidSubmit">
			<DataAnnotationsValidator />
			<ValidationSummary class="fg-danger mb-5" />

			<div class="mb-5">
				<label for="modal-name" class="form-label">Name</label>
				<InputText id="modal-name" @bind-Value="Provider.Name" class="form-control"
						   placeholder="My OpenCode Provider" />
				<ValidationMessage For="@(() => Provider.Name)" class="fg-danger small" />
			</div>

			<div class="mb-5">
				<label for="modal-type" class="form-label">Provider Type</label>
				<InputSelect id="modal-type" Value="Provider.Type" ValueExpression="@(() => Provider.Type)"
							 ValueChanged="@((ProviderType value) => OnProviderTypeChanged(value))" class="form-control">
					@foreach (var type in Enum.GetValues<ProviderType>())
					{
						<option value="@type">@type</option>
					}
				</InputSelect>
				<div class="form-text">@ProviderCapabilities.GetDescription(Provider.Type)</div>
			</div>

			<div class="mb-5">
				<label for="modal-connectionMode" class="form-label">Connection Mode</label>
				@{
					var supportedModes = ProviderCapabilities.GetSupportedModes(Provider.Type);
				}
				@if (supportedModes.Count == 1)
				{
					<input type="text" class="form-control" value="@supportedModes[0]" disabled />
					<div class="form-text fg-1">
						<i class="bi bi-info-circle me-1"></i>
						@Provider.Type only supports @supportedModes[0] mode.
					</div>
				}
				else
				{
					<InputSelect id="modal-connectionMode" @bind-Value="Provider.ConnectionMode" class="form-control">
						@foreach (var mode in supportedModes)
						{
							<option value="@mode">@mode</option>
						}
					</InputSelect>
				}
				<div class="form-text">@ProviderCapabilities.GetModeDescription(Provider.Type, Provider.ConnectionMode)</div>
			</div>

			@if (Provider.ConnectionMode == ProviderConnectionMode.CLI)
			{
				<div class="mb-5">
					<label for="modal-executablePath" class="form-label">Executable Path (optional)</label>
					<InputText id="modal-executablePath" @bind-Value="Provider.ExecutablePath" class="form-control"
							   placeholder="@GetExecutablePlaceholder()" />
					<div class="form-text">@GetExecutableHelpText()</div>
				</div>
			}
			else if (Provider.ConnectionMode == ProviderConnectionMode.SDK)
			{
				<div class="mb-5">
					<div class="form-label">Connection Type</div>
					<div class="form-control-plaintext py-0 small fg-1">
						@ProviderCapabilities.GetConnectionTypeLabel(Provider)
					</div>
				</div>
				@if (Provider.Type == ProviderType.Claude)
				{
					<div class="mb-5">
						<label for="modal-apiKey" class="form-label">
							API Key <span class="fg-danger">*</span>
						</label>
						<InputText id="modal-apiKey" @bind-Value="Provider.ApiKey" class="form-control" type="password"
							placeholder="sk-ant-..." />
						<div class="form-text">Your Anthropic API key for direct SDK access.</div>
						@if (string.IsNullOrWhiteSpace(Provider.ApiKey))
						{
							<div class="fg-warning small mt-1">
								<i class="bi bi-exclamation-triangle me-1"></i>
								API Key is required for Claude SDK mode.
							</div>
						}
					</div>
					<div class="mb-5">
						<label for="modal-apiEndpoint" class="form-label">API Endpoint (optional)</label>
						<InputText id="modal-apiEndpoint" @bind-Value="Provider.ApiEndpoint" class="form-control"
							placeholder="https://api.anthropic.com" />
						<div class="form-text">Leave empty to use the default Anthropic API endpoint.</div>
					</div>
				}
				@if (Provider.Type == ProviderType.Copilot)
				{
					<div class="mb-5">
						<label for="modal-apiEndpoint" class="form-label">Custom API Provider (optional, BYOK)</label>
						<InputText id="modal-apiEndpoint" @bind-Value="Provider.ApiEndpoint" class="form-control"
							placeholder="https://api.openai.com/v1" />
						<div class="form-text">Leave empty to use GitHub Copilot. Set a custom provider endpoint to run this SDK connection in BYOK mode.</div>
					</div>
					<div class="mb-5">
						<label for="modal-apiKey" class="form-label">
							@(IsCopilotCustomProvider ? "Provider API Key" : "GitHub Token (optional)")
							@if (IsCopilotCustomProvider)
							{
								<span class="fg-danger"> *</span>
							}
						</label>
						<InputText id="modal-apiKey" @bind-Value="Provider.ApiKey" class="form-control" type="password"
							placeholder="@(IsCopilotCustomProvider ? "sk-... or provider key" : "github_pat_...")" />
						<div class="form-text">
							@if (IsCopilotCustomProvider)
							{
								<span>This key is sent to the configured BYOK provider endpoint. It is not reused as a GitHub token.</span>
							}
							else
							{
								<span>Leave empty to use the logged-in Copilot CLI user, or provide a GitHub token for explicit SDK authentication.</span>
							}
						</div>
					</div>
					<div class="mb-5">
						<label for="modal-executablePath" class="form-label">Copilot CLI Path (optional)</label>
						<InputText id="modal-executablePath" @bind-Value="Provider.ExecutablePath" class="form-control"
							placeholder="copilot or /path/to/copilot" />
						<div class="form-text">The SDK communicates with Copilot CLI in server mode via JSON-RPC. Leave empty to use <code>copilot</code> from PATH.</div>
					</div>
				}
			}
			else
			{
				<div class="mb-5">
					<label for="modal-apiEndpoint" class="form-label">
						API Endpoint <span class="fg-danger">*</span>
					</label>
					<InputText id="modal-apiEndpoint" @bind-Value="Provider.ApiEndpoint" class="form-control"
							   placeholder="http://localhost:8080" />
					<ValidationMessage For="@(() => Provider.ApiEndpoint)" class="fg-danger small" />
					@if (Provider.ConnectionMode == ProviderConnectionMode.REST &&
																			string.IsNullOrWhiteSpace(Provider.ApiEndpoint))
					{
						<div class="fg-warning small mt-1">
							<i class="bi bi-exclamation-triangle me-1"></i>
							API Endpoint is required for REST connection mode.
						</div>
					}
				</div>

				<div class="mb-5">
					<label for="modal-apiKey" class="form-label">API Key (optional)</label>
					<InputText id="modal-apiKey" @bind-Value="Provider.ApiKey" class="form-control" type="password" />
				</div>
			}

			<div class="mb-5">
				<label for="modal-maxExecutionMinutes" class="form-label">Max Execution Time (optional)</label>
				<div class="input-group">
					<InputNumber id="modal-maxExecutionMinutes" @bind-Value="Provider.MaxExecutionMinutes"
								 class="form-control" placeholder="720" min="1" max="10080" />
					<span class="input-group-text">minutes</span>
				</div>
				<div class="form-text">A job is stopped after working this long, and its work so far is kept. Waiting
					for your answer doesn't count. Leave empty for 12 hours.</div>
				</div>

				<div class="mb-5">
					<label for="modal-defaultReasoning" class="form-label">Default Reasoning</label>
					<InputSelect id="modal-defaultReasoning" @bind-Value="Provider.DefaultReasoningEffort" class="form-control" disabled="@(!ReasoningOptions.Any())">
						<option value="">Use provider default behavior</option>
						@foreach (var reasoning in ReasoningOptions)
						{
							<option value="@reasoning">@reasoning</option>
						}
					</InputSelect>
					<div class="form-text">
						@if (!ReasoningOptions.Any())
						{
							<span>This provider/mode does not expose configurable reasoning levels.</span>
						}
						else
						{
							<span>New jobs and project defaults can inherit this reasoning level unless they override it.</span>
						}
					</div>
				</div>

				@* Usage Limit Configuration *@
				@if (Provider.Type == ProviderType.Copilot || Provider.Type == ProviderType.Claude)
				{
					<div class="mb-5 p-5 rounded bg-1">
						<h6 class="fw-semibold mb-5">
							<i class="bi bi-graph-up me-3"></i>Usage Limit Configuration
						</h6>

						@if (Provider.Type == ProviderType.Copilot)
						{
							<div class="mb-3">
								<label for="modal-usageLimit" class="form-label">Monthly Premium Request Limit</label>
								<InputNumber id="modal-usageLimit" @bind-Value="Provider.ConfiguredUsageLimit" class="form-control"
											 placeholder="300" min="1" />
								<div class="form-text">
									Set your Copilot plan's monthly premium request limit (e.g., 300 for Copilot Pro, 1000 for
									Business).
									Jobs will be blocked when this limit is reached.
								</div>
							</div>
						}
						else if (Provider.Type == ProviderType.Claude)
						{
							<div class="mb-3">
								<label for="modal-limitType" class="form-label">Limit Type</label>
								<InputSelect id="modal-limitType" @bind-Value="Provider.ConfiguredLimitType" class="form-control">
									<option value="@UsageLimitType.None">Auto-detect from CLI</option>
									<option value="@UsageLimitType.TokenLimit">Tokens</option>
									<option value="@UsageLimitType.SessionLimit">Session</option>
								</InputSelect>
							</div>
							@if (Provider.ConfiguredLimitType != UsageLimitType.None)
							{
								<div class="mb-3">
									<label for="modal-usageLimit" class="form-label">
										@(Provider.ConfiguredLimitType == UsageLimitType.TokenLimit ? "Token Limit" : "Session Limit")
									</label>
									<InputNumber id="modal-usageLimit" @bind-Value="Provider.ConfiguredUsageLimit" class="form-control"
												 placeholder="Enter limit" min="1" />
									<div class="form-text">
										@if (Provider.ConfiguredLimitType == UsageLimitType.TokenLimit)
										{
											<text>Maximum tokens per period. Jobs will be blocked when this limit is reached.</text>
										}
										else
										{
											<text>Maximum usage per session. Jobs will be blocked when this limit is reached.</text>
										}
									</div>
								</div>
							}
						}

						@if (SessionLimitPolicy.HasSessionLimit(Provider.Type))
						{
							<div class="mb-3">
								<label for="modal-sessionPauseThreshold" class="form-label">Pause at session usage</label>
								<div class="input-group">
									<InputNumber id="modal-sessionPauseThreshold" @bind-Value="Provider.SessionLimitPauseThresholdPercent"
												 class="form-control" placeholder="@SessionLimitPolicy.DefaultPauseThresholdPercent"
												 min="@SessionLimitPolicy.MinPauseThresholdPercent" max="@SessionLimitPolicy.MaxPauseThresholdPercent" />
									<span class="input-group-text">%</span>
								</div>
								<ValidationMessage For="@(() => Provider.SessionLimitPauseThresholdPercent)" class="fg-danger small" />
								<div class="form-text">
									Session usage is checked before each job. From this point, or sooner when the next job would
									likely use up the rest, jobs wait for the session to reset. Leave empty for
									@(SessionLimitPolicy.DefaultPauseThresholdPercent)%.
								</div>
							</div>
						}
					</div>
				}

				<div class="mb-5 form-field">
					<InputCheckbox id="modal-isEnabled" @bind-Value="Provider.IsEnabled" class="check" />
					<label for="modal-isEnabled">Enabled</label>
				</div>

				@if (ValidationErrors.Any())
				{
					<Alert Type="Alert.AlertType.Warning" Class="mb-5">
						<strong>Please fix the following issues:</strong>
						<ul class="mb-0 mt-3">
							@foreach (var error in ValidationErrors)
							{
								<li>@error</li>
							}
						</ul>
					</Alert>
				}

				@if (!string.IsNullOrEmpty(ErrorMessage))
				{
					<div class="fg-danger small mb-5">
						<i class="bi bi-exclamation-circle me-1"></i>@ErrorMessage
					</div>
				}

				<div class="d-flex gap-3 justify-content-end">
					<button type="button" class="btn-solid theme-secondary" @onclick="HandleCancel">Cancel</button>
					<button type="submit" class="btn-solid theme-primary" disabled="@(IsSaving || ValidationErrors.Any())">
						@if (IsSaving)
						{
							<span class="spinner-border spinner-sm me-1" role="status"></span>
						}
						@(IsSaving ? "Saving..." : (IsEdit ? "Update Provider" : "Add Provider"))
					</button>
				</div>
			</EditForm>
		</ChildContent>
	</ModalDialog>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public EventCallback<bool> IsVisibleChanged { get; set; }

	[Parameter]
	public Provider? EditProvider { get; set; }

	[Parameter]
	public ProviderType? SuggestedProviderType { get; set; }

	[Parameter]
	public ProviderConnectionMode? SuggestedConnectionMode { get; set; }

	[Parameter]
	public EventCallback<Guid?> OnSaved { get; set; }

	[Parameter]
	public EventCallback OnCancelled { get; set; }

	[Parameter]
	public EventCallback OnClosed { get; set; }

	private Provider Provider { get; set; } = new();
	private bool IsEdit => EditProvider != null;
	private bool IsSaving { get; set; }
	private string? ErrorMessage { get; set; }
	private bool _previousIsVisible;

	private IReadOnlyList<string> ValidationErrors => ProviderCapabilities.ValidateConfiguration(Provider);
	private IReadOnlyList<string> ReasoningOptions => ProviderCapabilities.GetSupportedReasoningEfforts(Provider);
	private bool IsCopilotCustomProvider => ProviderCapabilities.IsCopilotCustomProvider(Provider);

	protected override void OnParametersSet()
	{
		// Only reset state when modal is opening (transitioning from hidden to visible)
		if (IsVisible && !_previousIsVisible)
		{
			ResetState();

			if (EditProvider != null)
			{
				// Clone the provider for editing
				Provider = new Provider
				{
					Id = EditProvider.Id,
					Name = EditProvider.Name,
					Type = EditProvider.Type,
					ConnectionMode = EditProvider.ConnectionMode,
					ExecutablePath = EditProvider.ExecutablePath,
					ApiEndpoint = EditProvider.ApiEndpoint,
					ApiKey = EditProvider.ApiKey,
					DefaultReasoningEffort = EditProvider.DefaultReasoningEffort,
					IsEnabled = EditProvider.IsEnabled,
					MaxExecutionMinutes = EditProvider.MaxExecutionMinutes,
					ConfiguredUsageLimit = EditProvider.ConfiguredUsageLimit,
					ConfiguredLimitType = EditProvider.ConfiguredLimitType,
					SessionLimitPauseThresholdPercent = EditProvider.SessionLimitPauseThresholdPercent,
					CreatedAt = EditProvider.CreatedAt,
					LastConnectedAt = EditProvider.LastConnectedAt
				};

				// Ensure connection mode is valid for the provider type
				if (!ProviderCapabilities.SupportsMode(Provider.Type, Provider.ConnectionMode))
				{
					Provider.ConnectionMode = ProviderCapabilities.GetDefaultMode(Provider.Type);
				}
			}
			else
			{
				var providerType = SuggestedProviderType ?? ProviderType.OpenCode;
				var connectionMode = SuggestedConnectionMode.HasValue && ProviderCapabilities.SupportsMode(providerType, SuggestedConnectionMode.Value)
					? SuggestedConnectionMode.Value
					: ProviderCapabilities.GetDefaultMode(providerType);

				// Reset for new provider with default settings
				Provider = new Provider
				{
					Type = providerType,
					ConnectionMode = connectionMode,
					ConfiguredLimitType = providerType == ProviderType.Copilot
						? UsageLimitType.PremiumRequests
						: UsageLimitType.None
				};
			}
		}

		_previousIsVisible = IsVisible;
	}

	private void OnProviderTypeChanged(ProviderType newType)
	{
		Provider.Type = newType;
		// Update connection mode to default for the new provider type
		Provider.ConnectionMode = ProviderCapabilities.GetDefaultMode(newType);
		// Set default limit type based on provider
		Provider.ConfiguredLimitType = newType == ProviderType.Copilot
		? UsageLimitType.PremiumRequests
		: UsageLimitType.None;
	}

	private string GetExecutablePlaceholder() => Provider.Type switch
	{
		ProviderType.OpenCode => "opencode or /path/to/opencode",
		ProviderType.Claude => "claude or /path/to/claude",
		ProviderType.Copilot => "copilot or /path/to/copilot",
		_ => "executable name or path"
	};

	private string GetExecutableHelpText() => Provider.Type switch
	{
		ProviderType.OpenCode => "Leave empty to use 'opencode' from PATH",
		ProviderType.Claude => "Leave empty to use 'claude' from PATH",
		ProviderType.Copilot => "Leave empty to use 'copilot' from PATH",
		_ => "Leave empty to use default executable from PATH"
	};

	private async Task HandleValidSubmit()
	{
		// Additional validation
		var errors = ProviderCapabilities.ValidateConfiguration(Provider);
		if (errors.Any())
		{
			ErrorMessage = string.Join(" ", errors);
			return;
		}

		IsSaving = true;
		ErrorMessage = null;

		try
		{
			Guid? newProviderId = null;

			if (IsEdit)
			{
				await ProviderService.UpdateAsync(Provider);
				NotificationService.ShowSuccess("Provider updated successfully.");
			}
			else
			{
				var created = await ProviderService.CreateAsync(Provider);
				newProviderId = created.Id;
				NotificationService.ShowSuccess("Provider added successfully.");
			}

			await OnSaved.InvokeAsync(newProviderId);
			await CloseModal();
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Error saving provider: {ex.Message}";
		}
		finally
		{
			IsSaving = false;
		}
	}

	private async Task HandleCancel()
	{
		await OnCancelled.InvokeAsync();
		await CloseModal();
	}

	private async Task HandleClose()
	{
		ResetState();
		await OnClosed.InvokeAsync();
	}

	private async Task HandleModalVisibilityChanged(bool visible)
	{
		if (!visible)
		{
			ResetState();
			await IsVisibleChanged.InvokeAsync(false);
		}
	}

	private async Task CloseModal()
	{
		IsVisible = false;
		await IsVisibleChanged.InvokeAsync(false);
		ResetState();
	}

	private void ResetState()
	{
		Provider = new Provider();
		ErrorMessage = null;
		IsSaving = false;
	}
}
