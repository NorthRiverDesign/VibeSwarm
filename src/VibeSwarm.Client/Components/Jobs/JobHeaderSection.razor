@* Job page header, laid out as an iOS navigation bar over a large title. The bar holds the back
   link and the job's actions and stays pinned while the page scrolls, so Stop is in reach from the
   newest message. Every way to stop the job sits behind the one stop button; the rest behind ⋯.
   The title is clamped to two lines (the whole goal opens the conversation below), and one quiet
   status line opens the remaining facts. *@

<div class="job-nav-bar sticky-top d-flex align-items-center gap-3 py-1">
	<a href="@BackHref" class="small fg-1 text-decoration-none d-inline-flex align-items-center gap-1 me-auto min-w-0">
		<i class="bi bi-chevron-left"></i><span class="text-truncate">@BackLabel</span>
	</a>
	@if (HasMoreMenu)
	{
		<div>
			<button type="button" class="btn-solid theme-secondary rounded-circle p-0 icon-button-round"
					data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false"
					title="Job actions" aria-label="Job actions">
				<i class="bi bi-three-dots"></i>
			</button>
			<div class="menu">
				@if (CanRetry)
				{
					<button type="button" class="menu-item" @onclick="OnRetry" disabled="@IsRetrying">
						<i class="bi bi-arrow-repeat @(IsRetrying ? "spinner-rotate" : null)"></i>@(IsRetrying ? "Retrying…" : "Retry")
					</button>
					@if (ShowRetryOptions)
					{
						<button type="button" class="menu-item" @onclick="OnRetryWithOptions" disabled="@IsRetrying">
							<i class="bi bi-sliders"></i>Retry with options…
						</button>
					}
				}
				@if (ShowGitActions)
				{
					@if (CanRetry)
					{
						<hr class="menu-divider">
					}
					<h6 class="menu-header">Git</h6>
					<button type="button" class="menu-item" @onclick="OnCreateBranch" disabled="@AreGitActionsBusy">
						<i class="bi bi-plus-lg"></i>New branch
					</button>
					<button type="button" class="menu-item" @onclick="OnSync" disabled="@AreGitActionsBusy">
						<i class="bi bi-cloud-download @(IsGitSyncing ? "spinner-rotate" : null)"></i>Sync with origin
					</button>
					<button type="button" class="menu-item" @onclick="OnPruneBranches" disabled="@AreGitActionsBusy">
						<i class="bi bi-scissors @(IsGitPruning ? "spinner-rotate" : null)"></i>Prune stale branches
					</button>
					<button type="button" class="menu-item" @onclick="OnRefresh" disabled="@AreGitActionsBusy">
						<i class="bi bi-arrow-clockwise @(IsGitRefreshing ? "spinner-rotate" : null)"></i>Refresh branches
					</button>
				}
			</div>
		</div>
	}
	@if (HasStopMenu)
	{
		<div>
			<button type="button" class="btn-solid theme-secondary rounded-circle p-0 icon-button-round fg-danger"
					data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false"
					title="Stop" aria-label="Stop" disabled="@IsStopBusy">
				@if (IsStopBusy)
				{
					<span class="spinner-border spinner-sm" role="status"></span>
				}
				else
				{
					<i class="bi bi-stop-fill"></i>
				}
			</button>
			<div class="menu">
				@if (CanCancel)
				{
					<button type="button" class="menu-item theme-danger" @onclick="OnCancel">
						<i class="bi bi-stop-circle"></i>@(IsQueued ? "Cancel job" : "Stop job")
					</button>
				}
				@if (CanForceCancel)
				{
					<button type="button" class="menu-item theme-danger" @onclick="OnForceCancel">
						<i class="bi bi-x-octagon"></i>Force stop
					</button>
				}
				@if (CanForceReset)
				{
					@if (CanCancel || CanForceCancel)
					{
						<hr class="menu-divider">
					}
					<button type="button" class="menu-item theme-danger" @onclick="OnForceReset">
						<i class="bi bi-exclamation-triangle"></i>Mark as failed
					</button>
				}
			</div>
		</div>
	}
	@if (CanEdit)
	{
		<TitleAction Icon="pencil" Label="Edit job" OnClick="OnEdit" />
	}
	@if (CanResume)
	{
		<TitleAction Icon="play-fill" Label="@(IsResuming ? "Resuming…" : "Resume")" Primary="true"
					 IsLoading="@IsResuming" OnClick="OnResume" />
	}
</div>

<div class="d-flex flex-column gap-1 mb-5">
	<h1 class="mb-0 text-break @(_isTitleExpanded ? null : "line-clamp-2")" title="@JobTitle"
		@onclick="@(() => _isTitleExpanded = !_isTitleExpanded)">@(string.IsNullOrEmpty(JobTitle) ? "Job" : JobTitle)</h1>

	@* The status line opens the full fact list, so the header stays two lines tall until asked. *@
	<details class="job-details">
		<summary class="d-flex flex-wrap align-items-center column-gap-3 row-gap-1 small fg-1 cursor-pointer user-select-none">
			<span class="d-inline-flex align-items-center gap-1 fw-medium @StatusClass">
				@if (IsRunning && !CancellationRequested)
				{
					<span class="live-dot"></span>
				}
				@StatusText
			</span>
			@if (DurationText is { } duration)
			{
				<span class="fg-2" aria-hidden="true">·</span>
				<span title="@(ExecutionDuration.HasValue ? "Execution time" : "Running time")">@duration</span>
			}
			@if (!string.IsNullOrEmpty(ProviderModelDisplay))
			{
				<span class="fg-2" aria-hidden="true">·</span>
				<span class="text-break" title="Provider chain and model">@ProviderModelDisplay</span>
			}
			@if (MaxCycles > 1)
			{
				<span class="fg-2" aria-hidden="true">·</span>
				<span title="@GetCycleModeTitle()">Cycle @CurrentCycle of @MaxCycles</span>
			}
			<span class="d-inline-flex align-items-center gap-1 fg-primary">
				Details<i class="bi bi-chevron-right details-chevron small"></i>
			</span>
		</summary>

		<dl class="d-flex flex-column gap-3 small mb-0 mt-3 p-5 bg-1 rounded-5">
			@if (!string.IsNullOrEmpty(BranchName))
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Branch</dt>
					<dd class="mb-0 text-end text-break font-monospace">@BranchName</dd>
				</div>
			}
			@if (!string.IsNullOrEmpty(AgentName))
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Team role</dt>
					<dd class="mb-0 text-end text-break">@AgentName</dd>
				</div>
			}
			@if (RetryCount > 0)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Attempt</dt>
					<dd class="mb-0 text-end">@(RetryCount + 1)</dd>
				</div>
			}
			<div class="d-flex justify-content-between gap-5">
				<dt class="fw-normal fg-1 flex-shrink-0">Queued</dt>
				<dd class="mb-0 text-end">@CreatedAt.FormatDateTimeShort()</dd>
			</div>
			@if (StartedAt.HasValue)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Started</dt>
					<dd class="mb-0 text-end">@StartedAt.Value.FormatDateTimeShort()</dd>
				</div>
			}
			@if (CompletedAt.HasValue)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Finished</dt>
					<dd class="mb-0 text-end">@CompletedAt.Value.FormatDateTimeShort()</dd>
				</div>
			}
			@if (HasTokens)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">@(IsTokenEstimate ? "Tokens (estimated)" : "Tokens")</dt>
					<dd class="mb-0 text-end">@TokenSummary</dd>
				</div>
			}
			@if (!IsTokenEstimate && TotalCostUsd.HasValue && TotalCostUsd.Value > 0)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Cost</dt>
					<dd class="mb-0 text-end">@TokenHelper.FormatCost(TotalCostUsd.Value)</dd>
				</div>
			}
			@if (ShowPlanningBreakdown)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Planning</dt>
					<dd class="mb-0 text-end">@StageUsageSummary(PlanningInputTokens, PlanningOutputTokens, IsTokenEstimate ? null : PlanningCostUsd, IsTokenEstimate)</dd>
				</div>
			}
			@if (ShowExecutionBreakdown)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Execution</dt>
					<dd class="mb-0 text-end">@StageUsageSummary(ExecutionInputTokens, ExecutionOutputTokens, IsTokenEstimate ? null : ExecutionCostUsd, IsTokenEstimate)</dd>
				</div>
			}
			@if (EnvironmentCount > 0)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Environments</dt>
					<dd class="mb-0 text-end text-break">@EnvironmentTooltip</dd>
				</div>
			}
			@if (PlaywrightEnabled)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Browser</dt>
					<dd class="mb-0 text-end">Playwright</dd>
				</div>
			}
			@if (ProcessId.HasValue)
			{
				<div class="d-flex justify-content-between gap-5">
					<dt class="fw-normal fg-1 flex-shrink-0">Process ID</dt>
					<dd class="mb-0 text-end font-monospace">@ProcessId</dd>
				</div>
			}
		</dl>
	</details>
</div>

@code {
	[Parameter, EditorRequired]
	public JobStatus Status { get; set; }

	/// <summary>
	/// The job title to display in the header (uses Title property from job, which is the original idea text for idea-based
	/// </summary>
	[Parameter]
	public string? JobTitle { get; set; }

	[Parameter]
	public bool CancellationRequested { get; set; }

	/// <summary>Where the back link goes: the page the job was opened from, else its project.</summary>
	[Parameter]
	public string BackHref { get; set; } = "/projects";

	[Parameter]
	public string BackLabel { get; set; } = "Projects";

	[Parameter]
	public string? GitHubRepository { get; set; }

	[Parameter]
	public string? BranchName { get; set; }

	[Parameter]
	public Guid ProjectId { get; set; }

	[Parameter]
	public string ProjectName { get; set; } = "Unknown";

	[Parameter]
	public string ProviderName { get; set; } = "Unknown";

	[Parameter]
	public int? ProcessId { get; set; }

	[Parameter]
	public DateTime CreatedAt { get; set; }

	[Parameter]
	public DateTime? StartedAt { get; set; }

	[Parameter]
	public DateTime? CompletedAt { get; set; }

	[Parameter]
	public TimeSpan? ExecutionDuration { get; set; }

	[Parameter]
	public string? ModelUsed { get; set; }

	[Parameter]
	public string? PlanningProviderName { get; set; }

	[Parameter]
	public string? PlanningModelUsed { get; set; }

	[Parameter]
	public int RetryCount { get; set; }

	[Parameter]
	public int? InputTokens { get; set; }

	[Parameter]
	public int? OutputTokens { get; set; }

	[Parameter]
	public decimal? TotalCostUsd { get; set; }

	[Parameter]
	public int? PlanningInputTokens { get; set; }

	[Parameter]
	public int? PlanningOutputTokens { get; set; }

	[Parameter]
	public decimal? PlanningCostUsd { get; set; }

	[Parameter]
	public int? ExecutionInputTokens { get; set; }

	[Parameter]
	public int? ExecutionOutputTokens { get; set; }

	[Parameter]
	public decimal? ExecutionCostUsd { get; set; }

	[Parameter]
	public bool IsTokenEstimate { get; set; }

	[Parameter]
	public bool CanRetry { get; set; }

	/// <summary>The job stopped mid-run and can carry on where it left off.</summary>
	[Parameter]
	public bool CanResume { get; set; }

	[Parameter]
	public bool IsResuming { get; set; }

	[Parameter]
	public EventCallback OnResume { get; set; }

	[Parameter]
	public bool CanCancel { get; set; }

	[Parameter]
	public bool CanForceCancel { get; set; }

	[Parameter]
	public bool ShowRetryOptions { get; set; }

	[Parameter]
	public bool IsRetrying { get; set; }

	[Parameter]
	public bool IsCancelling { get; set; }

	[Parameter]
	public bool IsForceCancelling { get; set; }

	[Parameter]
	public bool ShowGitActions { get; set; }

	[Parameter]
	public bool IsGitSyncing { get; set; }

	[Parameter]
	public bool IsGitRefreshing { get; set; }

	[Parameter]
	public bool IsGitPruning { get; set; }

	[Parameter]
	public EventCallback OnRetry { get; set; }

	[Parameter]
	public EventCallback OnRetryWithOptions { get; set; }

	[Parameter]
	public EventCallback OnCreateBranch { get; set; }

	[Parameter]
	public EventCallback OnSync { get; set; }

	[Parameter]
	public EventCallback OnRefresh { get; set; }

	[Parameter]
	public EventCallback OnPruneBranches { get; set; }

	[Parameter]
	public bool CanForceReset { get; set; }

	[Parameter]
	public bool IsForceResetting { get; set; }

	[Parameter]
	public EventCallback OnForceReset { get; set; }

	[Parameter]
	public EventCallback OnCancel { get; set; }

	[Parameter]
	public bool CanEdit { get; set; }

	[Parameter]
	public EventCallback OnEdit { get; set; }

	[Parameter]
	public EventCallback OnForceCancel { get; set; }

	[Parameter]
	public string? CurrentActivity { get; set; }

	[Parameter]
	public DateTime? LastActivityAt { get; set; }

	[Parameter]
	public int CurrentCycle { get; set; } = 1;

	[Parameter]
	public int MaxCycles { get; set; } = 1;

	[Parameter]
	public CycleMode CycleMode { get; set; } = CycleMode.SingleCycle;

	[Parameter]
	public string? AgentName { get; set; }

	[Parameter]
	public bool PlaywrightEnabled { get; set; }

	[Parameter]
	public int EnvironmentCount { get; set; }

	[Parameter]
	public string? EnvironmentTooltip { get; set; }

	private bool _isTitleExpanded;

	private bool HasMoreMenu => CanRetry || ShowGitActions;

	private bool HasStopMenu => CanCancel || CanForceCancel || CanForceReset;

	private bool IsStopBusy => IsCancelling || IsForceCancelling || IsForceResetting;

	private bool AreGitActionsBusy => IsGitSyncing || IsGitRefreshing || IsGitPruning;

	private bool IsRunning => Status == JobStatus.Started || Status == JobStatus.Planning || Status == JobStatus.Processing;

	private bool IsQueued => Status is JobStatus.New or JobStatus.Pending;

	private string? ProviderModelDisplay => BuildProviderModelDisplay();

	private string StatusText => Status switch
	{
		_ when IsRunning && CancellationRequested => "Stopping…",
		JobStatus.New => "Queued",
		JobStatus.Started => "Starting",
		JobStatus.Processing => "Running",
		JobStatus.Paused => "Waiting for input",
		_ => Status.ToString()
	};

	private string StatusClass => Status switch
	{
		_ when IsRunning && CancellationRequested => "fg-warning",
		JobStatus.Started or JobStatus.Planning or JobStatus.Processing or JobStatus.Completed => "fg-success",
		JobStatus.Failed => "fg-danger",
		JobStatus.Paused or JobStatus.Stalled => "fg-warning",
		_ => "fg-body"
	};

	private string? DurationText => ExecutionDuration.HasValue
		? TokenHelper.FormatDuration(ExecutionDuration)
		: IsRunning && StartedAt.HasValue
			? TokenHelper.FormatDuration(DateTime.UtcNow - StartedAt.Value)
			: null;

	private bool HasTokens => (InputTokens ?? 0) > 0 || (OutputTokens ?? 0) > 0;

	private string TokenSummary
	{
		get
		{
			var prefix = IsTokenEstimate ? "~" : "";
			var parts = new List<string>();
			if ((InputTokens ?? 0) > 0)
			{
				parts.Add($"{prefix}{TokenHelper.FormatTokenCount(InputTokens!.Value)} in");
			}

			if ((OutputTokens ?? 0) > 0)
			{
				parts.Add($"{prefix}{TokenHelper.FormatTokenCount(OutputTokens!.Value)} out");
			}

			return string.Join(" · ", parts);
		}
	}

	private bool ShowPlanningBreakdown => HasStageUsage(PlanningInputTokens, PlanningOutputTokens, PlanningCostUsd);

	private bool ShowExecutionBreakdown => HasStageUsage(ExecutionInputTokens, ExecutionOutputTokens, ExecutionCostUsd);

	private string GetCycleModeTitle()
	{
		return CycleMode switch
		{
			CycleMode.FixedCount => $"Fixed Count Mode: {CurrentCycle} of {MaxCycles} cycles",
			CycleMode.Autonomous => $"Autonomous Mode: {CurrentCycle} of {MaxCycles} max cycles",
			_ => $"Cycle {CurrentCycle} of {MaxCycles}"
		};
	}

	private string? BuildProviderModelDisplay()
	{
		var planningDisplay = BuildStageProviderDisplay(PlanningProviderName, PlanningModelUsed);
		var executionDisplay = BuildStageProviderDisplay(ProviderName, ModelUsed);

		if (!string.IsNullOrWhiteSpace(planningDisplay) &&
			!string.IsNullOrWhiteSpace(executionDisplay) &&
			!string.Equals(planningDisplay, executionDisplay, StringComparison.Ordinal))
		{
			return $"{planningDisplay} -> {executionDisplay}";
		}

		return executionDisplay ?? planningDisplay;
	}

	private static bool HasStageUsage(int? inputTokens, int? outputTokens, decimal? costUsd)
	{
		return (inputTokens.HasValue && inputTokens.Value > 0) ||
			(outputTokens.HasValue && outputTokens.Value > 0) ||
			(costUsd.HasValue && costUsd.Value > 0);
	}

	private static string StageUsageSummary(int? inputTokens, int? outputTokens, decimal? costUsd, bool isEstimate = false)
	{
		var totalTokens = (inputTokens ?? 0) + (outputTokens ?? 0);
		var prefix = isEstimate ? "~" : "";
		if (!isEstimate && costUsd.HasValue && costUsd.Value > 0)
		{
			return $"{prefix}{TokenHelper.FormatTokenCount(totalTokens)} / {TokenHelper.FormatCost(costUsd.Value)}";
		}

		return $"{prefix}{TokenHelper.FormatTokenCount(totalTokens)}";
	}

	private static string? BuildStageProviderDisplay(string? providerName, string? modelName)
	{
		var parts = new List<string>();

		if (!string.IsNullOrWhiteSpace(providerName))
		{
			parts.Add(providerName);
		}

		if (!string.IsNullOrWhiteSpace(modelName))
		{
			parts.Add(modelName);
		}

		return parts.Count == 0 ? null : string.Join(" / ", parts);
	}
}
