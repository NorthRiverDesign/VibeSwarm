@* Modal component for creating new jobs *@
@using System.ComponentModel.DataAnnotations
@using VibeSwarm.Shared.Validation
@inject IServiceProvider Services
@inject IJobTemplateService JobTemplateService
@inject NotificationService NotificationService

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="IsVisibleChanged" Title="Create Job" Icon="plus-circle"
Size="ModalDialog.ModalSize.Large" OnClose="Close">
<ChildContent>
<EditForm id="@_formId" Model="@FormModel" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit">
<DataAnnotationsValidator />
<ValidationSummary class="fg-danger mb-5" />

<div class="mb-7">
<label for="jobTemplate" class="form-label">Template Library <span class="fg-1 fw-normal">(optional)</span></label>
<div class="input-group">
<InputSelect TValue="Guid?" id="jobTemplate" @bind-Value="_selectedTemplateId" @bind-Value:after="HandleTemplateSelectionChanged" class="form-control" disabled="@_isApplyingTemplate">
<option value="">Start from scratch...</option>
@foreach (var template in TemplateLibrary)
{
<option value="@template.Id">@template.Name</option>
}
</InputSelect>
<button type="button" class="btn-solid theme-secondary" @onclick="RefreshTemplatesAsync"
disabled="@(_isApplyingTemplate || _isSavingTemplate)" title="Refresh templates" aria-label="Refresh templates">
<i class="bi bi-arrow-clockwise"></i>
</button>
<button type="button" class="btn-solid theme-secondary" @onclick="SaveAsTemplateAsync"
disabled="@(_isApplyingTemplate || _isSavingTemplate)" title="Save as Template" aria-label="Save as Template">
@if (_isSavingTemplate)
{
<span class="spinner-border spinner-sm" role="status"></span>
}
else
{
<i class="bi bi-bookmark-plus"></i>
}
</button>
</div>
<div class="form-text d-flex flex-wrap justify-content-between gap-3">
<span>@_templateStatusMessage</span>
<a href="/templates">Manage templates</a>
</div>
</div>

<div class="mb-5">
<label for="goalPrompt" class="form-label">Goal Prompt</label>
<InputTextArea id="goalPrompt" @bind-Value="FormModel.GoalPrompt" @oninput="e => HandleGoalPromptInput(e, context)" class="form-control textarea-autogrow" rows="3"
placeholder="Describe what you want the AI agent to accomplish..." maxlength="@ValidationLimits.JobGoalPromptMaxLength" />
<div class="form-text d-flex flex-wrap justify-content-between gap-3">
<span></span>
<span id="goalPromptLength" class="@(IsGoalPromptOverLength ? "fg-danger" : null)">@GetGoalPromptLengthSummary()</span>
</div>
<ValidationMessage For="@(() => FormModel.GoalPrompt)" class="fg-danger small" />
</div>

<ProfilePicker Id="jobProfile" Class="mb-5" Label="Run with" Profiles="JobProfiles" Allowed="ProfileRoles.CanBuild"
			   SelectedProfileId="FormModel.ProfileId" OnSelected="profile => FormModel.ProfileId = profile?.Id" />

<div class="accordion mb-5">
<AccordionSection Title="Branch and delivery" Icon="git"
Summary="Where the job works and where the changes land"
Badge="@DeliverySummary" @bind-IsOpen="_openDeliverySection">
@if (ShowBranchSelector && Branches.Any())
{
<div class="mb-5">
<label for="branch" class="form-label">Branch</label>
<InputSelect id="branch" @bind-Value="FormModel.Branch" class="form-control">
@foreach (var branch in Branches.Where(b => !b.IsRemote).OrderByDescending(b => b.Name == CurrentBranch))
{
<option value="@branch.Name">
@branch.Name @(branch.Name == CurrentBranch ? "(current)" : "")
</option>
}
</InputSelect>
<div class="form-text">The branch where the AI agent will operate.</div>
</div>
}

<div class="mb-5">
<label for="gitChangeDeliveryMode" class="form-label">Result Delivery</label>
<InputSelect id="gitChangeDeliveryMode" @bind-Value="FormModel.GitChangeDeliveryMode" class="form-control">
<option value="@GitChangeDeliveryMode.CommitToBranch">Commit to the selected branch</option>
<option value="@GitChangeDeliveryMode.PullRequest">Create a pull request</option>
</InputSelect>
<div class="form-text">Control where the job's final changes should land after successful execution.</div>
</div>

@if (FormModel.GitChangeDeliveryMode == GitChangeDeliveryMode.PullRequest)
{
<div class="mb-5">
<label for="targetBranch" class="form-label">Target Branch</label>
@if (Branches.Any(b => !b.IsRemote))
{
<InputSelect id="targetBranch" @bind-Value="FormModel.TargetBranch" class="form-control">
@foreach (var branch in Branches.Where(b => !b.IsRemote).OrderByDescending(b => b.Name == CurrentBranch))
{
<option value="@branch.Name">
@branch.Name @(branch.Name == CurrentBranch ? "(current)" : "")
</option>
}
</InputSelect>
}
else
{
<InputText id="targetBranch" @bind-Value="FormModel.TargetBranch" class="form-control" placeholder="develop" />
}
<ValidationMessage For="@(() => FormModel.TargetBranch)" class="fg-danger small" />
<div class="form-text">Completed work will be proposed from the source branch into this branch.</div>
</div>
}

</AccordionSection>

<AccordionSection Title="Instances" Icon="copy"
Summary="Run copies of this job side by side"
Badge="@InstancesSummary" @bind-IsOpen="_openInstancesSection">
<div class="mb-5">
<label for="instances" class="form-label">Instances</label>
<InputSelect id="instances" @bind-Value="FormModel.Instances" class="form-control">
@for (var count = 1; count <= ValidationLimits.JobInstancesMax; count++)
{
<option value="@count">@(count == 1 ? "1 (just this job)" : $"{count} side by side")</option>
}
</InputSelect>
<ValidationMessage For="@(() => FormModel.Instances)" class="fg-danger small" />
<div class="form-text">Write the goal as a list: its items are split between copies, each running in its own worktree on the same profile, and each copy's work lands on the branch as it finishes. @InstancesNote</div>
</div>
</AccordionSection>

<AccordionSection Title="Cycles" Icon="arrow-repeat"
Summary="Run the agent more than once"
Badge="@CycleSummary" @bind-IsOpen="ShowAdvancedOptions">
<div class="mb-5">
<label for="cycleMode" class="form-label">Cycle Mode</label>
<InputSelect id="cycleMode" @bind-Value="FormModel.CycleMode" class="form-control">
<option value="@CycleMode.SingleCycle">Single Cycle (default)</option>
<option value="@CycleMode.FixedCount">Fixed Count</option>
<option value="@CycleMode.Autonomous">Autonomous</option>
</InputSelect>
<div class="form-text">
@switch (FormModel.CycleMode)
{
case CycleMode.SingleCycle:
<span>Agent runs once and completes.</span>
break;
case CycleMode.FixedCount:
<span>Agent runs for a fixed number of cycles.</span>
break;
case CycleMode.Autonomous:
<span>Agent decides when the task is complete (max cycles as safety limit).</span>
break;
}
</div>
</div>

@if (FormModel.CycleMode != CycleMode.SingleCycle)
{
<div class="mb-5">
<label for="maxCycles" class="form-label">Max Cycles</label>
<InputNumber id="maxCycles" @bind-Value="FormModel.MaxCycles" class="form-control" min="1" max="100" />
<ValidationMessage For="@(() => FormModel.MaxCycles)" class="fg-danger small" />
<div class="form-text">Maximum number of execution cycles (1-100).</div>
</div>

<div class="mb-5">
<label for="cycleSessionMode" class="form-label">Session Mode</label>
<InputSelect id="cycleSessionMode" @bind-Value="FormModel.CycleSessionMode" class="form-control">
<option value="@CycleSessionMode.ContinueSession">Continue Session</option>
<option value="@CycleSessionMode.FreshSession">Fresh Session</option>
</InputSelect>
<div class="form-text">
@if (FormModel.CycleSessionMode == CycleSessionMode.ContinueSession)
{
<span>Maintain context between cycles (recommended for iterative work).</span>
}
else
{
<span>Start fresh context each cycle (useful for independent tasks).</span>
}
</div>
</div>

<div class="mb-5">
<label for="cycleReviewPrompt" class="form-label">Cycle Review Prompt (Optional)</label>
<InputTextArea id="cycleReviewPrompt" @bind-Value="FormModel.CycleReviewPrompt" class="form-control"
rows="4" placeholder="Instructions for reviewing progress between cycles..." />
<div class="form-text">Additional context provided at the start of each subsequent cycle.</div>
</div>
}
</AccordionSection>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
<Alert Type="Alert.AlertType.Danger" Message="@ErrorMessage" Class="mb-0" />
}
</EditForm>
</ChildContent>
<FooterContent>
<ModalFooterActions OnCancel="Close" Busy="@IsSaving"
					SubmitFormId="@_formId" SubmitIcon="plus-lg"
					SubmitText="Create Job" SubmitLoadingText="Creating..." />
</FooterContent>
</ModalDialog>

@code {
[Parameter]
public bool IsVisible { get; set; }

[Parameter]
public EventCallback<bool> IsVisibleChanged { get; set; }

[Parameter, EditorRequired]
public Job JobModel { get; set; } = new();

[Parameter]
public Project? Project { get; set; }

[Parameter]
public List<GitBranchInfo> Branches { get; set; } = new();

[Parameter]
public string? CurrentBranch { get; set; }

[Parameter]
public bool ShowBranchSelector { get; set; }

[Parameter]
public bool IsSaving { get; set; }

[Parameter]
public string? ErrorMessage { get; set; }

[Parameter]
public EventCallback OnSubmit { get; set; }

[Parameter]
public List<JobTemplate> TemplateLibrary { get; set; } = new();

[Parameter]
public EventCallback OnTemplateLibraryChanged { get; set; }

private readonly string _formId = $"create-job-form-{Guid.NewGuid():N}";
private bool ShowAdvancedOptions { get; set; }
private bool _openInstancesSection;
private List<Profile> _profiles = [];

// The project as the server has it now. The page's own copy may be a list row without its
// Build order, and that order decides which profile a new job starts on.
private Project? _buildProject;

/// <summary>Profiles a job can run on, the project's own Build order first.</summary>
private IReadOnlyList<Profile> JobProfiles => ProjectExecutionDefaults.OrderJobProfiles(_buildProject ?? Project, _profiles);

private string? InstancesSummary => FormModel.Instances > 1 ? $"×{FormModel.Instances}" : null;

/// <summary>How many copies the goal as written will actually run, when that's fewer than asked.</summary>
private string? InstancesNote
{
	get
	{
		if (FormModel.Instances < 2)
		{
			return null;
		}

		var items = JobInstanceSplitter.GetListItems(GetEffectiveGoalPrompt()).Count;
		return items >= FormModel.Instances
			? null
			: items < 2
				? "This goal has no list yet, so it runs once."
				: $"This goal lists {items} items, so {items} copies run.";
	}
}

private bool _openDeliverySection;
private bool _previousIsVisible;
private CreateJobFormModel FormModel { get; set; } = new();
private Guid? _selectedTemplateId;
private bool _isApplyingTemplate;
private bool _isSavingTemplate;
private string? _templateStatusMessage;

protected override async Task OnParametersSetAsync()
{
if (IsVisible && !_previousIsVisible)
{
await LoadProfilesAsync();
_buildProject = await ProjectExecutionDefaults.LoadWithBuildOrderAsync(Services, Project);
FormModel = CreateJobFormModel.FromJob(JobModel);
// A new job starts on the project's Build profile, which is also what the server gives a
// job that names none.
if (JobProfiles.All(profile => profile.Id != FormModel.ProfileId))
{
	FormModel.ProfileId = ProjectExecutionDefaults.GetBuildProfileId(_buildProject ?? Project, _profiles);
}
_openInstancesSection = FormModel.Instances > 1;
_selectedTemplateId = JobModel.JobTemplateId;
_templateStatusMessage = null;
	ShowAdvancedOptions = FormModel.CycleMode != CycleMode.SingleCycle;
	}

_previousIsVisible = IsVisible;
}

private void ToggleAdvancedOptions()
{
ShowAdvancedOptions = !ShowAdvancedOptions;
}

// Resolved lazily so pages and tests that never show profiles need no registration.
private async Task LoadProfilesAsync()
{
	var profileService = Services.GetService<IProfileService>();
	if (profileService == null)
	{
		_profiles = [];
		return;
	}

	try
	{
		_profiles = (await profileService.GetAllAsync()).ToList();
	}
	catch
	{
		_profiles = [];
	}
}

private async Task HandleSubmit()
{
	ApplyEffectiveFormValuesToJobModel();
	JobModel.JobTemplateId = _selectedTemplateId;
await OnSubmit.InvokeAsync();
}

private async Task HandleTemplateSelectionChanged()
{
	if (!_selectedTemplateId.HasValue)
	{
		JobModel.JobTemplateId = null;
		_templateStatusMessage = null;
		return;
	}

	var template = TemplateLibrary.FirstOrDefault(item => item.Id == _selectedTemplateId.Value)
		?? await JobTemplateService.GetByIdAsync(_selectedTemplateId.Value);
	if (template == null)
	{
		_templateStatusMessage = "The selected template could not be found.";
		return;
	}

	_isApplyingTemplate = true;
	try
	{
		ApplyTemplateToJob(template);
		FormModel = CreateJobFormModel.FromJob(JobModel);
		ShowAdvancedOptions = FormModel.CycleMode != CycleMode.SingleCycle;
		_templateStatusMessage = $"Applied template '{template.Name}'.";
	}
	finally
	{
		_isApplyingTemplate = false;
	}
}

private async Task RefreshTemplatesAsync()
{
	await OnTemplateLibraryChanged.InvokeAsync();
	_templateStatusMessage = "Template library refreshed.";
}

private async Task SaveAsTemplateAsync()
{
	try
	{
		_isSavingTemplate = true;
		ApplyEffectiveFormValuesToJobModel();

		var templateName = BuildTemplateName(JobModel.GoalPrompt);
		var template = new JobTemplate
		{
			Name = templateName,
			GoalPrompt = JobModel.GoalPrompt,
			// A job left on this project's own Build profile makes a template that leaves the
			// profile to each project; only a profile picked instead is kept.
			ProfileId = JobModel.ProfileId == ProjectExecutionDefaults.GetBuildProfileId(_buildProject ?? Project, _profiles) ? null : JobModel.ProfileId,
			// Branch and delivery belong to this project, so the template leaves them to whichever
			// project runs it.
			CycleMode = JobModel.CycleMode,
			CycleSessionMode = JobModel.CycleSessionMode,
			MaxCycles = JobModel.MaxCycles,
			CycleReviewPrompt = JobModel.CycleReviewPrompt
		};

		var created = await JobTemplateService.CreateAsync(template);
		_selectedTemplateId = created.Id;
		JobModel.JobTemplateId = created.Id;
		await RefreshTemplatesAsync();
		_templateStatusMessage = $"Saved template '{created.Name}'.";
		NotificationService.ShowSuccess($"Saved template '{created.Name}'.");
	}
	catch (ValidationException ex)
	{
		_templateStatusMessage = ex.Message;
		NotificationService.ShowError(ex.Message);
	}
	catch (HttpRequestException ex)
	{
		_templateStatusMessage = ex.Message;
		NotificationService.ShowError(ex.Message);
	}
	finally
	{
		_isSavingTemplate = false;
	}
}

private void ApplyEffectiveFormValuesToJobModel()
{
	FormModel.ApplyTo(JobModel);
	JobModel.GoalPrompt = GetEffectiveGoalPrompt();
}

private async Task Close()
{
await IsVisibleChanged.InvokeAsync(false);
}

private void ApplyTemplateToJob(JobTemplate template)
{
	// Start from what the form shows (the project's defaults plus any edits) and change only what
	// the template sets, so a template that leaves the profile or branch to the project doesn't
	// blank them.
	FormModel.ApplyTo(JobModel);
	JobModel.JobTemplateId = template.Id;
	JobModel.GoalPrompt = template.GoalPrompt;
	if (template.ProfileId is Guid profileId && JobProfiles.Any(profile => profile.Id == profileId))
	{
		JobModel.ProfileId = profileId;
	}
	if (!string.IsNullOrWhiteSpace(template.Branch))
	{
		JobModel.Branch = template.Branch;
	}
	if (template.GitChangeDeliveryMode is { } deliveryMode)
	{
		JobModel.GitChangeDeliveryMode = deliveryMode;
	}
	if (!string.IsNullOrWhiteSpace(template.TargetBranch))
	{
		JobModel.TargetBranch = template.TargetBranch;
	}
	JobModel.CycleMode = template.CycleMode;
	JobModel.CycleSessionMode = template.CycleSessionMode;
	JobModel.MaxCycles = template.MaxCycles;
	JobModel.CycleReviewPrompt = template.CycleReviewPrompt;
}

private bool IsGoalPromptOverLength => (FormModel.GoalPrompt?.Length ?? 0) > ValidationLimits.JobGoalPromptMaxLength;

// InputTextArea commits on change; keep the model current while typing so the count follows,
// and revalidate here because the change event then sees no new value.
private void HandleGoalPromptInput(ChangeEventArgs e, EditContext editContext)
{
	FormModel.GoalPrompt = e.Value?.ToString() ?? string.Empty;
	editContext.NotifyFieldChanged(FieldIdentifier.Create(() => FormModel.GoalPrompt));
}

private string GetGoalPromptLengthSummary()
{
	return $"{FormModel.GoalPrompt?.Length ?? 0:N0}/{ValidationLimits.JobGoalPromptMaxLength:N0} characters";
}

private string GetEffectiveGoalPrompt() => FormModel.GoalPrompt?.Trim() ?? string.Empty;

private static string BuildTemplateName(string prompt)
{
	var trimmed = prompt.Trim();
	if (string.IsNullOrEmpty(trimmed))
	{
		throw new ValidationException("Enter a goal prompt before saving a template.");
	}

	const int maxLength = 100;
	var firstLine = trimmed.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? trimmed;
	return firstLine.Length <= maxLength ? firstLine : firstLine[..maxLength].TrimEnd();
}

	private string DeliverySummary => FormModel.GitChangeDeliveryMode == GitChangeDeliveryMode.PullRequest
		? $"PR → {(string.IsNullOrWhiteSpace(FormModel.TargetBranch) ? "?" : FormModel.TargetBranch)}"
		: string.IsNullOrWhiteSpace(FormModel.Branch) ? "Commit" : $"Commit → {FormModel.Branch}";

	private string? CycleSummary => FormModel.CycleMode switch
	{
		CycleMode.FixedCount => $"{FormModel.MaxCycles} cycles",
		CycleMode.Autonomous => $"Autonomous ≤ {FormModel.MaxCycles}",
		_ => null
	};


	/// <summary>
	/// Open whichever collapsed section holds the field that failed validation, so the
	/// message in the summary has something visible to point at.
	/// </summary>
	private void HandleInvalidSubmit()
	{
		if (FormModel.GitChangeDeliveryMode == GitChangeDeliveryMode.PullRequest &&
			string.IsNullOrWhiteSpace(FormModel.TargetBranch))
		{
			_openDeliverySection = true;
		}

		if (FormModel.CycleMode != CycleMode.SingleCycle && (FormModel.MaxCycles < 1 || FormModel.MaxCycles > 100))
		{
			ShowAdvancedOptions = true;
		}
	}

}
