@* Retries a failed job, on the profile it ran on or on another one. *@
@inject IProfileService ProfileService
@inject IServiceProvider Services

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="HandleModalVisibilityChanged" Title="Retry Job" Icon="arrow-repeat"
	Size="ModalDialog.ModalSize.Default">
	<ChildContent>
		<div>
			@if (IsLoading)
			{
				<div class="text-center py-7">
					<div class="spinner-border fs-2xl fg-primary" role="status">
						<span class="visually-hidden">Loading...</span>
					</div>
					<p class="fg-1 mt-3 mb-0">Loading profiles...</p>
				</div>
			}
			else
			{
				@if (Job != null && Job.RetryCount > 0)
				{
					<Alert Type="Alert.AlertType.Info" Class="d-flex align-items-center mb-5 py-3">
						<span>This job has been attempted <strong>@(Job.RetryCount + 1)</strong> time(s)</span>
					</Alert>
				}

				<ProfilePicker Id="retryProfile" Class="mb-5" Label="Run with" Profiles="JobProfiles" Allowed="ProfileRoles.CanBuild"
							   SelectedProfileId="SelectedProfileId" OnSelected="profile => SelectedProfileId = profile?.Id" />

				@if (!string.IsNullOrEmpty(ErrorMessage))
				{
					<Alert Type="Alert.AlertType.Danger" Class="py-3 mb-0">@ErrorMessage</Alert>
				}
			}
		</div>
	</ChildContent>
	<FooterContent>
		<button type="button" class="btn-solid theme-secondary" @onclick="Close" disabled="@IsSubmitting">
			Cancel
		</button>
		<button type="button" class="btn-solid theme-primary" @onclick="Submit" disabled="@(IsLoading || IsSubmitting)">
			@if (IsSubmitting)
			{
				<span class="spinner-border spinner-sm me-1" role="status"></span>
				<span>Retrying...</span>
			}
			else
			{
				<i class="bi bi-arrow-repeat"></i>
				<span>Retry Job</span>
			}
		</button>
	</FooterContent>
</ModalDialog>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public EventCallback<bool> IsVisibleChanged { get; set; }

	[Parameter]
	public Job? Job { get; set; }

	[Parameter]
	public EventCallback<RetryOptions> OnRetry { get; set; }

	private List<Profile> Profiles { get; set; } = new();
	private Guid? SelectedProfileId { get; set; }
	private bool IsLoading { get; set; } = true;
	private bool IsSubmitting { get; set; }
	private string? ErrorMessage { get; set; }

	// The job's project as the server has it now: a job is read without its project's Build
	// order, and that order decides where a job with no profile of its own starts.
	private Project? _buildProject;

	private IReadOnlyList<Profile> JobProfiles => ProjectExecutionDefaults.OrderJobProfiles(_buildProject ?? Job?.Project, Profiles);

	protected override async Task OnParametersSetAsync()
	{
		if (IsVisible && IsLoading)
		{
			await LoadProfiles();
		}
	}

	private async Task LoadProfiles()
	{
		IsLoading = true;
		ErrorMessage = null;
		StateHasChanged();

		try
		{
			Profiles = (await ProfileService.GetAllAsync()).ToList();
			_buildProject = await ProjectExecutionDefaults.LoadWithBuildOrderAsync(Services, Job?.Project ?? (Job == null ? null : new Project { Id = Job.ProjectId }));
			SelectedProfileId = PickStartingProfileId();
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Failed to load profiles: {ex.Message}";
		}
		finally
		{
			IsLoading = false;
		}
	}

	/// <summary>
	/// The profile the job ran on. A job from before jobs kept one starts on the profile holding
	/// its provider, model and reasoning, else on its project's Build profile.
	/// </summary>
	private Guid? PickStartingProfileId()
	{
		var runnable = JobProfiles;
		if (Job == null)
		{
			return null;
		}

		return (runnable.FirstOrDefault(profile => profile.Id == Job.ProfileId)
			?? runnable.FirstOrDefault(profile => profile.ProviderId == Job.ProviderId
				&& string.Equals(profile.ModelId, Job.ModelUsed, StringComparison.Ordinal)
				&& string.Equals(profile.ReasoningEffort, Job.ReasoningEffort, StringComparison.Ordinal)))?.Id
			?? ProjectExecutionDefaults.GetBuildProfileId(_buildProject ?? Job.Project, Profiles);
	}

	private async Task Submit()
	{
		if (Job == null) return;

		IsSubmitting = true;
		ErrorMessage = null;
		StateHasChanged();

		try
		{
			await OnRetry.InvokeAsync(new RetryOptions { ProfileId = SelectedProfileId });
			await Close();
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Failed to retry job: {ex.Message}";
		}
		finally
		{
			IsSubmitting = false;
		}
	}

	private async Task Close()
	{
		await IsVisibleChanged.InvokeAsync(false);
		ResetForNextOpen();
	}

	private async Task HandleModalVisibilityChanged(bool visible)
	{
		if (!visible)
		{
			// Closed by the backdrop or the close button.
			await IsVisibleChanged.InvokeAsync(false);
			ResetForNextOpen();
		}
	}

	private void ResetForNextOpen()
	{
		IsLoading = true;
		SelectedProfileId = null;
		ErrorMessage = null;
	}

	public class RetryOptions
	{
		/// <summary>The profile to retry on. Null runs the job on its own profile again.</summary>
		public Guid? ProfileId { get; set; }
	}
}
