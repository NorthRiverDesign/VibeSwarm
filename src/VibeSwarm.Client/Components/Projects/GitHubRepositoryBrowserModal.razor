@inject IProjectService ProjectService

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="HandleVisibilityChanged"
			 Title="Browse GitHub Repositories" Icon="github"
			 Size="ModalDialog.ModalSize.Large" OnClose="HandleClose">
	<ChildContent>
		<div class="d-flex flex-column gap-3">
			<div class="small text-body-secondary">
				Browse repositories available to the authenticated GitHub CLI account on this host. You can still paste any <code>owner/repo</code> manually.
			</div>

			@* Filters stay above the list's own scroll area so they remain reachable
			   however far down a long repository list you are. *@
			<div class="d-flex flex-column flex-sm-row gap-2">
				@if (OwnerCounts.Count > 1)
				{
					<select id="githubRepositoryBrowserOwner" class="form-select flex-shrink-0" @bind="_selectedOwner"
							aria-label="Filter by organization">
						<option value="">All organizations (@_repositories.Count)</option>
						@foreach (var owner in OwnerCounts)
						{
							<option value="@owner.Name">
								@(owner.Name == _authenticatedUser ? $"{owner.Name} (me)" : owner.Name) — @owner.Count
							</option>
						}
					</select>
				}
				<div class="input-group flex-grow-1">
					<span class="input-group-text"><i class="bi bi-search"></i></span>
					<input id="githubRepositoryBrowserSearch" @bind="_searchText" @bind:event="oninput"
						   class="form-control" placeholder="Search repositories" type="search"
						   autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="search" />
					@if (!string.IsNullOrEmpty(_searchText))
					{
						<button type="button" class="btn btn-secondary" @onclick="ClearSearch" aria-label="Clear search">
							<i class="bi bi-x-lg"></i>
						</button>
					}
				</div>
			</div>

			@if (_isLoading)
			{
				<div class="py-4">
					<LoadingSpinner Text="Loading GitHub repositories..." />
				</div>
			}
			else if (!string.IsNullOrWhiteSpace(_errorMessage))
			{
				<Alert Type="Alert.AlertType.Warning" Class="mb-0">
					<span class="text-break">@_errorMessage</span>
				</Alert>
			}
			else if (FilteredRepositories.Count == 0)
			{
				<Alert Type="Alert.AlertType.Info" Class="mb-0">
					<div class="d-flex flex-column align-items-start gap-2">
						<span>No repositories matched the current filter.</span>
						@if (HasActiveFilter)
						{
							<button type="button" class="btn btn-sm btn-secondary" @onclick="ClearFilters">
								<i class="bi bi-x-circle me-1"></i>Clear filters
							</button>
						}
					</div>
				</Alert>
			}
			else
			{
				<div class="small text-body-secondary">
					Showing @FilteredRepositories.Count of @_repositories.Count repositories from GitHub.
				</div>

				@* flex-shrink-0 matters: .list-group is a flex column, and once it hits its
				   max height the rows would otherwise shrink below their content and overlap. *@
				<div class="list-group overflow-auto overscroll-contain max-height-50dvh">
					@foreach (var repository in FilteredRepositories)
					{
						var isSelected = string.Equals(_selectedRepository, repository.NameWithOwner, StringComparison.OrdinalIgnoreCase);

						<button type="button"
								class="list-group-item list-group-item-action flex-shrink-0 text-start d-flex align-items-center gap-2 @(isSelected ? "active" : string.Empty)"
								@onclick="() => SelectRepository(repository)">
							<span class="d-flex flex-column min-width-0 flex-grow-1">
								<span class="text-truncate"><span class="@(isSelected ? "text-white-50" : "text-body-secondary")">@OwnerOf(repository)/</span><span class="fw-semibold">@NameOf(repository)</span></span>
								<span class="small text-truncate @(isSelected ? "text-white-50" : "text-body-secondary")">
									@if (repository.IsPrivate)
									{
										<i class="bi bi-lock-fill me-1"></i><span class="me-2">Private</span>
									}
									@if (repository.UpdatedAt.HasValue)
									{
										<span>Updated @repository.UpdatedAt.Value.UtcDateTime.FormatDate()</span>
									}
									@if (!string.IsNullOrWhiteSpace(repository.Description))
									{
										<span class="d-none d-sm-inline"> · @repository.Description</span>
									}
								</span>
							</span>
							@if (isSelected)
							{
								<i class="bi bi-check-lg fs-5 flex-shrink-0"></i>
							}
						</button>
					}
				</div>
			}
		</div>
	</ChildContent>
	<FooterContent>
		<button type="button" class="btn btn-secondary" @onclick="HandleClose">Cancel</button>
		<button type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_selectedRepository)" @onclick="UseSelectedRepository">
			Use Repository
		</button>
	</FooterContent>
</ModalDialog>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public EventCallback<bool> IsVisibleChanged { get; set; }

	[Parameter]
	public string? SelectedRepository { get; set; }

	[Parameter]
	public EventCallback<string> OnRepositorySelected { get; set; }

	private bool _isLoading;
	private bool _wasVisible;
	private string? _errorMessage;
	private string _searchText = string.Empty;
	private string _selectedOwner = string.Empty;
	private string? _authenticatedUser;
	private string? _selectedRepository;
	private List<GitHubRepositoryBrowserItem> _repositories = [];

	private List<GitHubRepositoryBrowserItem> FilteredRepositories =>
		_repositories
			.Where(repository =>
				string.IsNullOrWhiteSpace(_selectedOwner) ||
				string.Equals(OwnerOf(repository), _selectedOwner, StringComparison.OrdinalIgnoreCase))
			.Where(repository =>
				string.IsNullOrWhiteSpace(_searchText) ||
				(repository.NameWithOwner?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
				(repository.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
			.ToList();

	/// <summary>Owners that actually have repositories, own account first, with their counts.</summary>
	private List<OwnerFilter> OwnerCounts =>
		_repositories
			.GroupBy(repository => OwnerOf(repository), StringComparer.OrdinalIgnoreCase)
			.Where(group => !string.IsNullOrWhiteSpace(group.Key))
			.Select(group => new OwnerFilter(group.Key, group.Count()))
			.OrderByDescending(owner => string.Equals(owner.Name, _authenticatedUser, StringComparison.OrdinalIgnoreCase))
			.ThenBy(owner => owner.Name, StringComparer.OrdinalIgnoreCase)
			.ToList();

	private bool HasActiveFilter =>
		!string.IsNullOrWhiteSpace(_selectedOwner) || !string.IsNullOrWhiteSpace(_searchText);

	private static string OwnerOf(GitHubRepositoryBrowserItem repository)
	{
		var nameWithOwner = repository.NameWithOwner ?? string.Empty;
		var separator = nameWithOwner.IndexOf('/');
		return separator > 0 ? nameWithOwner[..separator] : string.Empty;
	}

	private static string NameOf(GitHubRepositoryBrowserItem repository)
	{
		var nameWithOwner = repository.NameWithOwner ?? string.Empty;
		var separator = nameWithOwner.IndexOf('/');
		return separator >= 0 ? nameWithOwner[(separator + 1)..] : nameWithOwner;
	}

	private sealed record OwnerFilter(string Name, int Count);

	protected override async Task OnParametersSetAsync()
	{
		if (IsVisible && !_wasVisible)
		{
			_wasVisible = true;
			_searchText = string.Empty;
			_selectedOwner = string.Empty;
			_selectedRepository = SelectedRepository;
			await LoadRepositoriesAsync();
		}
		else if (IsVisible)
		{
			_selectedRepository = SelectedRepository;
		}

		_wasVisible = IsVisible;
	}

	private async Task LoadRepositoriesAsync()
	{
		_isLoading = true;
		_errorMessage = null;
		_repositories = [];

		try
		{
			var result = await ProjectService.BrowseGitHubRepositoriesAsync();
			_errorMessage = result.ErrorMessage;
			_authenticatedUser = result.AuthenticatedUser;
			_repositories = result.Repositories ?? [];
		}
		catch (Exception ex)
		{
			_errorMessage = $"Unable to load GitHub repositories: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private Task HandleVisibilityChanged(bool visible)
	{
		IsVisible = visible;
		return IsVisibleChanged.InvokeAsync(visible);
	}

	private async Task HandleClose()
	{
		_selectedRepository = SelectedRepository;
		await HandleVisibilityChanged(false);
	}

	private void ClearSearch()
	{
		_searchText = string.Empty;
	}

	private void ClearFilters()
	{
		_searchText = string.Empty;
		_selectedOwner = string.Empty;
	}

	private void SelectRepository(GitHubRepositoryBrowserItem repository)
	{
		_selectedRepository = repository.NameWithOwner;
	}

	private async Task UseSelectedRepository()
	{
		if (string.IsNullOrWhiteSpace(_selectedRepository))
		{
			return;
		}

		await OnRepositorySelected.InvokeAsync(_selectedRepository);
		await HandleVisibilityChanged(false);
	}
}
