@* A project's environments as a grouped list. Each row opens in place to edit it; new ones open
   straight away. *@

<section class="d-flex flex-column gap-3" aria-label="Environments">
	<div class="d-flex align-items-center gap-5 px-1">
		<h2 class="text-eyebrow mb-0 me-auto">Environments</h2>
		<button type="button" class="btn-sm btn-link text-decoration-none px-0" @onclick="AddEnvironment">
			<i class="bi bi-plus-lg"></i>Add
		</button>
	</div>

	@if (!_environments.Any())
	{
		<EmptyState Icon="box-seam" Title="No environments yet"
					Message="Add a deployed URL or release page so jobs can check their work against the real thing." />
	}
	else
	{
		<div class="list-group rounded-9">
			@foreach (var environment in _environments.Select((value, index) => new { value, index }))
			{
				var item = environment.value;
				var isExpanded = _expandedIds.Contains(item.Id);
				<button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-5"
						@onclick="() => ToggleExpanded(item.Id)" aria-expanded="@(isExpanded ? "true" : "false")">
					<i class="bi @GetKindIcon(item.Type) flex-shrink-0 @(item.IsEnabled ? "fg-primary" : "fg-2")"></i>
					<span class="flex-grow-1 min-w-0 text-start">
						<span class="d-flex align-items-center gap-3 min-w-0">
							<span class="fw-medium text-truncate">@(string.IsNullOrWhiteSpace(item.Name) ? "Untitled environment" : item.Name)</span>
							@if (item.IsPrimary)
							{
								<i class="bi bi-star-fill fg-warning small flex-shrink-0" title="Primary environment"></i>
							}
						</span>
						<span class="d-block small fg-1 text-truncate">@GetEnvironmentSummary(item)</span>
					</span>
					<i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") fg-2 flex-shrink-0"></i>
				</button>
				@if (isExpanded)
				{
					<div class="list-group-item d-flex flex-column gap-5 py-5">
						<div class="row g-5">
							<div class="col-12 md:col-6">
								<label class="form-label small fg-1 mb-1" for="@($"env-name-{item.Id}")">Name</label>
								<InputText id="@($"env-name-{item.Id}")" @bind-Value="item.Name" class="form-control" placeholder="Staging" />
							</div>
							<div class="col-12 md:col-6">
								<label class="form-label small fg-1 mb-1" for="@($"env-url-{item.Id}")">URL</label>
								<InputText id="@($"env-url-{item.Id}")" @bind-Value="item.Url" class="form-control font-monospace" placeholder="https://staging.example.com" />
							</div>
							<div class="col-6">
								<label class="form-label small fg-1 mb-1" for="@($"env-kind-{item.Id}")">Kind</label>
								<InputSelect id="@($"env-kind-{item.Id}")" @bind-Value="item.Type" @bind-Value:after="() => OnEnvironmentTypeChanged(item)" class="form-control">
									<option value="@EnvironmentType.Web">Web</option>
									<option value="@EnvironmentType.Release">GitHub Releases</option>
									<option value="@EnvironmentType.Other">Generic</option>
								</InputSelect>
							</div>
							<div class="col-6">
								<label class="form-label small fg-1 mb-1" for="@($"env-stage-{item.Id}")">Stage</label>
								<InputSelect id="@($"env-stage-{item.Id}")" @bind-Value="item.Stage" class="form-control">
									<option value="@EnvironmentStage.Production">Production</option>
									<option value="@EnvironmentStage.Development">Development</option>
									<option value="@EnvironmentStage.Local">Local</option>
								</InputSelect>
							</div>
							<div class="col-12">
								<label class="form-label small fg-1 mb-1" for="@($"env-description-{item.Id}")">Notes for agents <span class="fg-2">(optional)</span></label>
								<InputTextArea id="@($"env-description-{item.Id}")" @bind-Value="item.Description" class="form-control" rows="2" />
							</div>
						</div>

						<div class="d-flex flex-wrap gap-7">
							<div class="form-field mb-0">
								<div class="switch">
									<InputCheckbox role="switch" switch id="@($"env-enabled-{item.Id}")" @bind-Value="item.IsEnabled" />
								</div>
								<label for="@($"env-enabled-{item.Id}")">Enabled</label>
							</div>
							<div class="form-field mb-0">
								<div class="switch">
									<InputCheckbox role="switch" switch id="@($"env-primary-{item.Id}")" Value="@item.IsPrimary"
										ValueChanged="@(value => TogglePrimaryEnvironment(item.Id, value))"
										ValueExpression="@(() => item.IsPrimary)" />
								</div>
								<label for="@($"env-primary-{item.Id}")">Primary</label>
							</div>
						</div>

						@if (item.Type == EnvironmentType.Web)
						{
							<div class="d-flex flex-column gap-3">
								<div class="text-eyebrow">Web login <span class="fg-2">· optional</span></div>
								<div class="row g-5">
									<div class="col-12 md:col-6">
										<label class="form-label small fg-1 mb-1" for="@($"env-username-{item.Id}")">Username</label>
										<InputText id="@($"env-username-{item.Id}")" @bind-Value="item.Username" class="form-control" placeholder="tester@example.com" />
									</div>
									<div class="col-12 md:col-6">
										<label class="form-label small fg-1 mb-1" for="@($"env-password-{item.Id}")">Password</label>
										<InputText id="@($"env-password-{item.Id}")" @bind-Value="item.Password" class="form-control" type="password"
											placeholder="@(item.HasPassword ? "Leave blank to keep the saved password" : "Optional password")" />
										@if (item.HasPassword)
										{
											<div class="form-field mt-3">
												<InputCheckbox id="@($"env-clear-password-{item.Id}")" @bind-Value="item.ClearPassword" class="check" />
												<label class="small" for="@($"env-clear-password-{item.Id}")">Clear saved password</label>
											</div>
										}
									</div>
								</div>
							</div>
						}

						<div class="d-flex align-items-center gap-3">
							<button type="button" class="btn-sm btn-solid theme-secondary" title="Move up" aria-label="Move up"
									@onclick="() => MoveEnvironmentUp(item.Id)" disabled="@(environment.index == 0)">
								<i class="bi bi-arrow-up"></i>
							</button>
							<button type="button" class="btn-sm btn-solid theme-secondary" title="Move down" aria-label="Move down"
									@onclick="() => MoveEnvironmentDown(item.Id)" disabled="@(environment.index >= _environments.Count - 1)">
								<i class="bi bi-arrow-down"></i>
							</button>
							<button type="button" class="btn-sm btn-link fg-danger text-decoration-none ms-auto px-0"
									@onclick="() => RemoveEnvironment(item.Id)">
								<i class="bi bi-trash"></i>Remove
							</button>
						</div>
					</div>
				}
			}
		</div>
	}
</section>

@code {
	[Parameter, EditorRequired]
	public Project Project { get; set; } = new();

	private ICollection<ProjectEnvironment> Environments => Project.Environments ??= [];

	private List<ProjectEnvironment> _environments => Environments.OrderBy(environment => environment.SortOrder).ToList();

	protected override void OnParametersSet()
	{
		Project.Environments ??= [];
	}

	private readonly HashSet<Guid> _expandedIds = new();

	private void ToggleExpanded(Guid environmentId)
	{
		if (!_expandedIds.Remove(environmentId))
		{
			_expandedIds.Add(environmentId);
		}
	}

	private static string GetEnvironmentSummary(ProjectEnvironment environment)
	{
		var parts = new List<string>();
		if (!environment.IsEnabled)
		{
			parts.Add("Off");
		}
		parts.Add(environment.Stage.ToString());
		parts.Add(string.IsNullOrWhiteSpace(environment.Url) ? "No URL yet" : environment.Url);
		return string.Join(" · ", parts);
	}

	private void AddEnvironment()
	{
		var environmentId = Guid.NewGuid();
		_expandedIds.Add(environmentId);
		Environments.Add(new ProjectEnvironment
		{
			Id = environmentId,
			Name = $"Environment {Environments.Count + 1}",
			Type = EnvironmentType.Web,
			Stage = EnvironmentStage.Production,
			IsEnabled = true,
			IsPrimary = Environments.Count == 0,
			SortOrder = Environments.Count
		});
		NormalizeOrder();
	}

	private void RemoveEnvironment(Guid environmentId)
	{
		var environment = Environments.FirstOrDefault(item => item.Id == environmentId);
		if (environment is null) return;
		Environments.Remove(environment);
		NormalizeOrder();
	}

	private void MoveEnvironmentUp(Guid environmentId)
	{
		var ordered = _environments;
		var index = ordered.FindIndex(environment => environment.Id == environmentId);
		if (index <= 0) return;
		(ordered[index - 1], ordered[index]) = (ordered[index], ordered[index - 1]);
		Project.Environments = ordered;
		NormalizeOrder();
	}

	private void MoveEnvironmentDown(Guid environmentId)
	{
		var ordered = _environments;
		var index = ordered.FindIndex(environment => environment.Id == environmentId);
		if (index < 0 || index >= ordered.Count - 1) return;
		(ordered[index + 1], ordered[index]) = (ordered[index], ordered[index + 1]);
		Project.Environments = ordered;
		NormalizeOrder();
	}

	private void TogglePrimaryEnvironment(Guid environmentId, bool isPrimary)
	{
		foreach (var environment in Environments)
		{
			environment.IsPrimary = isPrimary && environment.Id == environmentId;
		}
		if (!Environments.Any(environment => environment.IsPrimary) && Environments.Count > 0)
		{
			Environments.First().IsPrimary = true;
		}
	}

	private void OnEnvironmentTypeChanged(ProjectEnvironment environment)
	{
		if (environment.Type == EnvironmentType.Web) return;
		environment.Username = null;
		environment.Password = null;
		environment.ClearPassword = true;
	}

	private void NormalizeOrder()
	{
		Project.Environments = Environments
			.OrderBy(environment => environment.SortOrder)
			.Select((environment, index) =>
			{
				environment.SortOrder = index;
				if (environment.CreatedAt == default)
				{
					environment.CreatedAt = DateTime.UtcNow;
				}
				environment.UpdatedAt = DateTime.UtcNow;
				return environment;
			})
			.ToList();

		var primary = Environments.FirstOrDefault(e => e.IsPrimary && e.IsEnabled)
			?? Environments.FirstOrDefault(e => e.IsEnabled)
			?? Environments.FirstOrDefault();
		foreach (var environment in Environments)
		{
			environment.IsPrimary = primary is not null && environment.Id == primary.Id;
		}
	}

	private static string GetKindIcon(EnvironmentType type) => type switch
	{
		EnvironmentType.Web => "bi-globe",
		EnvironmentType.Release => "bi-box-seam",
		_ => "bi-hdd-network"
	};
}
