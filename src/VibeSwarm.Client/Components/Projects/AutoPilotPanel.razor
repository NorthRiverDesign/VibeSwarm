@* Auto-Pilot panel for autonomous project iteration *@
@inject IAutoPilotService AutoPilotService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<div class="d-flex flex-column gap-7">
	@if (_isLoading)
	{
		<div class="d-flex align-items-center gap-3 fg-1">
			<span class="spinner-border spinner-sm" role="status" aria-hidden="true"></span>
			<span>Loading auto-pilot status...</span>
		</div>
	}
	else if (_loop == null || IsTerminal(_loop.Status))
	{
		@* IDLE / STOPPED STATE — the settings, grouped like the rest of the project page *@
		<div class="d-flex flex-column gap-3 px-1">
			<p class="small fg-1 mb-0">
				Auto-Pilot reads the code, picks an improvement, builds it, and repeats until it reaches one of the limits below.
			</p>
			@if (_loop != null && (_loop.CompletedIterations > 0 || !string.IsNullOrEmpty(_loop.LastStopReason)))
			{
				<p class="small mb-0 @GetLastRunTextClass(_loop.Status)">
					<i class="bi @GetStatusIcon(_loop.Status) me-1"></i>Last run @_loop.Status.ToString().ToLowerInvariant()
					@if (!string.IsNullOrEmpty(_loop.LastStopReason))
					{
						<span class="fg-1">: @_loop.LastStopReason</span>
					}
					<span class="fg-1">
						· @_loop.CompletedIterations iteration@(_loop.CompletedIterations == 1 ? "" : "s") · $@_loop.TotalCostUsd.ToString("F2")
					</span>
				</p>
			}
		</div>

		@if (!string.IsNullOrEmpty(_error))
		{
			<Alert Type="Alert.AlertType.Danger" Class="mb-0">@_error</Alert>
		}

		<section class="d-flex flex-column gap-3" aria-label="Ideas">
			<h2 class="text-eyebrow mb-0 px-1">Ideas</h2>
			<div class="list-group rounded-9">
				<div class="list-group-item d-flex flex-column gap-5 py-5">
					<div>
						<label for="ap-inference-provider" class="form-label small fg-1 mb-1">Come up with ideas using</label>
						<select id="ap-inference-provider" class="form-control" @bind="_config.InferenceProviderId">
							<option value="">The coding provider</option>
							@foreach (var provider in AvailableInferenceProviders)
							{
								<option value="@provider.Id">@provider.Name (@provider.ProviderType)</option>
							}
						</select>
					</div>
					<div>
						<label for="ap-inference-model" class="form-label small fg-1 mb-1">Model</label>
						<div class="input-group">
							<select id="ap-inference-model" class="form-control" @bind="_config.InferenceModelId">
								<option value="">Provider default</option>
								@foreach (var model in GetInferenceModelsForSelectedProvider())
								{
									<option value="@model.ModelId">@(model.DisplayName ?? model.ModelId)</option>
								}
							</select>
							<ModelRefreshButton ProviderId="@_config.InferenceProviderId" IsInference="true"
												OnInferenceRefreshed="HandleInferenceModelsRefreshed" />
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="d-flex flex-column gap-3" aria-label="Coding">
			<h2 class="text-eyebrow mb-0 px-1">Coding</h2>
			<div class="list-group rounded-9">
				<div class="list-group-item d-flex flex-column gap-5 py-5">
					<div>
						<label for="ap-coding-provider" class="form-label small fg-1 mb-1">Build each idea with</label>
						<select id="ap-coding-provider" class="form-control" @bind="_config.ProviderId">
							<option value="">Project default</option>
							@foreach (var provider in AvailableProviders)
							{
								<option value="@provider.Id">@provider.Name</option>
							}
						</select>
					</div>
					<div>
						<label for="ap-coding-model" class="form-label small fg-1 mb-1">Model</label>
						<div class="input-group">
							<select id="ap-coding-model" class="form-control" @bind="_config.ModelId">
								<option value="">Provider default</option>
								@foreach (var model in GetCodingModelsForSelectedProvider())
								{
									<option value="@model.ModelId">@(model.DisplayName ?? model.ModelId)</option>
								}
							</select>
							<ModelRefreshButton ProviderId="@_config.ProviderId" OnRefreshed="HandleCodingModelsRefreshed" />
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="d-flex flex-column gap-3" aria-label="Limits">
			<h2 class="text-eyebrow mb-0 px-1">Limits</h2>
			<div class="list-group rounded-9">
				<div class="list-group-item py-5">
					<div class="row g-5">
						<div class="col-6">
							<label for="ap-max-iterations" class="form-label small fg-1 mb-1">Iterations</label>
							<input id="ap-max-iterations" type="number" class="form-control" @bind="_config.MaxIterations" min="0" max="1000" />
							<div class="form-text">0 = no limit</div>
						</div>
						<div class="col-6">
							<label for="ap-max-cost" class="form-label small fg-1 mb-1">Spend up to ($)</label>
							<input id="ap-max-cost" type="number" class="form-control" @bind="_config.MaxTotalCostUsd" min="0" step="1" placeholder="No limit" />
						</div>
						<div class="col-6">
							<label for="ap-max-failures" class="form-label small fg-1 mb-1">Failures in a row</label>
							<input id="ap-max-failures" type="number" class="form-control" @bind="_config.MaxConsecutiveFailures" min="1" max="20" />
						</div>
						<div class="col-6">
							<label for="ap-cooldown" class="form-label small fg-1 mb-1">Pause between (sec)</label>
							<input id="ap-cooldown" type="number" class="form-control" @bind="_config.CooldownSeconds" min="10" max="3600" />
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="d-flex flex-column gap-3" aria-label="After each change">
			<h2 class="text-eyebrow mb-0 px-1">After each change</h2>
			<div class="list-group rounded-9">
				<label class="list-group-item d-flex align-items-center justify-content-between gap-5 py-5 cursor-pointer" for="ap-autocommit">
					<span>Commit it</span>
					<span class="switch">
						<input type="checkbox" role="switch" switch id="ap-autocommit" @bind="_config.AutoCommit" />
					</span>
				</label>
				<label class="list-group-item d-flex align-items-center justify-content-between gap-5 py-5 cursor-pointer" for="ap-autopush">
					<span>Push the commit</span>
					<span class="switch">
						<input type="checkbox" role="switch" switch id="ap-autopush" @bind="_config.AutoPush" />
					</span>
				</label>
			</div>
		</section>

		<div class="d-grid sm:d-flex sm:justify-content-end">
			<button type="button" class="btn-solid theme-primary" @onclick="StartAutoPilot" disabled="@_isStarting">
				@if (_isStarting)
				{
					<span class="spinner-border spinner-sm me-1" role="status" aria-hidden="true"></span>
				}
				else
				{
					<i class="bi bi-play-fill me-1"></i>
				}
				Start Auto-Pilot
			</button>
		</div>
	}
	else
	{
		@* RUNNING / PAUSED / STOPPING STATE — one status card *@
		<section class="d-flex flex-column gap-3" aria-label="Auto-Pilot status">
			<h2 class="text-eyebrow mb-0 px-1">Auto-Pilot</h2>
			<div class="list-group rounded-9">
				<div class="list-group-item d-flex align-items-center gap-5 py-5">
					@if (_loop.Status == IterationLoopStatus.Paused)
					{
						<i class="bi bi-pause-circle-fill fg-warning fs-lg flex-shrink-0"></i>
					}
					else
					{
						<span class="spinner-border spinner-sm @(_loop.Status == IterationLoopStatus.Stopping ? "fg-warning" : "fg-primary") flex-shrink-0"
							  role="status" aria-hidden="true"></span>
					}
					<div class="flex-grow-1 min-w-0">
						<div class="fw-medium">@GetStatusHeadline(_loop.Status)</div>
						<div class="small fg-1 text-truncate">@GetProgressSummary(_loop)</div>
					</div>
					@if (_loop.Status == IterationLoopStatus.Running)
					{
						<button type="button" class="btn-sm btn-outline theme-warning rounded-pill flex-shrink-0" @onclick="PauseAutoPilot" disabled="@_isToggling">Pause</button>
						<button type="button" class="btn-sm btn-outline theme-danger rounded-pill flex-shrink-0" @onclick="StopAutoPilot" disabled="@_isToggling">Stop</button>
					}
					else if (_loop.Status == IterationLoopStatus.Paused)
					{
						<button type="button" class="btn-sm btn-outline theme-success rounded-pill flex-shrink-0" @onclick="ResumeAutoPilot" disabled="@_isToggling">Resume</button>
						<button type="button" class="btn-sm btn-outline theme-danger rounded-pill flex-shrink-0" @onclick="StopAutoPilot" disabled="@_isToggling">Stop</button>
					}
				</div>
				@if (_loop.MaxIterations > 0)
				{
					<div class="list-group-item py-3">
						<div class="progress progress-xs" role="progressbar" aria-label="Iterations done"
							 aria-valuenow="@_loop.CompletedIterations" aria-valuemin="0" aria-valuemax="@_loop.MaxIterations">
							<div class="progress-bar" style="width: @(Math.Min(100, _loop.CompletedIterations * 100 / _loop.MaxIterations))%"></div>
						</div>
					</div>
				}
				@if (_loop.CurrentJobId.HasValue)
				{
					<a href="/jobs/view/@_loop.CurrentJobId" class="list-group-item list-group-item-action d-flex align-items-center gap-5">
						<i class="bi bi-terminal fg-1 flex-shrink-0"></i>
						<span class="flex-grow-1">Current job</span>
						<i class="bi bi-chevron-right fg-2 flex-shrink-0"></i>
					</a>
				}
				else if (_loop.Status == IterationLoopStatus.Running && _loop.NextIterationAt.HasValue)
				{
					<div class="list-group-item small fg-1">Waiting before the next iteration</div>
				}
				@if (_loop.ConsecutiveFailures > 0)
				{
					<div class="list-group-item small fg-warning">
						<i class="bi bi-exclamation-triangle me-1"></i>@_loop.ConsecutiveFailures failed in a row · stops at @_loop.MaxConsecutiveFailures
					</div>
				}
			</div>
		</section>

		@if (!string.IsNullOrEmpty(_error))
		{
			<Alert Type="Alert.AlertType.Danger" Class="mb-0">@_error</Alert>
		}
	}
</div>

@code {
	[Parameter, EditorRequired]
	public Guid ProjectId { get; set; }

	[Parameter]
	public List<Provider> AvailableProviders { get; set; } = [];

	[Parameter]
	public List<InferenceProvider> AvailableInferenceProviders { get; set; } = [];

	[Parameter]
	public Project? Project { get; set; }

	private IterationLoop? _loop;
	private AutoPilotConfig _config = new();
	private bool _isLoading = true;
	private bool _isStarting;
	private bool _isToggling;
	private string? _error;
	private bool _defaultsApplied;

	protected override async Task OnInitializedAsync()
	{
		await LoadStatusAsync();
	}

	protected override void OnParametersSet()
	{
		if (!_defaultsApplied && Project != null)
		{
			_defaultsApplied = true;
			// Pre-fill from project settings
			_config.AutoCommit = Project.AutoCommitMode != AutoCommitMode.Off;
			_config.AutoPush = Project.AutoCommitMode == AutoCommitMode.CommitAndPush;
			_config.InferenceProviderId = Project.IdeaInferenceProviderId;
			_config.InferenceModelId = Project.IdeaInferenceModelId;
		}
	}

	private async Task LoadStatusAsync()
	{
		try
		{
			_isLoading = true;
			_loop = await AutoPilotService.GetStatusAsync(ProjectId);
		}
		catch (Exception ex)
		{
			_error = $"Failed to load auto-pilot status: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task StartAutoPilot()
	{
		try
		{
			_isStarting = true;
			_error = null;
			_loop = await AutoPilotService.StartAsync(ProjectId, _config);
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}
		finally
		{
			_isStarting = false;
		}
	}

	private async Task StopAutoPilot()
	{
		try
		{
			_isToggling = true;
			_error = null;
			await AutoPilotService.StopAsync(ProjectId);
			await LoadStatusAsync();
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}
		finally
		{
			_isToggling = false;
		}
	}

	private async Task PauseAutoPilot()
	{
		try
		{
			_isToggling = true;
			_error = null;
			await AutoPilotService.PauseAsync(ProjectId);
			await LoadStatusAsync();
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}
		finally
		{
			_isToggling = false;
		}
	}

	private async Task ResumeAutoPilot()
	{
		try
		{
			_isToggling = true;
			_error = null;
			await AutoPilotService.ResumeAsync(ProjectId);
			await LoadStatusAsync();
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}
		finally
		{
			_isToggling = false;
		}
	}

	/// <summary>
	/// Called by the parent page when a SignalR AutoPilotStateChanged event is received.
	/// </summary>
	public async Task RefreshAsync()
	{
		await LoadStatusAsync();
		StateHasChanged();
	}

	private void HandleInferenceModelsRefreshed(List<InferenceModel> models)
	{
		var provider = AvailableInferenceProviders.FirstOrDefault(p => p.Id == _config.InferenceProviderId);
		if (provider != null)
		{
			provider.Models = models;
		}
	}

	private void HandleCodingModelsRefreshed(List<ProviderModel> models)
	{
		var provider = AvailableProviders.FirstOrDefault(p => p.Id == _config.ProviderId);
		if (provider != null)
		{
			provider.AvailableModels = models;
		}
	}

	private List<InferenceModel> GetInferenceModelsForSelectedProvider()
	{
		if (_config.InferenceProviderId == null) return [];
		var provider = AvailableInferenceProviders.FirstOrDefault(p => p.Id == _config.InferenceProviderId);
		return provider?.Models?.Where(m => m.IsAvailable).ToList() ?? [];
	}

	private List<ProviderModel> GetCodingModelsForSelectedProvider()
	{
		if (_config.ProviderId == null) return [];
		var provider = AvailableProviders.FirstOrDefault(p => p.Id == _config.ProviderId);
		return provider?.AvailableModels?.Where(m => m.IsAvailable).ToList() ?? [];
	}

	public static bool IsTerminal(IterationLoopStatus status) =>
		status is IterationLoopStatus.Stopped or IterationLoopStatus.Exhausted
			or IterationLoopStatus.Failed or IterationLoopStatus.Idle;

	private static string GetLastRunTextClass(IterationLoopStatus status) => status switch
	{
		IterationLoopStatus.Failed => "fg-danger",
		IterationLoopStatus.Exhausted => "fg-info",
		_ => "fg-1"
	};

	private static string GetStatusHeadline(IterationLoopStatus status) => status switch
	{
		IterationLoopStatus.Paused => "Paused",
		IterationLoopStatus.Stopping => "Stopping…",
		_ => "Running"
	};

	private static string GetProgressSummary(IterationLoop loop)
	{
		var iterations = loop.MaxIterations > 0
			? $"Iteration {loop.CompletedIterations} of {loop.MaxIterations}"
			: $"{loop.CompletedIterations} iteration{(loop.CompletedIterations == 1 ? "" : "s")} done";
		var cost = loop.MaxTotalCostUsd.HasValue
			? $"${loop.TotalCostUsd:F2} of ${loop.MaxTotalCostUsd.Value:F2}"
			: $"${loop.TotalCostUsd:F2} spent";
		return $"{iterations} · {cost}";
	}

	private static string GetStatusIcon(IterationLoopStatus status) => status switch
	{
		IterationLoopStatus.Stopped => "bi-stop-circle",
		IterationLoopStatus.Exhausted => "bi-exclamation-triangle",
		IterationLoopStatus.Failed => "bi-x-circle",
		_ => "bi-circle"
	};
}
