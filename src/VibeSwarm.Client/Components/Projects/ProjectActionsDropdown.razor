@* Project actions dropdown menu component *@

<div class="flex-shrink-0">
	@if (IconOnly)
	{
		<button class="btn-solid theme-secondary rounded-circle p-0 icon-button-round" type="button"
				data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" title="Project actions" aria-label="Options">
			<i class="bi bi-three-dots"></i>
		</button>
	}
	else
	{
		<button class="btn-sm btn-solid theme-secondary" type="button" data-bs-toggle="menu" data-bs-placement="bottom-end"
				aria-expanded="false" title="Project actions">
			<i class="bi bi-gear sm:me-1"></i>
			<span class="d-none sm:d-inline">Options</span>
			<i class="bi bi-chevron-down small opacity-75"></i>
		</button>
	}
	<div class="menu">
		@if (!string.IsNullOrEmpty(DetailsHref))
		{
				<a class="menu-item" href="@DetailsHref">
					<i class="bi bi-eye"></i>View Details
				</a>
		}
		@if (OnEdit.HasDelegate)
		{
				<button class="menu-item" @onclick="OnEdit">
					<i class="bi bi-pencil fg-primary"></i>Edit Project
				</button>
		}
		@if (OnToggleActive.HasDelegate)
		{
				<button class="menu-item" @onclick="OnToggleActive">
					@if (IsActive)
					{
						<i class="bi bi-pause-circle fg-secondary"></i>
						@:Deactivate
					}
					else
					{
						<i class="bi bi-play-circle fg-success"></i>
						@:Activate
					}
				</button>
		}
		@if (ShowStartIdeaQueueAction)
		{
				<button class="menu-item" @onclick="OnStartIdeaQueue"
						disabled="@(!StartIdeaQueueEnabled || IsStartingIdeaQueue)"
						title="@StartIdeaQueueTooltip">
					@if (IsStartingIdeaQueue)
					{
						<span class="spinner-border spinner-sm me-3" role="status"></span>
					}
					else
					{
						<i class="bi bi-play-fill fg-success"></i>
					}
					@StartIdeaQueueLabel
				</button>
		}
		@if (HasGitActions)
		{
			<hr class="menu-divider">
			<h6 class="menu-header">Git</h6>
			@if (!string.IsNullOrEmpty(GitHubRepository))
			{
					<a class="menu-item" href="https://github.com/@GitHubRepository" target="_blank">
						<i class="bi bi-github"></i>View Repository
						<div class="small fg-1 font-monospace text-truncate" style="max-width: 200px;">@GitHubRepository</div>
					</a>
			}
			@if (ShowSyncAction)
			{
					<button class="menu-item" @onclick="OnSync" disabled="@AreGitActionsBusy">
						@if (IsSyncing)
						{
							<span class="spinner-border spinner-sm me-3" role="status"></span>
						}
						else
						{
							<i class="bi bi-arrow-repeat fg-success"></i>
						}
						@SyncLabel
					</button>
			}
		@if (ShowCreateBranchAction)
		{
				<button class="menu-item" @onclick="OnCreateBranch" disabled="@AreGitActionsBusy">
					<i class="bi bi-plus-lg fg-primary"></i>New Branch
				</button>
		}
		@if (ShowMergeBranchAction)
		{
				<button class="menu-item" @onclick="OnMergeBranch" disabled="@AreGitActionsBusy">
					@if (IsMerging)
					{
						<span class="spinner-border spinner-sm me-3" role="status"></span>
					}
					else
					{
						<i class="bi bi-arrow-left-right fg-success"></i>
					}
					Merge Branch...
				</button>
		}
		@if (ShowPruneBranchesAction)
		{
				<button class="menu-item" @onclick="OnPruneBranches" disabled="@AreGitActionsBusy">
						@if (IsPruning)
						{
							<span class="spinner-border spinner-sm me-3" role="status"></span>
						}
						else
						{
							<i class="bi bi-scissors fg-warning"></i>
						}
						Prune Stale Branches
					</button>
			}
			@if (ShowRefreshAction)
			{
					<button class="menu-item" @onclick="OnRefresh" disabled="@AreGitActionsBusy">
						<i class="bi bi-arrow-clockwise @(IsRefreshing ? "spinner-rotate" : string.Empty)"></i>
						Refresh Branches
					</button>
			}
		}
		@if (ShowDeleteAction)
		{
			<hr class="menu-divider">
				<button class="menu-item theme-danger" @onclick="OnDelete">
					<i class="bi bi-trash"></i>@DeleteLabel
				</button>
		}
	</div>
</div>

@code {
	/// <summary>Renders the trigger as a round "⋯" button instead of the labelled Options button.</summary>
	[Parameter]
	public bool IconOnly { get; set; }

	[Parameter]
	public string? DetailsHref { get; set; }

	[Parameter]
	public EventCallback OnEdit { get; set; }

	[Parameter]
	public bool IsActive { get; set; } = true;

	[Parameter]
	public EventCallback OnToggleActive { get; set; }

	[Parameter]
	public bool ShowStartIdeaQueueAction { get; set; }

	[Parameter]
	public bool StartIdeaQueueEnabled { get; set; } = true;

	[Parameter]
	public bool IsStartingIdeaQueue { get; set; }

	[Parameter]
	public string StartIdeaQueueLabel { get; set; } = "Start Idea Queue";

	[Parameter]
	public string? StartIdeaQueueTooltip { get; set; }

	[Parameter]
	public EventCallback OnStartIdeaQueue { get; set; }

	[Parameter]
	public string? GitHubRepository { get; set; }

	[Parameter]
	public bool ShowSyncAction { get; set; }

	[Parameter]
	public string SyncLabel { get; set; } = "Sync with Origin";

	[Parameter]
	public bool ShowCreateBranchAction { get; set; }

	[Parameter]
	public bool ShowMergeBranchAction { get; set; }

	[Parameter]
	public bool ShowRefreshAction { get; set; }

	[Parameter]
	public bool ShowPruneBranchesAction { get; set; }

	[Parameter]
	public bool IsSyncing { get; set; }

	[Parameter]
	public bool IsRefreshing { get; set; }

	[Parameter]
	public bool IsPruning { get; set; }

	[Parameter]
	public bool IsMerging { get; set; }

	[Parameter]
	public EventCallback OnSync { get; set; }

	[Parameter]
	public EventCallback OnCreateBranch { get; set; }

	[Parameter]
	public EventCallback OnMergeBranch { get; set; }

	[Parameter]
	public EventCallback OnRefresh { get; set; }

	[Parameter]
	public EventCallback OnPruneBranches { get; set; }

	[Parameter]
	public bool ShowDeleteAction { get; set; }

	[Parameter]
	public string DeleteLabel { get; set; } = "Delete";

	[Parameter]
	public EventCallback OnDelete { get; set; }

	private bool HasGitActions => !string.IsNullOrEmpty(GitHubRepository) || ShowSyncAction || ShowCreateBranchAction || ShowMergeBranchAction || ShowRefreshAction || ShowPruneBranchesAction;

	private bool AreGitActionsBusy => IsSyncing || IsRefreshing || IsPruning || IsMerging;
}
