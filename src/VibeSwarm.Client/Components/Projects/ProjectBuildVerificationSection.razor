<div class="form-field mb-1">
	<div class="switch">
		<InputCheckbox role="switch" switch id="modal-buildVerificationEnabled" @bind-Value="Project.BuildVerificationEnabled" />
	</div>
	<label for="modal-buildVerificationEnabled">Verify builds before committing</label>
</div>
<div class="form-text mb-5">
	VibeSwarm runs these commands after a job finishes and only commits when they pass.
</div>

@if (!string.IsNullOrWhiteSpace(DetectedStack))
{
	<div class="alert theme-info py-3 px-5 small" role="status">
		<i class="bi bi-magic flex-shrink-0 mt-1"></i>
		<div class="min-w-0">Detected a <strong>@DetectedStack</strong> project — the commands below were filled in for you.</div>
	</div>
}

<div class="mb-5">
	<label for="modal-buildCommand" class="form-label">
		Build command <span class="fg-1 fw-normal">(required when enabled)</span>
	</label>
	<InputText id="modal-buildCommand" @bind-Value="Project.BuildCommand" class="form-control font-monospace"
			   placeholder="dotnet build" maxlength="500" />
	<ValidationMessage For="@(() => Project.BuildCommand)" class="fg-danger small" />
</div>

<div>
	<label for="modal-testCommand" class="form-label">
		Test command <span class="fg-1 fw-normal">(optional)</span>
	</label>
	<InputText id="modal-testCommand" @bind-Value="Project.TestCommand" class="form-control font-monospace"
			   placeholder="dotnet test" maxlength="500" />
	<ValidationMessage For="@(() => Project.TestCommand)" class="fg-danger small" />
	<div class="form-text">Runs after the build command succeeds.</div>
</div>

@code {
	[Parameter, EditorRequired]
	public ProjectModalFormModel Project { get; set; } = default!;

	/// <summary>Stack detected from the working folder, shown so the pre-filled commands make sense.</summary>
	[Parameter]
	public string? DetectedStack { get; set; }
}
