@if (Project != null)
{
	<div class="form-field mb-1">
		<div class="switch">
			<InputCheckbox role="switch" switch id="modal-planningEnabled" @bind-Value="Project.PlanningEnabled"
						   @bind-Value:after="HandlePlanningEnabledChanged" />
		</div>
		<label for="modal-planningEnabled">Review a plan before each job</label>
	</div>
	<div class="form-text mb-5">
		Idea expansion runs through Claude Code or Copilot plan mode so you can review a structured implementation
		plan before the job is created.
	</div>

	@if (Project.PlanningEnabled)
	{
		@if (!AvailableProviders.Any())
		{
			<Alert Type="Alert.AlertType.Warning" Class="py-3 px-5 small mb-0">
				<span>Planning needs an enabled Claude or Copilot provider. Add one under Providers first.</span>
			</Alert>
		}
		else
		{
			<div class="mb-5">
				<label for="modal-planningProvider" class="form-label">Planning provider</label>
				<InputSelect TValue="Guid?" id="modal-planningProvider" @bind-Value="Project.PlanningProviderId"
							 @bind-Value:after="HandlePlanningProviderChanged" class="form-control">
					@foreach (var provider in AvailableProviders)
					{
						<option value="@provider.Id">@provider.Name (@provider.Type)</option>
					}
				</InputSelect>
			</div>

			<div class="row g-5">
				<div class="col-12 sm:col-6">
					<label for="modal-planningModel" class="form-label">
						Model <span class="fg-1 fw-normal">(optional)</span>
					</label>
					<div class="input-group">
						<InputSelect id="modal-planningModel" @bind-Value="Project.PlanningModelId" class="form-control"
									 disabled="@(!Project.PlanningProviderId.HasValue || !PlanningModels.Any())">
							<option value="">Provider default</option>
							@foreach (var model in PlanningModels)
							{
								<option value="@model.ModelId">@(model.DisplayName ?? model.ModelId)@((model.IsDefault ? " (Default)" : string.Empty))</option>
							}
						</InputSelect>
						<ModelRefreshButton ProviderId="@Project.PlanningProviderId"
											OnRefreshed="() => OnPlanningModelsRefreshed.InvokeAsync()" />
					</div>
					@if (Project.PlanningProviderId.HasValue && !PlanningModels.Any())
					{
						<div class="form-text">No cached models yet — the provider default is used.</div>
					}
				</div>

				<div class="col-12 sm:col-6">
					<label for="modal-planningReasoning" class="form-label">
						Reasoning <span class="fg-1 fw-normal">(optional)</span>
					</label>
					<InputSelect id="modal-planningReasoning" @bind-Value="Project.PlanningReasoningEffort"
								 class="form-control"
								 disabled="@(!Project.PlanningProviderId.HasValue || !PlanningReasoningOptions.Any())">
						<option value="">Provider default</option>
						@foreach (var reasoning in PlanningReasoningOptions)
						{
							<option value="@reasoning">@reasoning</option>
						}
					</InputSelect>
					@if (Project.PlanningProviderId.HasValue && !PlanningReasoningOptions.Any())
					{
						<div class="form-text">This provider has no configurable reasoning levels.</div>
					}
				</div>
			</div>
		}
	}
}

@code {
	[Parameter, EditorRequired]
	public ProjectModalFormModel Project { get; set; } = default!;

	[Parameter]
	public IReadOnlyList<Provider> AvailableProviders { get; set; } = [];

	[Parameter]
	public IReadOnlyList<ProviderModel> PlanningModels { get; set; } = [];

	private IReadOnlyList<string> PlanningReasoningOptions => Project.PlanningProviderId.HasValue
		? AvailableProviders
			.Where(provider => provider.Id == Project.PlanningProviderId.Value)
			.SelectMany(ProviderCapabilities.GetSupportedReasoningEfforts)
			.Distinct(StringComparer.Ordinal)
			.ToList()
		: [];

	[Parameter]
	public EventCallback OnPlanningEnabledChanged { get; set; }

	[Parameter]
	public EventCallback OnPlanningProviderChanged { get; set; }

	[Parameter]
	public EventCallback OnPlanningModelsRefreshed { get; set; }

	private Task HandlePlanningEnabledChanged() => OnPlanningEnabledChanged.InvokeAsync();

	private Task HandlePlanningProviderChanged() => OnPlanningProviderChanged.InvokeAsync();
}
