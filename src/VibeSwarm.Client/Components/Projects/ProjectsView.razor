@inject IProjectService ProjectService
@inject IJobService JobService
@inject NotificationService NotificationService
@inject IServiceProvider Services
@implements IDisposable

@* Projects list: a large title, one search field, and one row per project. Everything a project
   can do lives on its own page, so the list stays a list. *@

<div class="d-flex flex-column gap-5">
	<div class="d-flex align-items-center gap-3">
		<h1 class="mb-0 me-auto">Projects</h1>
		@if (ProjectsWithInfo.Any())
		{
			<div>
				<button type="button" class="btn-solid theme-secondary rounded-circle p-0 icon-button-round"
						data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" title="More" aria-label="More project actions">
					<i class="bi bi-three-dots"></i>
				</button>
				<div class="menu">
					<button type="button" class="menu-item" @onclick="ShowSyncAllModal" disabled="@(_isSyncingAll || !GetSyncableProjects().Any())">
						<i class="bi bi-arrow-repeat @(_isSyncingAll ? "spinner-rotate" : "")"></i>Sync all projects with origin
					</button>
				</div>
			</div>
		}
		@* Every way to add a project or a folder sits behind the one + button. *@
		<div>
			<button type="button" class="btn-solid theme-primary rounded-circle p-0 icon-button-round"
					data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" title="Add" aria-label="Add">
				<i class="bi bi-plus-lg"></i>
			</button>
			<div class="menu">
				<button type="button" class="menu-item" @onclick="ShowAddModal"><i class="bi bi-plus-lg"></i>New project</button>
				<button type="button" class="menu-item" @onclick="ShowScanModal"><i class="bi bi-folder-symlink"></i>Import folders already on this host</button>
				<button type="button" class="menu-item" @onclick="ShowNewFolderModal"><i class="bi bi-folder-plus"></i>New folder</button>
			</div>
		</div>
	</div>

	@if (ProjectsWithInfo.Any())
	{
		<div class="d-flex flex-column sm:flex-row gap-3">
			<div class="position-relative flex-grow-1" role="search">
				<i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-5 fg-2 pe-none"></i>
				<input type="search" class="form-control rounded-pill bg-2 border-0 ps-12" placeholder="Search projects"
					   aria-label="Search projects" @bind="_projectSearchQuery" @bind:event="oninput" />
			</div>
			@if (GetInactiveCount() > 0)
			{
				<div class="btn-group btn-group-sm flex-shrink-0" role="group" aria-label="Show">
					<button type="button" class="btn @(ActiveFilter == "active" ? "btn-solid theme-primary" : "btn-solid theme-secondary")"
							@onclick='() => SetFilter("active")' aria-pressed="@(ActiveFilter == "active" ? "true" : "false")">Active</button>
					<button type="button" class="btn @(ActiveFilter == "inactive" ? "btn-solid theme-primary" : "btn-solid theme-secondary")"
							@onclick='() => SetFilter("inactive")' aria-pressed="@(ActiveFilter == "inactive" ? "true" : "false")">Inactive · @GetInactiveCount()</button>
					<button type="button" class="btn @(ActiveFilter == "all" ? "btn-solid theme-primary" : "btn-solid theme-secondary")"
							@onclick='() => SetFilter("all")' aria-pressed="@(ActiveFilter == "all" ? "true" : "false")">All</button>
				</div>
			}
		</div>
	}

	@if (ShowInitialLoadingSpinner)
	{
		<LoadingSpinner Text="Loading projects..." />
	}
	else if (!ProjectsWithInfo.Any() && !Folders.Any())
	{
		<EmptyState Icon="folder" Title="No projects yet"
					Message="Point VibeSwarm at a folder on this host, or import repositories it already finds there.">
			<ActionButton Icon="plus" Text="New project" Style="ActionButton.ButtonStyle.Primary" OnClick="ShowAddModal" />
			<ActionButton Icon="folder-symlink" Text="Import from disk" OnClick="ShowScanModal" />
		</EmptyState>
	}
	else if (!GetProjectGroups().Any())
	{
		@if (!string.IsNullOrWhiteSpace(_projectSearchQuery))
		{
			<EmptyState Icon="search" Title="No matching projects"
						Message="No projects match your search. Try a different name or repository." />
		}
		else
		{
			<EmptyState Icon="@(ActiveFilter == "active" ? "folder" : "pause-circle")"
						Title="@(ActiveFilter == "active" ? "No active projects" : "No inactive projects")"
						Message="@(ActiveFilter == "active" ? "All your projects are currently inactive." : "All your projects are currently active.")" />
		}
	}
	else
	{
		@foreach (var group in GetProjectGroups())
		{
			<section @key="@(group.Folder?.Id ?? Guid.Empty)" class="d-flex flex-column gap-3">
				@if (Folders.Any())
				{
					<SectionHeader Title="@(group.Folder?.Name ?? "Other projects")">
						<Actions>
							@if (group.Folder is { } folder)
							{
								<button type="button" class="btn-sm btn-link text-decoration-none px-0"
										@onclick="() => ShowAddToFolderModal(folder)">Add</button>
								<a href="@($"/projects/folders/{folder.Id}")" class="btn-sm btn-link text-decoration-none px-0">Open</a>
								<button type="button" class="btn-sm btn-link text-decoration-none px-0"
										@onclick="() => ShowRenameFolderModal(folder)">Rename</button>
								<button type="button" class="btn-sm btn-link fg-danger text-decoration-none px-0"
										@onclick="() => ShowDeleteFolderModal(folder)">Delete</button>
							}
						</Actions>
					</SectionHeader>
				}
				<div class="list-group rounded-9">
					@foreach (var projectInfo in group.Projects)
					{
						var project = projectInfo.Project;
						<ProjectListItem @key="project.Id" Project="@project" Stats="@projectInfo.Stats" LatestJob="@projectInfo.LatestJob"
										 ActiveJobs="@ActiveJobs.Where(job => job.ProjectId == project.Id).ToList()"
										 CurrentBranch="@projectInfo.CurrentBranch" OnSync="() => SyncProjectAsync(projectInfo)"
										 IsSyncing="@_syncingProjectIds.Contains(project.Id)" SyncBlocked="@IsCheckoutInUse(projectInfo, ActiveJobs)" />
					}
					@if (group.Projects.Count == 0)
					{
						<div class="list-group-item small fg-1 py-5">No projects yet. Use Add to move one in.</div>
					}
				</div>
			</section>
		}
	}
</div>

<ProjectFolderModal @bind-IsVisible="_showFolderModal" Folder="@_folderBeingRenamed" OnSaved="HandleFolderSaved" />

<AddProjectToFolderModal @bind-IsVisible="_showAddToFolderModal" Folder="@_folderAddingTo"
						 Projects="@ProjectsWithInfo.Select(info => info.Project).ToList()" Folders="@Folders"
						 OnMoved="HandleProjectMoved" />

<ConfirmationModal @bind-IsVisible="_showDeleteFolderModal" Title="Delete folder"
				   Message="@($"Delete the folder \"{_folderBeingDeleted?.Name}\"?")"
				   SubMessage="Its projects stay, outside any folder. Links between projects don't change."
				   ConfirmText="Delete" IsProcessing="_isDeletingFolder" ErrorMessage="@_deleteFolderError"
				   OnConfirm="DeleteFolderAsync" OnCancel="() => _showDeleteFolderModal = false" />

<ConfirmationModal @bind-IsVisible="_showSyncAllModal" Title="Sync all projects with origin"
				   Message="@(_syncAllProgress ?? $"Sync {GetSyncableProjects().Count()} git {Plural(GetSyncableProjects().Count(), "project")} with origin?")"
				   SubMessage="Each checkout is reset to its branch on origin. Uncommitted changes are saved first and unpushed commits are kept on top. Projects with a queued, running or paused job are skipped."
				   ConfirmText="Sync all" ButtonClass="btn-solid theme-primary" IsProcessing="_isSyncingAll" ErrorMessage="@_syncAllError"
				   OnConfirm="SyncAllProjectsAsync" OnCancel="() => _showSyncAllModal = false" />

<ScanProjectsModal @ref="_scanProjectsModal" OnProjectsImported="HandleProjectsImported" />

<ProjectModal @bind-IsVisible="ShowProjectModal" OnSaved="HandleProjectSaved"
			  OnCancelled="HandleProjectModalClosed" OnClosed="HandleProjectModalClosed" />

@code {
	private List<ProjectInfoWithStats> ProjectsWithInfo { get; set; } = new();
	private List<ProjectFolder> Folders { get; set; } = new();
	private bool _showFolderModal;
	private ProjectFolder? _folderBeingRenamed;
	private bool _showAddToFolderModal;
	private ProjectFolder? _folderAddingTo;
	private bool _showDeleteFolderModal;
	private ProjectFolder? _folderBeingDeleted;
	private bool _isDeletingFolder;
	private string? _deleteFolderError;
	private List<JobSummary> ActiveJobs { get; set; } = new();
	private bool IsLoading { get; set; } = true;
	private bool HasLoadedProjectsInitially { get; set; }
	private System.Threading.Timer? _refreshTimer;
	private string ActiveFilter { get; set; } = "active";
	private string _projectSearchQuery = string.Empty;
	private bool _isAutoRefreshing;
	private bool _disposed;
	private bool ShowInitialLoadingSpinner => IsLoading && !HasLoadedProjectsInitially;

	private ScanProjectsModal? _scanProjectsModal;
	private readonly HashSet<Guid> _syncingProjectIds = [];
	private bool _showSyncAllModal;
	private bool _isSyncingAll;
	private string? _syncAllProgress;
	private string? _syncAllError;
	private bool ShowProjectModal { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await LoadFolders();
		await LoadProjects();
		await LoadActiveJobs();
		StartAutoRefresh();
	}

	private void StartAutoRefresh()
	{
		_refreshTimer = new System.Threading.Timer(async _ =>
		{
			if (_disposed || _isAutoRefreshing || (!ActiveJobs.Any() && !ProjectsWithInfo.Any(info => info.Project.IdeasProcessingActive)))
			{
				return;
			}

			_isAutoRefreshing = true;
			try
			{
				await InvokeAsync(async () =>
				{
					if (_disposed) return;
					await LoadProjects();
					await LoadActiveJobs();
					StateHasChanged();
				});
			}
			catch (ObjectDisposedException) { }
			catch (Exception)
			{
			}
			finally
			{
				_isAutoRefreshing = false;
			}
		}, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
	}

	private async Task LoadActiveJobs()
	{
		try
		{
			ActiveJobs = (await JobService.GetActiveJobsAsync()).ToList();
		}
		catch
		{
			// Ignore errors loading active jobs
		}
	}

	private void SetFilter(string filter)
	{
		ActiveFilter = filter;
	}

	private int GetInactiveCount() => ProjectsWithInfo.Count(p => !p.Project.IsActive);

	private IEnumerable<ProjectInfoWithStats> GetFilteredProjects()
	{
		var byActive = ActiveFilter switch
		{
			"inactive" => ProjectsWithInfo.Where(p => !p.Project.IsActive),
			"all" => ProjectsWithInfo,
			_ => ProjectsWithInfo.Where(p => p.Project.IsActive)
		};

		if (string.IsNullOrWhiteSpace(_projectSearchQuery))
			return byActive;

		var term = _projectSearchQuery.Trim();
		return byActive.Where(p =>
			p.Project.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
			(!string.IsNullOrEmpty(p.Project.GitHubRepository) &&
			 p.Project.GitHubRepository.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
			(!string.IsNullOrEmpty(p.Project.WorkingPath) &&
			 p.Project.WorkingPath.Contains(term, StringComparison.OrdinalIgnoreCase)));
	}

	/// <summary>
	/// One section per folder, by name, then the projects outside any folder. A folder that
	/// holds no projects at all still shows (so it can be renamed or deleted) unless searching.
	/// </summary>
	private List<ProjectGroup> GetProjectGroups()
	{
		var filtered = GetFilteredProjects().ToList();
		if (!Folders.Any())
		{
			return filtered.Count == 0 ? [] : [new ProjectGroup(null, filtered)];
		}

		var folderIds = Folders.Select(folder => folder.Id).ToHashSet();
		var groups = new List<ProjectGroup>();
		foreach (var folder in Folders.OrderBy(folder => folder.Name, StringComparer.OrdinalIgnoreCase))
		{
			var projects = filtered.Where(info => info.Project.FolderId == folder.Id).ToList();
			var isEmptyFolder = !ProjectsWithInfo.Any(info => info.Project.FolderId == folder.Id);
			if (projects.Count > 0 || (isEmptyFolder && string.IsNullOrWhiteSpace(_projectSearchQuery)))
			{
				groups.Add(new ProjectGroup(folder, projects));
			}
		}

		var ungrouped = filtered
			.Where(info => !info.Project.FolderId.HasValue || !folderIds.Contains(info.Project.FolderId.Value))
			.ToList();
		if (ungrouped.Count > 0)
		{
			groups.Add(new ProjectGroup(null, ungrouped));
		}

		return groups;
	}

	private sealed record ProjectGroup(ProjectFolder? Folder, List<ProjectInfoWithStats> Projects);

	private async Task LoadFolders()
	{
		try
		{
			Folders = (await ProjectService.GetFoldersAsync()).ToList();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to load folders: {ex.Message}");
		}
	}

	private void ShowNewFolderModal()
	{
		_folderBeingRenamed = null;
		_showFolderModal = true;
	}

	private void ShowRenameFolderModal(ProjectFolder folder)
	{
		_folderBeingRenamed = folder;
		_showFolderModal = true;
	}

	private async Task HandleFolderSaved(ProjectFolder folder)
	{
		await LoadFolders();
	}

	private void ShowAddToFolderModal(ProjectFolder folder)
	{
		_folderAddingTo = folder;
		_showAddToFolderModal = true;
	}

	private async Task HandleProjectMoved(Project project)
	{
		await LoadProjects();
	}

	private void ShowDeleteFolderModal(ProjectFolder folder)
	{
		_folderBeingDeleted = folder;
		_deleteFolderError = null;
		_showDeleteFolderModal = true;
	}

	private async Task DeleteFolderAsync()
	{
		if (_folderBeingDeleted == null)
		{
			return;
		}

		_isDeletingFolder = true;
		_deleteFolderError = null;
		try
		{
			await ProjectService.DeleteFolderAsync(_folderBeingDeleted.Id);
			_showDeleteFolderModal = false;
			_folderBeingDeleted = null;
			await LoadFolders();
			await LoadProjects();
		}
		catch (Exception ex)
		{
			_deleteFolderError = ex.Message;
		}
		finally
		{
			_isDeletingFolder = false;
		}
	}

	private async Task LoadProjects()
	{
		if (!HasLoadedProjectsInitially)
			IsLoading = true;
		try
		{
			var projectsWithStats = (await ProjectService.GetAllWithStatsAsync()).ToList();
			ProjectsWithInfo = projectsWithStats
				.Select(projectWithStats => new ProjectInfoWithStats
				{
					Project = projectWithStats.Project,
					Stats = projectWithStats.Stats,
					LatestJob = projectWithStats.LatestJob,
					CurrentBranch = projectWithStats.CurrentBranch
				})
				.ToList();
			HasLoadedProjectsInitially = true;
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to load projects: {ex.Message}");
		}
		finally
		{
			IsLoading = false;
		}
	}

	/// <summary>Git checkouts, which can sync with origin. Folders and filters don't narrow it.</summary>
	private IEnumerable<ProjectInfoWithStats> GetSyncableProjects()
		=> ProjectsWithInfo.Where(info => !string.IsNullOrEmpty(info.CurrentBranch) && !string.IsNullOrEmpty(info.Project.WorkingPath));

	/// <summary>
	/// A queued, running or paused job owns the checkout. Syncing would reset it under the job, so
	/// sync stays off for that project.
	/// </summary>
	private static bool IsCheckoutInUse(ProjectInfoWithStats info, IEnumerable<JobSummary> activeJobs)
		=> activeJobs.Any(job => job.ProjectId == info.Project.Id) || info.LatestJob?.Status == JobStatus.Paused;

	private static string Plural(int count, string noun) => count == 1 ? noun : $"{noun}s";

	private async Task SyncProjectAsync(ProjectInfoWithStats info)
	{
		await LoadActiveJobs();
		if (IsCheckoutInUse(info, ActiveJobs))
		{
			NotificationService.ShowProjectWarning(info.Project.Name, "Not synced: a job is using this checkout.");
			return;
		}

		var result = await RunSyncAsync(info.Project);
		if (result == null)
		{
			return;
		}

		if (!result.Success)
		{
			NotificationService.ShowProjectError(info.Project.Name, result.Error ?? "Failed to sync with origin.");
		}
		else if (!string.IsNullOrEmpty(result.RecoveryBranch))
		{
			NotificationService.ShowProjectWarning(info.Project.Name, DescribeSync(result));
		}
		else
		{
			NotificationService.ShowProjectSuccess(info.Project.Name, DescribeSync(result));
		}
	}

	/// <summary>Syncs one checkout, or returns null when a sync of it is already running.</summary>
	private async Task<GitOperationResult?> RunSyncAsync(Project project)
	{
		if (!_syncingProjectIds.Add(project.Id))
		{
			return null;
		}

		StateHasChanged();
		try
		{
			return await Services.GetRequiredService<IVersionControlService>().SyncWithOriginAsync(project.WorkingPath);
		}
		catch (Exception ex)
		{
			return GitOperationResult.Failed($"Error syncing with origin: {ex.Message}");
		}
		finally
		{
			_syncingProjectIds.Remove(project.Id);
		}
	}

	private static string DescribeSync(GitOperationResult result)
	{
		var message = string.IsNullOrEmpty(result.BranchName)
			? "Synced with origin."
			: $"Synced with {result.RemoteName ?? "origin"}/{result.BranchName}.";
		if (result.ChangedFilesCount is > 0 and var changed)
		{
			message += $" Saved {changed} uncommitted {Plural(changed, "file")} to {result.SavedReference} first.";
		}

		if (!string.IsNullOrEmpty(result.RecoveryBranch))
		{
			message += $" Unpushed commits conflicted and were kept on {result.RecoveryBranch}.";
		}
		else if (result.KeptLocalCommits is > 0 and var kept)
		{
			message += $" Kept {kept} unpushed {Plural(kept, "commit")} on top.";
		}

		return message;
	}

	private void ShowSyncAllModal()
	{
		_syncAllError = null;
		_syncAllProgress = null;
		_showSyncAllModal = true;
	}

	/// <summary>
	/// Syncs every git checkout with origin, one at a time. Active jobs are re-read first so a job
	/// that started since the last refresh is skipped too; if they can't be read, nothing syncs.
	/// </summary>
	private async Task SyncAllProjectsAsync()
	{
		if (_isSyncingAll)
		{
			return;
		}

		_isSyncingAll = true;
		_syncAllError = null;
		try
		{
			List<JobSummary> activeJobs;
			try
			{
				activeJobs = (await JobService.GetActiveJobsAsync()).ToList();
			}
			catch (Exception ex)
			{
				_syncAllError = $"Couldn't check for running jobs, so nothing was synced: {ex.Message}";
				return;
			}

			ActiveJobs = activeJobs;
			var targets = GetSyncableProjects().ToList();
			var skipped = targets.Where(info => IsCheckoutInUse(info, activeJobs)).Select(info => info.Project.Name).ToList();
			var toSync = targets.Where(info => !IsCheckoutInUse(info, activeJobs)).ToList();
			var synced = 0;
			var failed = 0;

			for (var i = 0; i < toSync.Count; i++)
			{
				var project = toSync[i].Project;
				_syncAllProgress = $"Syncing {project.Name} ({i + 1} of {toSync.Count})...";
				var result = await RunSyncAsync(project);
				if (result == null)
				{
					// Its row's sync is already running and reports its own outcome.
					continue;
				}

				if (!result.Success)
				{
					failed++;
					NotificationService.ShowProjectError(project.Name, result.Error ?? "Failed to sync with origin.");
				}
				else
				{
					synced++;
					if (!string.IsNullOrEmpty(result.RecoveryBranch))
					{
						NotificationService.ShowProjectWarning(project.Name, DescribeSync(result));
					}
				}
			}

			_showSyncAllModal = false;
			var summary = $"Synced {synced} of {toSync.Count} {Plural(toSync.Count, "project")} with origin.";
			if (failed > 0)
			{
				summary += $" {failed} failed.";
			}

			if (skipped.Count > 0)
			{
				summary += $" Skipped {string.Join(", ", skipped)}: a job is using the checkout.";
			}

			if (failed > 0 && synced == 0)
			{
				NotificationService.ShowError(summary, "Sync all projects");
			}
			else if (failed > 0 || synced == 0)
			{
				NotificationService.ShowWarning(summary, "Sync all projects");
			}
			else
			{
				NotificationService.ShowSuccess(summary, "Sync all projects");
			}
		}
		finally
		{
			_isSyncingAll = false;
			_syncAllProgress = null;
		}
	}

	private void ShowAddModal()
	{
		ShowProjectModal = true;
	}

	private async Task ShowScanModal()
	{
		if (_scanProjectsModal != null)
		{
			await _scanProjectsModal.ShowAsync();
		}
	}

	private async Task HandleProjectsImported()
	{
		await LoadProjects();
		StateHasChanged();
	}

	private async Task HandleProjectSaved(Guid? newProjectId)
	{
		ShowProjectModal = false;
		await LoadProjects();
	}

	private void HandleProjectModalClosed()
	{
		ShowProjectModal = false;
	}

	public void Dispose()
	{
		_disposed = true;
		_refreshTimer?.Dispose();
	}
}
