@if (Project != null)
{
	<div class="mb-3">
		<label for="modal-ideaInferenceProvider" class="form-label">Idea provider</label>
		<InputSelect TValue="Guid?" id="modal-ideaInferenceProvider" @bind-Value="Project.IdeaInferenceProviderId"
					 @bind-Value:after="HandleProviderChanged" class="form-select">
			<option value="">Use the coding provider</option>
			@foreach (var provider in AvailableInferenceProviders)
			{
				<option value="@provider.Id">@provider.Name (@provider.ProviderType)</option>
			}
		</InputSelect>
		<div class="form-text">
			Generates improvement ideas from the codebase for Auto-Pilot and the Suggest button. Uses providers
			configured under Inference.
		</div>
	</div>

	@if (Project.IdeaInferenceProviderId.HasValue)
	{
		<div class="mb-3">
			<label for="modal-ideaInferenceModel" class="form-label">
				Idea model <span class="text-body-secondary fw-normal">(optional)</span>
			</label>
			<div class="input-group">
				<InputSelect id="modal-ideaInferenceModel" @bind-Value="Project.IdeaInferenceModelId" class="form-select"
							 disabled="@(!InferenceModels.Any())">
					<option value="">Provider default</option>
					@foreach (var model in InferenceModels)
					{
						<option value="@model.ModelId">@(model.DisplayName ?? model.ModelId)</option>
					}
				</InputSelect>
				<ModelRefreshButton ProviderId="@Project.IdeaInferenceProviderId" IsInference="true"
									OnInferenceRefreshed="() => OnModelsRefreshed.InvokeAsync()" />
			</div>
			@if (!InferenceModels.Any())
			{
				<div class="form-text">No models cached yet — use the refresh button to load them.</div>
			}
		</div>
	}
}

@code {
	[Parameter, EditorRequired]
	public ProjectModalFormModel Project { get; set; } = default!;

	[Parameter]
	public IReadOnlyList<InferenceProvider> AvailableInferenceProviders { get; set; } = [];

	[Parameter]
	public IReadOnlyList<InferenceModel> InferenceModels { get; set; } = [];

	[Parameter]
	public EventCallback OnProviderChanged { get; set; }

	[Parameter]
	public EventCallback OnModelsRefreshed { get; set; }

	private Task HandleProviderChanged() => OnProviderChanged.InvokeAsync();
}
