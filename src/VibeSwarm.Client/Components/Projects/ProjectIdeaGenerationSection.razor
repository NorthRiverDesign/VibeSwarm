@* Who suggests improvement ideas for the project: an inference profile, or the coding provider. *@
@if (Project != null)
{
	<ProfilePicker Id="modal-ideasProfile" Class="mb-5" Label="Ideas come from" Profiles="Profiles" Allowed="ProjectInferenceRoles.CanAnswerAlone"
				   SelectedProfileId="Project.IdeasProfileId" EmptyLabel="The coding provider"
				   OnSelected="profile => ProjectInferenceRoles.Apply(profile, (id, provider, model) => (Project.IdeasProfileId, Project.IdeaInferenceProviderId, Project.IdeaInferenceModelId) = (id, provider, model))"
				   EmptyHint="An inference profile can suggest ideas from the codebase for Auto-Pilot and the Suggest button, without using a coding provider's limits." />
}

@code {
	[Parameter, EditorRequired]
	public ProjectModalFormModel Project { get; set; } = default!;

	/// <summary>Every profile; ideas take an inference one.</summary>
	[Parameter]
	public IReadOnlyList<Profile> Profiles { get; set; } = [];
}
