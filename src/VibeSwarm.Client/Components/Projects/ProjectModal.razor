@* Modal component for adding and editing projects *@
@using VibeSwarm.Client.Components.Projects
@using VibeSwarm.Shared.Validation
@inject IProjectService ProjectService
@inject IProviderService ProviderService
@inject ISettingsService SettingsService
@inject NotificationService NotificationService
@inject IServiceProvider Services

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="HandleModalVisibilityChanged"
Title="@DialogTitle" Icon="@(IsEdit ? "pencil" : "folder-plus")"
Size="ModalDialog.ModalSize.Large" DialogClass="vs-dialog-wide-lg" OnClose="HandleClose"
BodyClass="vs-project-dialog-body">
<ChildContent>
@* No overflow-x-hidden here: it would make the form its own scroll container and
   the sticky action bar below would have nothing to stick to. The modal body and
   content already clip horizontally. *@
<EditForm Model="@FormModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit"
class="max-w-100">
<DataAnnotationsValidator />
<ValidationSummary class="fg-danger mb-5" />

<ProjectWorkspaceSection FormModel="@FormModel" FormState="@_formState" IsEdit="@IsEdit"
WorkingPathPlaceholder="@_formState.WorkingPathPlaceholder"
WorkingPathHelpText="@_formState.GetWorkingPathHelpText(FormModel)"
DefaultProjectsDirectory="@_defaultProjectsDirectory"
ExistingProjectPaths="@_existingProjectPaths"
OnBrowseWorkingPath="OpenDirectoryBrowser"
OnBrowseGitHubRepositories="OpenGitHubRepositoryBrowser"
OnGitHubRepositoryChanged="OnGitHubRepositoryChanged"
OnSourceModeSelected="SelectSourceMode"
OnWorkspaceInspected="HandleWorkspaceInspected" />

@* Who builds, and who plans, reviews, advises and leads: always in view, since a project
   that pairs a large builder with cheaper helpers is what the app is for. *@
<ProjectTeamSection Project="@FormModel" Profiles="@_profiles" TeamLeadProfileId="@_teamLeadProfileId" TeamReviewProfileId="@_teamReviewProfileId" />

@* Everything below has a working default. It stays collapsed so a new project needs
   nothing more than a folder and a name. *@
<div class="accordion mb-7">
@if (!IsEdit && FormModel.CreationMode == ProjectCreationMode.CreateGitHubRepository)
{
<AccordionSection Title="Repository options" Icon="github"
Summary="Visibility, .gitignore, license, README"
Badge="@(FormModel.NewGitHubRepositoryPrivate ? "Private" : "Public")"
@bind-IsOpen="_openRepositoryOptions">
<ProjectGitHubRepositoryOptions FormModel="@FormModel" />
</AccordionSection>
}

<AccordionSection Title="When a job finishes" Icon="git"
Summary="Commit, push and pull request behavior"
Badge="@AutoCommitSummary" @bind-IsOpen="_openAutomation">
<ProjectAutomationSection Project="@FormModel" IsEdit="@IsEdit" Profiles="@_profiles" />
</AccordionSection>

<AccordionSection Title="Ideas" Icon="lightbulb"
Summary="How improvement ideas are generated"
@bind-IsOpen="_openIdeas">
<ProjectIdeaGenerationSection Project="@FormModel" Profiles="@_profiles" />
</AccordionSection>

<AccordionSection Title="Instructions and memory" Icon="journal-richtext"
Summary="Context every job on this project receives"
Badge="@(HasInstructions ? "Set" : null)" @bind-IsOpen="_openInstructions">
<ProjectInstructionsSection Project="@FormModel" />
</AccordionSection>

<AccordionSection Title="Folder and linked projects" Icon="link-45deg"
Summary="Group this project and link related repositories"
Badge="@LinksSummary" @bind-IsOpen="_openLinks">
<ProjectLinksSection Project="@FormModel" Folders="@_folders" AllProjects="@_allProjects" />
</AccordionSection>

<AccordionSection Title="Build verification" Icon="shield-check"
Summary="Run build and tests before committing"
Badge="@(FormModel.BuildVerificationEnabled ? "On" : null)"
BadgeClass="theme-success" @bind-IsOpen="_openBuildVerification">
<ProjectBuildVerificationSection Project="@FormModel" DetectedStack="@_detectedStack" />
</AccordionSection>
</div>

@if (!string.IsNullOrEmpty(_cloneProgressMessage))
{
<Alert Type="Alert.AlertType.Info" Message="@_cloneProgressMessage" Class="mb-5" />
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
<div class="fg-danger small mb-5">
<i class="bi bi-exclamation-circle me-1"></i>@ErrorMessage
</div>
}

@* Pinned to the bottom of the scrolling body: the form is long on a phone and
   Create should never be a scroll away. z-sticky keeps it above content scrolling
   under it: an open accordion item and a focused input-group raise their own z-index. *@
<div class="d-flex gap-3 sm:justify-content-end position-sticky z-sticky pt-5 border-top vs-dialog-sticky-actions">
<button type="button" class="btn-solid theme-secondary flex-shrink-0" @onclick="HandleCancel">Cancel</button>
<button type="submit" class="btn-solid theme-primary flex-grow-1 sm:flex-grow-0" disabled="@IsSaving">
@if (IsSaving)
{
<span class="spinner-border spinner-sm me-1" role="status"></span>
}
@if (IsSaving && !string.IsNullOrEmpty(_cloneProgressMessage))
{
@_cloneProgressMessage
}
else
{
@_formState.GetSubmitButtonText(FormModel, IsSaving, IsEdit)
}
</button>
</div>
</EditForm>
</ChildContent>
</ModalDialog>

@if (_showDirectoryBrowser)
{
<DirectoryBrowser @ref="_directoryBrowser" InitialPath="@_defaultProjectsDirectory"
OnDirectorySelected="OnDirectorySelected" OnClosed="CloseDirectoryBrowser" />
}

@if (_showGitHubRepositoryBrowser)
{
<GitHubRepositoryBrowserModal IsVisible="@_showGitHubRepositoryBrowser"
IsVisibleChanged="HandleGitHubRepositoryBrowserVisibilityChanged"
SelectedRepository="@FormModel.GetNormalizedGitHubRepository()"
ExistingRepositories="@_existingGitHubRepositories"
OnRepositorySelected="HandleGitHubRepositorySelected" />
}

@code {
[Parameter]
public bool IsVisible { get; set; }

[Parameter]
public EventCallback<bool> IsVisibleChanged { get; set; }

[Parameter]
public Project? EditProject { get; set; }

[Parameter]
public EventCallback<Guid?> OnSaved { get; set; }

[Parameter]
public EventCallback OnCancelled { get; set; }

[Parameter]
public EventCallback OnClosed { get; set; }

/// <summary>A new project starts in this folder, such as one cloned from a folder's Add dialog.</summary>
[Parameter]
public Guid? InitialFolderId { get; set; }

/// <summary>Where a new project starts from; the user can still pick another source.</summary>
[Parameter]
public ProjectCreationMode InitialCreationMode { get; set; } = ProjectCreationMode.ExistingDirectory;

private bool IsEdit => EditProject != null;

/// <summary>A new project says which folder it lands in, so cloning from a folder reads as such.</summary>
private string DialogTitle => IsEdit
? "Edit Project"
: _folders.FirstOrDefault(folder => folder.Id == FormModel.FolderId)?.Name is { } folderName
	? $"New Project in {folderName}"
	: "New Project";

private bool IsSaving { get; set; }
private string? ErrorMessage { get; set; }
private bool _previousIsVisible;
private string? _cloneProgressMessage;
private bool _showDirectoryBrowser;
private bool _showGitHubRepositoryBrowser;
private bool _gitHubAccountsRequested;
private DirectoryBrowser? _directoryBrowser;
private string? _defaultProjectsDirectory;
private List<Provider> _availableProviders = [];
private readonly ProjectModalState _formState = new();
private Dictionary<string, string> _existingProjectPaths = new(StringComparer.OrdinalIgnoreCase);
private Dictionary<string, string> _existingGitHubRepositories = new(StringComparer.OrdinalIgnoreCase);
private string? _detectedStack;
private bool _openRepositoryOptions;
private bool _openAutomation;
private bool _openIdeas;
private bool _openInstructions;
private bool _openBuildVerification;

private bool _openLinks;
private List<ProjectFolder> _folders = [];
private List<Project> _allProjects = [];
private HashSet<Guid> _initialLinkedProjectIds = [];
private ProjectModalFormModel FormModel { get; set; } = new();
private List<Profile> _profiles = [];

// The team set in Settings: the profiles a project working as a team takes for its Lead and reviewer.
private Guid? _teamLeadProfileId;
private Guid? _teamReviewProfileId;

protected override async Task OnInitializedAsync()
{
await LoadDefaultProjectsDirectory();
await LoadProvidersAsync();
}

protected override async Task OnParametersSetAsync()
{
if (IsVisible && !_previousIsVisible)
{
await LoadProvidersAsync();
await LoadProfilesAsync();
ResetState();
await LoadExistingProjectPathsAsync();
await LoadFoldersAsync();

if (EditProject != null)
{
var editableProject = await ProjectService.GetByIdAsync(EditProject.Id) ?? EditProject;
FormModel = ProjectModalFormModel.FromProject(CloneProjectForEditing(editableProject));
_initialLinkedProjectIds = FormModel.LinkedProjectIds.ToHashSet();
_formState.LoadFromProject(FormModel);
}
else
{
FormModel = new ProjectModalFormModel { FolderId = InitialFolderId };
await SelectSourceMode(InitialCreationMode);
SeedBuildProfile();
}
}

_previousIsVisible = IsVisible;
}

private async Task LoadDefaultProjectsDirectory()
{
try
{
_defaultProjectsDirectory = await SettingsService.GetDefaultProjectsDirectoryAsync();
_formState.SetDefaultProjectsDirectory(_defaultProjectsDirectory);
}
catch
{
}
}

private void OnGitHubRepositoryChanged(string? repositoryInput)
{
_formState.UpdateGitHubRepositoryInput(FormModel, repositoryInput);
}

private async Task SelectSourceMode(ProjectCreationMode mode)
{
ErrorMessage = null;
_formState.SelectSourceMode(FormModel, mode);

// Loaded once per opening, and only for a new repository; the form stays usable meanwhile.
if (mode == ProjectCreationMode.CreateGitHubRepository && !_gitHubAccountsRequested)
{
_gitHubAccountsRequested = true;
await LoadGitHubAccountsAsync();
}
}

private async Task LoadGitHubAccountsAsync()
{
var formModel = FormModel;
_formState.IsLoadingGitHubAccounts = true;
GitHubAccountsResult accounts;
try
{
accounts = await ProjectService.GetGitHubAccountsAsync();
}
catch (Exception ex)
{
// Without accounts the owner picker stays hidden and owner/repo can still be typed.
accounts = new GitHubAccountsResult { ErrorMessage = ex.Message };
}

// The modal may have been closed or reopened while the GitHub CLI answered.
if (ReferenceEquals(formModel, FormModel))
{
_formState.SetGitHubAccounts(FormModel, accounts);
}
}

private async Task HandleValidSubmit()
{
IsSaving = true;
ErrorMessage = null;
_cloneProgressMessage = null;
var notificationProjectName = string.IsNullOrWhiteSpace(FormModel.Name) ? null : FormModel.Name.Trim();

try
{
Guid? newProjectId = null;

if (IsEdit)
{
await ProjectService.UpdateAsync(FormModel.ToProject());
if (!FormModel.LinkedProjectIds.SetEquals(_initialLinkedProjectIds))
{
await ProjectService.SetLinkedProjectsAsync(FormModel.Id, FormModel.LinkedProjectIds);
}
NotificationService.ShowProjectSuccess(notificationProjectName, "Project updated successfully.");
}
else
{
_cloneProgressMessage = _formState.GetProgressMessage(FormModel);
StateHasChanged();

var created = await ProjectService.CreateProjectAsync(_formState.BuildProjectCreationRequest(FormModel));
newProjectId = created.Id;
NotificationService.ShowProjectSuccess(notificationProjectName, _formState.GetSuccessMessage(FormModel));
if (FormModel.LinkedProjectIds.Count > 0)
{
// The project exists by now, so a failed link must not read as a failed create.
try
{
await ProjectService.SetLinkedProjectsAsync(created.Id, FormModel.LinkedProjectIds);
}
catch (Exception ex)
{
NotificationService.ShowError($"The project was created, but its links weren't saved: {ex.Message}");
}
}
}

await OnSaved.InvokeAsync(newProjectId);
await CloseModal();
}
catch (Exception ex)
{
ErrorMessage = $"Error saving project: {ex.Message}";
}
finally
{
IsSaving = false;
_cloneProgressMessage = null;
}
}

private async Task HandleCancel()
{
await OnCancelled.InvokeAsync();
await CloseModal();
}

private async Task HandleClose()
{
ResetState();
await OnClosed.InvokeAsync();
}

private async Task HandleModalVisibilityChanged(bool visible)
{
if (!visible)
{
ResetState();
await IsVisibleChanged.InvokeAsync(false);
}
}

private async Task CloseModal()
{
IsVisible = false;
await IsVisibleChanged.InvokeAsync(false);
ResetState();
}

	private void ResetState()
	{
		FormModel = new ProjectModalFormModel();
		_formState.Reset();
		_gitHubAccountsRequested = false;
		ErrorMessage = null;
		IsSaving = false;
		_detectedStack = null;
		_openRepositoryOptions = false;
		_openAutomation = false;
		_openIdeas = false;
		_openInstructions = false;
		_openBuildVerification = false;
		_openLinks = false;
		_initialLinkedProjectIds = [];
		_cloneProgressMessage = null;
		_showGitHubRepositoryBrowser = false;
	}

private async Task OpenDirectoryBrowser()
{
_showDirectoryBrowser = true;
StateHasChanged();

await Task.Delay(50);

if (_directoryBrowser != null)
{
var initialPath = !string.IsNullOrEmpty(FormModel.WorkingPath)
? FormModel.WorkingPath
: _defaultProjectsDirectory;
await _directoryBrowser.ShowAsync(initialPath);
}
}

private void OnDirectorySelected(string path)
{
FormModel.WorkingPath = path;
_showDirectoryBrowser = false;
StateHasChanged();
}

	private void CloseDirectoryBrowser()
	{
		_showDirectoryBrowser = false;
	}

	private Task OpenGitHubRepositoryBrowser()
	{
		_showGitHubRepositoryBrowser = true;
		return Task.CompletedTask;
	}

	private Task HandleGitHubRepositoryBrowserVisibilityChanged(bool visible)
	{
		_showGitHubRepositoryBrowser = visible;
		return Task.CompletedTask;
	}

	private Task HandleGitHubRepositorySelected(string repository)
	{
		OnGitHubRepositoryChanged(repository);
		_showGitHubRepositoryBrowser = false;
		return Task.CompletedTask;
	}

	private async Task LoadProvidersAsync()
	{
_availableProviders = (await ProviderService.GetAllAsync())
.Where(provider => provider.IsEnabled)
.OrderByDescending(provider => provider.IsDefault)
.ThenBy(provider => provider.Name)
.ToList();
	}

private Provider? ResolveProvider(Guid providerId)
{
return _availableProviders.FirstOrDefault(provider => provider.Id == providerId)
?? EditProject?.ProviderSelections.FirstOrDefault(selection => selection.ProviderId == providerId)?.Provider;
}

// Resolved lazily so components and tests that never show profiles need no registration.
private async Task LoadProfilesAsync()
{
var profileService = Services.GetService<IProfileService>();
if (profileService == null)
{
_profiles = [];
return;
}

try
{
_profiles = (await profileService.GetAllAsync()).ToList();
}
catch
{
_profiles = [];
}

// The team's profiles are only shown here; the server applies them when the project is saved.
try
{
var settings = await SettingsService.GetSettingsAsync();
_teamLeadProfileId = settings.TeamLeadProfileId;
_teamReviewProfileId = settings.TeamReviewProfileId;
}
catch
{
_teamLeadProfileId = null;
_teamReviewProfileId = null;
}
}

/// <summary>A new project builds with the default provider's own profile until another is picked.</summary>
private void SeedBuildProfile()
{
if (FormModel.ProviderSelections.Any()
	|| _profiles.FirstOrDefault(profile => profile.Id == ProjectExecutionDefaults.GetBuildProfileId(null, _profiles)) is not { ProviderId: Guid providerId } profile)
{
	return;
}

FormModel.ProviderSelections.Add(new ProjectProvider
{
	ProviderId = providerId,
	Provider = profile.Provider,
	ProfileId = profile.Id,
	PreferredModelId = profile.ModelId,
	PreferredReasoningEffort = profile.ReasoningEffort,
	Priority = 0,
	IsEnabled = true,
	CreatedAt = DateTime.UtcNow,
	UpdatedAt = DateTime.UtcNow
});
}

private Project CloneProjectForEditing(Project source)
{
return new Project
{
Id = source.Id,
Name = source.Name,
Description = source.Description,
WorkingPath = source.WorkingPath,
GitHubRepository = source.GitHubRepository,
AutoCommitMode = source.AutoCommitMode,
GitChangeDeliveryMode = source.GitChangeDeliveryMode,
DefaultTargetBranch = source.DefaultTargetBranch,
DevelopmentBranch = source.DevelopmentBranch,
ReleaseBranch = source.ReleaseBranch,
TeamEnabled = source.TeamEnabled,
TeamOverrides = source.TeamOverrides,
ReviewEnabled = source.ReviewEnabled,
ReviewProviderId = source.ReviewProviderId,
ReviewInferenceProviderId = source.ReviewInferenceProviderId,
ReviewModelId = source.ReviewModelId,
ReviewReasoningEffort = source.ReviewReasoningEffort,
ReviewProfileId = source.ReviewProfileId,
LeadProviderId = source.LeadProviderId,
LeadModelId = source.LeadModelId,
LeadReasoningEffort = source.LeadReasoningEffort,
LeadProfileId = source.LeadProfileId,
DecisionsProfileId = source.DecisionsProfileId,
ResearchProfileId = source.ResearchProfileId,
LeadDirection = source.LeadDirection,
PromptContext = source.PromptContext,
Memory = source.Memory,
BuildVerificationEnabled = source.BuildVerificationEnabled,
	BuildCommand = source.BuildCommand,
	TestCommand = source.TestCommand,
	IdeasProfileId = source.IdeasProfileId,
	CommitSummaryProfileId = source.CommitSummaryProfileId,
	IdeaInferenceProviderId = source.IdeaInferenceProviderId,
	IdeaInferenceModelId = source.IdeaInferenceModelId,
	CommitSummaryInferenceProviderId = source.CommitSummaryInferenceProviderId,
	CommitSummaryInferenceModelId = source.CommitSummaryInferenceModelId,
	IsActive = source.IsActive,
	FolderId = source.FolderId,
	Links = (source.Links ?? [])
	.Select(link => new ProjectLink
	{
		ProjectId = link.ProjectId,
		LinkedProjectId = link.LinkedProjectId,
		CreatedAt = link.CreatedAt
	})
	.ToList(),
CreatedAt = source.CreatedAt,
	UpdatedAt = source.UpdatedAt,
	ProviderSelections = source.ProviderSelections
.OrderBy(projectProvider => projectProvider.Priority)
.Select(projectProvider => new ProjectProvider
{
Id = projectProvider.Id,
ProjectId = projectProvider.ProjectId,
ProviderId = projectProvider.ProviderId,
	Priority = projectProvider.Priority,
	IsEnabled = projectProvider.IsEnabled,
	PreferredModelId = projectProvider.PreferredModelId,
	PreferredReasoningEffort = projectProvider.PreferredReasoningEffort,
	ProfileId = projectProvider.ProfileId,
	CreatedAt = projectProvider.CreatedAt,
UpdatedAt = projectProvider.UpdatedAt,
Provider = ResolveProvider(projectProvider.ProviderId)
	})
	.ToList(),
	Environments = (source.Environments ?? [])
.OrderBy(environment => environment.SortOrder)
.Select(environment => new ProjectEnvironment
{
Id = environment.Id,
ProjectId = environment.ProjectId,
Name = environment.Name,
Description = environment.Description,
Type = environment.Type,
Stage = environment.Stage,
Url = environment.Url,
IsPrimary = environment.IsPrimary,
IsEnabled = environment.IsEnabled,
SortOrder = environment.SortOrder,
Username = environment.Username,
Password = environment.Password,
ClearPassword = false,
UsernameCiphertext = environment.UsernameCiphertext,
PasswordCiphertext = environment.PasswordCiphertext,
CreatedAt = environment.CreatedAt,
UpdatedAt = environment.UpdatedAt
})
.ToList()
};
}

	private string AutoCommitSummary => FormModel.AutoCommitMode switch
	{
		AutoCommitMode.CommitAndPush => "Commit & push",
		AutoCommitMode.CommitOnly => "Commit",
		_ => "Manual"
	};

	private bool HasInstructions =>
		!string.IsNullOrWhiteSpace(FormModel.PromptContext) || !string.IsNullOrWhiteSpace(FormModel.Memory);

	private async Task LoadExistingProjectPathsAsync()
	{
		try
		{
			var projects = (await ProjectService.GetAllAsync()).ToList();
			_allProjects = projects;
			_existingProjectPaths = projects
				.Where(project => !string.IsNullOrWhiteSpace(project.WorkingPath) && project.Id != FormModel.Id)
				.GroupBy(project => project.WorkingPath.TrimEnd('/', '\\'), StringComparer.OrdinalIgnoreCase)
				.ToDictionary(group => group.Key, group => group.First().Name, StringComparer.OrdinalIgnoreCase);
			_existingGitHubRepositories = projects
				.Where(project => !string.IsNullOrWhiteSpace(project.GitHubRepository) && project.Id != FormModel.Id)
				.GroupBy(project => NormalizeExistingGitHubRepository(project.GitHubRepository!), StringComparer.OrdinalIgnoreCase)
				.ToDictionary(group => group.Key, group => group.First().Name, StringComparer.OrdinalIgnoreCase);
		}
		catch
		{
			_allProjects = [];
			_existingProjectPaths = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
			_existingGitHubRepositories = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
		}
	}

	/// <summary>Saved repositories are <c>owner/repo</c>; tolerate a stray <c>.git</c> or slash.</summary>
	private static string NormalizeExistingGitHubRepository(string repository)
	{
		var normalized = repository.Trim().Trim('/');
		return normalized.EndsWith(".git", StringComparison.OrdinalIgnoreCase) ? normalized[..^4] : normalized;
	}

	private async Task LoadFoldersAsync()
	{
		try
		{
			_folders = (await ProjectService.GetFoldersAsync()).ToList();
		}
		catch
		{
			_folders = [];
		}
	}

	private string? LinksSummary
	{
		get
		{
			var linkedCount = FormModel.LinkedProjectIds.Count;
			if (linkedCount > 0)
			{
				return $"{linkedCount} linked";
			}

			return _folders.FirstOrDefault(folder => folder.Id == FormModel.FolderId)?.Name;
		}
	}

	/// <summary>
	/// Applies everything VibeSwarm worked out about the chosen folder so the user does not
	/// have to retype it. Only blank or auto-filled fields are filled, so nothing typed is ever overwritten.
	/// </summary>
	private void HandleWorkspaceInspected(WorkspaceInspection inspection)
	{
		_detectedStack = inspection.DetectedStack;

		_formState.SuggestName(FormModel, inspection.SuggestedName);

		if (!string.IsNullOrWhiteSpace(inspection.GitHubRepository))
		{
			if (FormModel.CreationMode == ProjectCreationMode.ExistingDirectory &&
				string.IsNullOrWhiteSpace(FormModel.GitHubRepository))
			{
				FormModel.GitHubRepository = inspection.GitHubRepository;
			}

			if (string.IsNullOrWhiteSpace(FormModel.GitHubRepositoryInput))
			{
				FormModel.GitHubRepositoryInput = inspection.GitHubRepository;
			}
		}

		if (string.IsNullOrWhiteSpace(FormModel.BuildCommand) &&
			!string.IsNullOrWhiteSpace(inspection.SuggestedBuildCommand))
		{
			FormModel.BuildCommand = inspection.SuggestedBuildCommand;
		}

		if (string.IsNullOrWhiteSpace(FormModel.TestCommand) &&
			!string.IsNullOrWhiteSpace(inspection.SuggestedTestCommand))
		{
			FormModel.TestCommand = inspection.SuggestedTestCommand;
		}

		StateHasChanged();
	}


	/// <summary>
	/// A field that fails validation inside a collapsed section would otherwise be invisible,
	/// so open whichever sections can hold the problem before the summary is shown.
	/// </summary>
	private void HandleInvalidSubmit()
	{
		if (FormModel.BuildVerificationEnabled && string.IsNullOrWhiteSpace(FormModel.BuildCommand))
		{
			_openBuildVerification = true;
		}
	}

}
