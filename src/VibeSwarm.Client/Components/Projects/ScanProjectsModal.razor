@* Bulk-imports folders that are already on this host. The scan runs server side, so each
   candidate arrives knowing whether it is a git repository, where it points, and which
   stack it uses — and those answers are written straight into the imported project. *@
@using VibeSwarm.Shared.Services
@inject IFileSystemService FileSystemService
@inject IProjectService ProjectService
@inject ISettingsService SettingsService

<ModalDialog @bind-IsVisible="_isVisible" Title="Import projects" Icon="folder-symlink"
			 Size="ModalDialog.ModalSize.Large">
	<ChildContent>
		@if (_isLoading)
		{
			<LoadingSpinner Text="@($"Scanning {_scanPath}…")" />
		}
		else if (!string.IsNullOrEmpty(_errorMessage))
		{
			<Alert Type="Alert.AlertType.Danger" Message="@_errorMessage" Class="mb-0" />
		}
		else if (_candidates.Count == 0)
		{
			<EmptyState Icon="check-circle" Title="Nothing left to import"
						Message="Every folder in your projects directory is already a VibeSwarm project." />
		}
		else
		{
			<p class="text-body-secondary">
				@_candidates.Count folder@(_candidates.Count == 1 ? string.Empty : "s") in
				<code class="text-break">@_scanPath</code> are not projects yet.
			</p>

			<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
				<button type="button" class="btn btn-sm btn-secondary" @onclick="SelectAll">Select all</button>
				<button type="button" class="btn btn-sm btn-secondary" @onclick="SelectRepositories"
						disabled="@(!_candidates.Any(c => c.IsGitRepository))">
					Select git repositories
				</button>
				<button type="button" class="btn btn-sm btn-link" @onclick="ClearSelection"
						disabled="@(_selected.Count == 0)">
					Clear
				</button>
			</div>

			<div class="list-group">
				@foreach (var candidate in _candidates)
				{
					<label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
						<input type="checkbox" class="form-check-input flex-shrink-0 m-0"
							   checked="@_selected.Contains(candidate.Path)"
							   @onchange="@(e => ToggleSelection(candidate.Path, (bool)(e.Value ?? false)))" />
						<span class="d-flex flex-column min-width-0 flex-grow-1">
							<span class="d-flex align-items-center gap-2 min-width-0">
								<i class="bi bi-@(candidate.IsGitRepository ? "git" : "folder") text-body-secondary flex-shrink-0"></i>
								<span class="fw-medium text-truncate">@candidate.SuggestedName</span>
							</span>
							<span class="small text-body-secondary text-truncate">
								@(candidate.GitHubRepository ?? candidate.Path)
							</span>
						</span>
						@if (!string.IsNullOrWhiteSpace(candidate.DetectedStack))
						{
							<span class="badge text-bg-secondary flex-shrink-0 d-none d-sm-inline">@candidate.DetectedStack</span>
						}
					</label>
				}
			</div>

			@if (_importResults.Count > 0)
			{
				<div class="mt-3 d-flex flex-column gap-2">
					@foreach (var result in _importResults)
					{
						<Alert Type="@(result.Success ? Alert.AlertType.Success : Alert.AlertType.Danger)"
							   Message="@result.Message" Class="py-2 px-3 small mb-0" />
					}
				</div>
			}
		}
	</ChildContent>
	<FooterContent>
		<button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
		@if (_candidates.Count > 0)
		{
			<button type="button" class="btn btn-primary" disabled="@(_selected.Count == 0 || _isImporting)"
					@onclick="ImportSelected">
				@if (_isImporting)
				{
					<span class="spinner-border spinner-border-sm me-1" role="status"></span>
				}
				Import @(_selected.Count > 0 ? $"{_selected.Count} " : string.Empty)project@(_selected.Count == 1 ? string.Empty : "s")
			</button>
		}
	</FooterContent>
</ModalDialog>

@code {
	[Parameter]
	public EventCallback OnProjectsImported { get; set; }

	private bool _isVisible;
	private bool _isLoading;
	private bool _isImporting;
	private string? _errorMessage;
	private string _scanPath = string.Empty;
	private List<WorkspaceInspection> _candidates = [];
	private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
	private readonly List<ImportResult> _importResults = [];

	public async Task ShowAsync(string? projectsDirectory = null)
	{
		_isVisible = true;
		_errorMessage = null;
		_candidates.Clear();
		_selected.Clear();
		_importResults.Clear();
		StateHasChanged();

		await ScanAsync(projectsDirectory);
	}

	private async Task ScanAsync(string? projectsDirectory)
	{
		_isLoading = true;
		StateHasChanged();

		try
		{
			if (string.IsNullOrWhiteSpace(projectsDirectory))
			{
				var settings = await SettingsService.GetSettingsAsync();
				projectsDirectory = settings.DefaultProjectsDirectory;
			}

			if (string.IsNullOrWhiteSpace(projectsDirectory))
			{
				_errorMessage = "No projects directory configured yet. Set a default projects directory above first.";
				return;
			}

			_scanPath = projectsDirectory;

			var existingPaths = (await ProjectService.GetAllAsync())
				.Where(project => !string.IsNullOrWhiteSpace(project.WorkingPath))
				.Select(project => project.WorkingPath.TrimEnd('/', '\\'))
				.ToHashSet(StringComparer.OrdinalIgnoreCase);

			var scanned = await FileSystemService.ScanWorkspacesAsync(projectsDirectory);

			if (scanned.Count == 0 && !await FileSystemService.DirectoryExistsAsync(projectsDirectory))
			{
				_errorMessage = $"Directory does not exist: {projectsDirectory}";
				return;
			}

			// Git repositories first — they are the ones worth importing.
			_candidates = scanned
				.Where(candidate => !existingPaths.Contains(candidate.Path.TrimEnd('/', '\\')))
				.OrderByDescending(candidate => candidate.IsGitRepository)
				.ThenBy(candidate => candidate.SuggestedName, StringComparer.OrdinalIgnoreCase)
				.ToList();
		}
		catch (Exception ex)
		{
			_errorMessage = $"Error scanning directories: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private void ToggleSelection(string path, bool isChecked)
	{
		if (isChecked)
		{
			_selected.Add(path);
		}
		else
		{
			_selected.Remove(path);
		}
	}

	private void SelectAll()
	{
		foreach (var candidate in _candidates)
		{
			_selected.Add(candidate.Path);
		}
	}

	private void SelectRepositories()
	{
		_selected.Clear();
		foreach (var candidate in _candidates.Where(candidate => candidate.IsGitRepository))
		{
			_selected.Add(candidate.Path);
		}
	}

	private void ClearSelection() => _selected.Clear();

	private async Task ImportSelected()
	{
		if (_selected.Count == 0)
		{
			return;
		}

		_isImporting = true;
		_importResults.Clear();
		StateHasChanged();

		try
		{
			foreach (var candidate in _candidates.Where(c => _selected.Contains(c.Path)).ToList())
			{
				var name = candidate.SuggestedName ?? candidate.Path;
				try
				{
					await ProjectService.CreateAsync(new Project
					{
						Name = name,
						WorkingPath = candidate.Path,
						GitHubRepository = candidate.GitHubRepository,
						BuildCommand = candidate.SuggestedBuildCommand,
						TestCommand = candidate.SuggestedTestCommand
					});

					_importResults.Add(new ImportResult(true, $"Imported {name}."));
					_candidates.RemoveAll(c => c.Path == candidate.Path);
					_selected.Remove(candidate.Path);
				}
				catch (Exception ex)
				{
					_importResults.Add(new ImportResult(false, $"Could not import {name}: {ex.Message}"));
				}
			}

			if (_importResults.Any(result => result.Success))
			{
				await OnProjectsImported.InvokeAsync();
			}
		}
		finally
		{
			_isImporting = false;
			StateHasChanged();
		}
	}

	private void Close() => _isVisible = false;

	private sealed record ImportResult(bool Success, string Message);
}
