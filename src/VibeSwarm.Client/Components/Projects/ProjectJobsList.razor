@* Project jobs list: one line per job, with a second line only when something needs attention.
   Search and bulk actions stay folded away until the search icon or Select is tapped. *@

<SectionErrorBoundary SectionTitle="job list">
	<section class="d-flex flex-column gap-2" aria-label="Recent jobs">
		<div class="d-flex align-items-center gap-3 px-1">
			<h2 class="text-eyebrow mb-0 me-auto">@SectionTitle</h2>
			@if (IsPageLoading)
			{
				<span class="spinner-border spinner-border-sm text-body-secondary" role="status" aria-label="Refreshing jobs"></span>
			}
			<button type="button" class="btn btn-sm btn-link text-decoration-none px-0 @(IsSearchVisible ? "text-primary" : "text-body-secondary")"
					@onclick="ToggleSearch" title="Search and filter jobs" aria-label="Search jobs" aria-pressed="@IsSearchVisible.ToString().ToLowerInvariant()">
				<i class="bi bi-search"></i>
			</button>
			@if (VisibleJobs.Count > 0 || HasBulkActions)
			{
				<button type="button" class="btn btn-sm btn-link text-decoration-none px-0" @onclick="ToggleSelectMode">
					@(_isSelecting ? "Done" : "Select")
				</button>
			}
		</div>

		@if (IsSearchVisible)
		{
			<div class="input-group input-group-sm">
				<span class="input-group-text"><i class="bi bi-search"></i></span>
				<input type="search" class="form-control" placeholder="Search jobs…"
					   value="@SearchQuery"
					   @oninput="HandleSearchInput"
					   title="Filter jobs by name" />
				<select class="form-select flex-grow-0 w-auto"
						value="@StatusFilter"
						@onchange="HandleStatusFilterChange"
						title="Filter by status">
					<option value="all">All statuses</option>
					<option value="active">Active</option>
					<option value="completed">Completed</option>
					<option value="failed">Failed</option>
					<option value="cancelled">Cancelled</option>
				</select>
			</div>
		}

		@if (_isSelecting)
		{
			<div class="d-flex align-items-center gap-2 px-1">
				@if (VisibleJobs.Count > 0)
				{
					<div class="form-check mb-0 me-auto">
						<input id="@_selectAllCheckboxId" class="form-check-input" type="checkbox"
							   checked="@IsAllVisibleJobsSelected"
							   @onchange="HandleSelectAllChanged"
							   aria-label="Select all visible jobs" />
						<label class="form-check-label small" for="@_selectAllCheckboxId">
							@(SelectedJobsCount > 0 ? $"{SelectedJobsCount} selected" : "Select all")
						</label>
					</div>
				}
				<div class="dropdown ms-auto">
					<button type="button" class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown"
							aria-expanded="false" disabled="@IsAnyActionInProgress" title="Job actions">
						@if (IsAnyActionInProgress)
						{
							<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
						}
						Actions
					</button>
					<ul class="dropdown-menu dropdown-menu-end">
						<li>
							<button type="button" class="dropdown-item" @onclick="HandleRetrySelected"
									disabled="@(RetryableSelectedJobsCount == 0)"
									title="Retry selected failed, cancelled, or stopped jobs">
								<i class="bi bi-arrow-clockwise me-2"></i>Retry (@RetryableSelectedJobsCount)
							</button>
						</li>
						<li>
							<button type="button" class="dropdown-item" @onclick="HandlePrioritizeSelected"
									disabled="@(PrioritizableSelectedJobsCount == 0)"
									title="Move selected queued jobs to the front">
								<i class="bi bi-arrow-up-circle me-2"></i>Move to front (@PrioritizableSelectedJobsCount)
							</button>
						</li>
						<li>
							<button type="button" class="dropdown-item text-danger" @onclick="HandleCancelSelected"
									disabled="@(CancellableSelectedJobsCount == 0)"
									title="Cancel selected queued or active jobs">
								<i class="bi bi-x-octagon me-2"></i>Cancel (@CancellableSelectedJobsCount)
							</button>
						</li>
						<li>
							<button type="button" class="dropdown-item text-danger" @onclick="HandleDeleteSelected"
									disabled="@(DeletableSelectedJobsCount == 0)"
									title="Delete selected jobs that are not running">
								<i class="bi bi-trash me-2"></i>Delete (@DeletableSelectedJobsCount)
							</button>
						</li>
						@if (HasBulkActions)
						{
							<li><hr class="dropdown-divider"></li>
						}
						@if (HasActiveJobs)
						{
							<li>
								<button type="button" class="dropdown-item text-danger" @onclick="HandleCancelAll"
										title="Cancel all queued and active jobs">
									<i class="bi bi-x-octagon me-2"></i>Cancel all active jobs
								</button>
							</li>
						}
						@if (HasCompletedJobs)
						{
							<li>
								<button type="button" class="dropdown-item text-danger" @onclick="HandleDeleteCompleted"
										title="Delete completed jobs for this project">
									<i class="bi bi-trash me-2"></i>Delete all completed jobs
								</button>
							</li>
						}
					</ul>
				</div>
			</div>
		}

		@if (VisibleJobs.Count == 0)
		{
			@if (HasActiveFilters)
			{
				<EmptyState Icon="search" Title="No matching jobs"
							Message="No jobs match the current search or filter. Try clearing the filters." />
			}
			else if (Jobs.Count == 0)
			{
				<EmptyState Icon="list-check" Title="No jobs yet"
							Message="Add an idea above, or create a job from the + menu." />
			}
		}
		else
		{
			<div class="list-group rounded-4">
				@foreach (var job in VisibleJobs)
				{
					@if (_isSelecting)
					{
						<label class="list-group-item list-group-item-action d-flex align-items-center gap-3 cursor-pointer">
							<input class="form-check-input flex-shrink-0 m-0" type="checkbox"
								   checked="@IsJobSelected(job.Id)"
								   @onchange="e => HandleJobSelectionChanged(job.Id, e)"
								   aria-label="@($"Select job {job.DisplayTitle}")" />
							<span class="flex-grow-1 min-width-0 text-truncate">@job.DisplayTitle</span>
						</label>
					}
					else
					{
						<JobRow Job="@job" />
					}
				}
			</div>
		}

		<PaginationControls PageNumber="@CurrentPage" PageSize="@PageSize" TotalCount="@TotalJobsCount"
							IsLoading="@IsPageLoading" OnPreviousPage="OnPreviousPage" OnNextPage="OnNextPage" />
	</section>
</SectionErrorBoundary>

@code {
	[Parameter]
	public List<JobSummary> Jobs { get; set; } = new();

	[Parameter]
	public int TotalJobsCount { get; set; }

	[Parameter]
	public int CurrentPage { get; set; } = 1;

	[Parameter]
	public int PageSize { get; set; } = 10;

	[Parameter]
	public bool IsPageLoading { get; set; }

	[Parameter]
	public bool HasActiveJobs { get; set; }

	[Parameter]
	public bool HasCompletedJobs { get; set; }

	/// <summary>
	/// A job shown elsewhere on the page (the one running now), left out of the list so it isn't shown twice.
	/// </summary>
	[Parameter]
	public Guid? HiddenJobId { get; set; }

	[Parameter]
	public EventCallback<List<Guid>> OnDeleteSelected { get; set; }

	[Parameter]
	public EventCallback OnPreviousPage { get; set; }

	[Parameter]
	public EventCallback OnNextPage { get; set; }

	[Parameter]
	public EventCallback OnCancelAll { get; set; }

	[Parameter]
	public EventCallback OnDeleteCompleted { get; set; }

	[Parameter]
	public EventCallback<List<Guid>> OnRetrySelected { get; set; }

	[Parameter]
	public EventCallback<List<Guid>> OnCancelSelected { get; set; }

	[Parameter]
	public EventCallback<List<Guid>> OnPrioritizeSelected { get; set; }

	[Parameter]
	public string SearchQuery { get; set; } = string.Empty;

	[Parameter]
	public string StatusFilter { get; set; } = "all";

	[Parameter]
	public EventCallback<string> OnSearchChanged { get; set; }

	[Parameter]
	public EventCallback<string> OnStatusFilterChanged { get; set; }

	private bool _isSelecting;
	private bool _isSearchOpen;
	private bool _isActionInProgress;
	private readonly HashSet<Guid> _selectedJobIds = new();
	private readonly string _selectAllCheckboxId = $"project-jobs-select-all-{Guid.NewGuid():N}";

	private List<JobSummary> VisibleJobs => HiddenJobId is { } hiddenJobId
		? Jobs.Where(job => job.Id != hiddenJobId).ToList()
		: Jobs;

	private string SectionTitle => TotalJobsCount > 0 ? $"Jobs · {TotalJobsCount}" : "Jobs";
	private bool HasActiveFilters => !string.IsNullOrWhiteSpace(SearchQuery) || StatusFilter != "all";
	private bool IsSearchVisible => _isSearchOpen || HasActiveFilters;
	private bool HasBulkActions => HasActiveJobs || HasCompletedJobs;
	private bool IsAnyActionInProgress => _isActionInProgress;
	private int SelectedJobsCount => _selectedJobIds.Count;
	private bool IsAllVisibleJobsSelected => VisibleJobs.Count > 0 && VisibleJobs.All(job => _selectedJobIds.Contains(job.Id));
	private int RetryableSelectedJobsCount => GetSelectedJobIds(IsRetryable).Count;
	private int CancellableSelectedJobsCount => GetSelectedJobIds(IsCancellable).Count;
	private int PrioritizableSelectedJobsCount => GetSelectedJobIds(IsPrioritizable).Count;
	private int DeletableSelectedJobsCount => GetSelectedJobIds(IsDeletable).Count;

	protected override void OnParametersSet()
	{
		var visibleIds = VisibleJobs.Select(job => job.Id).ToHashSet();
		_selectedJobIds.IntersectWith(visibleIds);
	}

	private void ToggleSearch() => _isSearchOpen = !_isSearchOpen;

	private void ToggleSelectMode()
	{
		_isSelecting = !_isSelecting;
		_selectedJobIds.Clear();
	}

	private async Task HandleSearchInput(ChangeEventArgs e)
	{
		await OnSearchChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
	}

	private async Task HandleStatusFilterChange(ChangeEventArgs e)
	{
		await OnStatusFilterChanged.InvokeAsync(e.Value?.ToString() ?? "all");
	}

	private bool IsJobSelected(Guid jobId) => _selectedJobIds.Contains(jobId);

	private void HandleSelectAllChanged(ChangeEventArgs e)
	{
		if (e.Value as bool? == true)
		{
			foreach (var job in VisibleJobs)
			{
				_selectedJobIds.Add(job.Id);
			}
			return;
		}

		_selectedJobIds.Clear();
	}

	private void HandleJobSelectionChanged(Guid jobId, ChangeEventArgs e)
	{
		if (e.Value as bool? == true)
		{
			_selectedJobIds.Add(jobId);
			return;
		}

		_selectedJobIds.Remove(jobId);
	}

	private Task HandleCancelAll() => RunActionAsync(() => OnCancelAll.InvokeAsync());

	private Task HandleDeleteCompleted() => RunActionAsync(() => OnDeleteCompleted.InvokeAsync());

	private Task HandleRetrySelected() => RunSelectionActionAsync(IsRetryable, OnRetrySelected.InvokeAsync);

	private Task HandleCancelSelected() => RunSelectionActionAsync(IsCancellable, OnCancelSelected.InvokeAsync);

	private Task HandlePrioritizeSelected() => RunSelectionActionAsync(IsPrioritizable, OnPrioritizeSelected.InvokeAsync);

	private Task HandleDeleteSelected() => RunSelectionActionAsync(IsDeletable, OnDeleteSelected.InvokeAsync);

	private Task RunSelectionActionAsync(Func<JobStatus, bool> appliesTo, Func<List<Guid>, Task> action)
	{
		var selectedIds = GetSelectedJobIds(appliesTo);
		if (selectedIds.Count == 0)
		{
			return Task.CompletedTask;
		}

		return RunActionAsync(async () =>
		{
			await action(selectedIds);
			_selectedJobIds.Clear();
			_isSelecting = false;
		});
	}

	private async Task RunActionAsync(Func<Task> action)
	{
		_isActionInProgress = true;
		try
		{
			await action();
		}
		finally
		{
			_isActionInProgress = false;
		}
	}

	private List<Guid> GetSelectedJobIds(Func<JobStatus, bool> appliesTo)
	{
		return VisibleJobs
			.Where(job => _selectedJobIds.Contains(job.Id) && appliesTo(job.Status))
			.Select(job => job.Id)
			.ToList();
	}

	private static bool IsRetryable(JobStatus status)
	{
		return status is JobStatus.Failed or JobStatus.Cancelled or JobStatus.Stalled;
	}

	private static bool IsCancellable(JobStatus status)
	{
		return status is JobStatus.New or JobStatus.Pending or JobStatus.Started or JobStatus.Planning or JobStatus.Processing or JobStatus.Paused or JobStatus.Stalled;
	}

	private static bool IsPrioritizable(JobStatus status)
	{
		return status == JobStatus.New;
	}

	private static bool IsDeletable(JobStatus status)
	{
		return status is not (JobStatus.Started or JobStatus.Planning or JobStatus.Processing);
	}
}
