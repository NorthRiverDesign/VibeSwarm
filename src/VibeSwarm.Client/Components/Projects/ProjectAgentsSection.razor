
<div>
<div class="form-text mt-0 mb-5">
	Assign reusable agent presets so jobs on this project start from consistent specialists.
</div>

@if (!AvailableAgents.Any())
{
<Alert Type="Alert.AlertType.Warning" Class="py-3 px-5 small mb-0">
<span>No agents exist yet. Create them on the Agents page first.</span>
</Alert>
}
else if (!Profiles.Any(ProfileRoles.CanBuild))
{
<Alert Type="Alert.AlertType.Warning" Class="py-3 px-5 small mb-0">
<span>No profile can run an agent yet. Enable a provider first.</span>
</Alert>
}
else
{
<div>
@if (Project.AgentAssignments.Any())
{
<div class="form-label">Assigned agents</div>
<div class="d-grid gap-5 mb-5">
@foreach (var assignment in Project.AgentAssignments.OrderBy(assignment => ResolveAgent(assignment.AgentId)?.Name ?? string.Empty).ToList())
{
var agent = ResolveAgent(assignment.AgentId);
<div class="rounded border bg-body p-5">
<div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
<div class="min-w-0 flex-grow-1">
<div class="d-flex align-items-center gap-3 flex-wrap">
<span class="fw-semibold">@(agent?.Name ?? "Unknown Agent")</span>
@if (agent != null && !agent.IsEnabled)
{
<span class="badge badge-subtle theme-secondary">Disabled</span>
}
</div>
@if (!string.IsNullOrWhiteSpace(agent?.Description))
{
<div class="small fg-1 mt-1">@agent.Description</div>
}
@if (agent?.SkillLinks.Any(link => link.Skill != null) == true)
{
<div class="d-flex flex-wrap gap-1 mt-3">
@foreach (var skillLink in agent.SkillLinks.Where(link => link.Skill != null).Take(4))
{
<span class="badge badge-subtle theme-primary">@skillLink.Skill!.Name</span>
}
@if (agent.SkillLinks.Count > 4)
{
<span class="badge badge-subtle theme-secondary">+@(agent.SkillLinks.Count - 4)</span>
}
</div>
}
@if (agent != null && agent.DefaultCycleMode != CycleMode.SingleCycle)
{
<div class="d-flex flex-wrap gap-1 mt-3">
<span class="badge bg-1 fg-1 border" title="Cycle mode from agent defaults">
<i class="bi bi-arrow-repeat"></i>
@(agent.DefaultCycleMode == CycleMode.FixedCount
	? $"{agent.DefaultMaxCycles} fixed cycles"
	: $"autonomous up to {agent.DefaultMaxCycles} cycles")
</span>
</div>
}
</div>
<button type="button" class="btn-sm btn-solid theme-danger" @onclick="() => OnRemove.InvokeAsync(assignment.AgentId)" title="Remove agent">
<i class="bi bi-x-lg"></i>
</button>
</div>

<ProfilePicker Id="@($"team-profile-{assignment.AgentId}")" Class="mt-5" Label="Runs on" Profiles="Profiles" Allowed="ProfileRoles.CanBuild"
			   SelectedProfileId="assignment.ProfileId"
			   OnSelected="profile => OnProfileChanged.InvokeAsync((assignment.AgentId, profile))" />
</div>
}
</div>
}
else
{
<div class="small fg-1 fst-italic mb-5">No agents assigned yet.</div>
}

@if (Project.AgentAssignments.Count(a => a.IsEnabled) >= 2)
{
<div class="border-top pt-5 mt-5">
<div class="form-field">
<div class="switch">
	<InputCheckbox role="switch" switch id="modal-enableTeamSwarm" @bind-Value="Project.EnableTeamSwarm" />
</div>
<label for="modal-enableTeamSwarm">
Run every assigned agent on each job
</label>
</div>
<div class="form-text">Creating a job fans out into one job per assigned agent, each with its own system prompt. Agents on different providers work at the same time, each in its own copy of the repository, and each one's work is added to the branch as it finishes. Overlapping changes go to a merge job.</div>
</div>
}

<div class="form-label">Add an agent</div>
<div class="d-grid gap-3">
@foreach (var agent in AvailableAgents.OrderByDescending(role => role.IsEnabled).ThenBy(role => role.Name))
{
var isAssigned = IsAgentAssigned(agent.Id);
<button type="button" class="btn-outline theme-secondary d-flex justify-content-between gap-3 text-start flex-wrap py-3"
@onclick="() => OnAdd.InvokeAsync(agent)" disabled="@isAssigned">
<span class="text-start min-w-0">
										<span class="fw-semibold">@agent.Name</span>
										@if (!string.IsNullOrWhiteSpace(agent.Description))
										{
											<span class="fg-1 sm:ms-3 d-block sm:d-inline">@agent.Description</span>
										}
										@if (Profiles.FirstOrDefault(profile => profile.Id == agent.ProfileId) is { } agentProfile)
										{
											<span class="d-block small fg-1 mt-1"><i class="bi bi-person-badge me-1"></i>@agentProfile.Name</span>
										}
									</span>
									@if (isAssigned)
									{
<i class="bi bi-check-lg"></i>
}
else
{
<i class="bi bi-plus-lg"></i>
}
</button>
}
</div>
</div>
}
</div>

@code {
[Parameter, EditorRequired]
public ProjectModalFormModel Project { get; set; } = default!;

[Parameter]
public IReadOnlyList<Agent> AvailableAgents { get; set; } = [];

[Parameter, EditorRequired]
public Func<Guid, Agent?> ResolveAgent { get; set; } = _ => null;

[Parameter, EditorRequired]
public Func<Guid, bool> IsAgentAssigned { get; set; } = _ => false;

[Parameter]
public EventCallback<Guid> OnRemove { get; set; }

[Parameter]
public EventCallback<Agent> OnAdd { get; set; }

/// <summary>Every profile; an agent runs on one that can run jobs.</summary>
[Parameter]
public IReadOnlyList<Profile> Profiles { get; set; } = [];

/// <summary>Raised with the agent and the profile picked for it.</summary>
[Parameter]
public EventCallback<(Guid AgentId, Profile? Profile)> OnProfileChanged { get; set; }
}
