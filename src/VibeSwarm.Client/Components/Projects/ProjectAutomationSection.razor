@using VibeSwarm.Shared.Validation

<div class="mb-3">
	<label for="modal-autoCommitMode" class="form-label">Auto-commit</label>
	<InputSelect id="modal-autoCommitMode" @bind-Value="Project.AutoCommitMode" class="form-select">
		<option value="@AutoCommitMode.Off">Off — commit manually</option>
		<option value="@AutoCommitMode.CommitOnly">Commit after a job finishes</option>
		<option value="@AutoCommitMode.CommitAndPush">Commit and push after a job finishes</option>
	</InputSelect>
	<div class="form-text">Applies only when the job completes successfully.</div>
</div>

<div class="mb-3">
	<label for="modal-gitChangeDeliveryMode" class="form-label">Result delivery</label>
	<InputSelect id="modal-gitChangeDeliveryMode" @bind-Value="Project.GitChangeDeliveryMode" class="form-select">
		<option value="@GitChangeDeliveryMode.CommitToBranch">Commit to the working branch</option>
		<option value="@GitChangeDeliveryMode.PullRequest">Open a pull request</option>
	</InputSelect>
</div>

@if (Project.GitChangeDeliveryMode == GitChangeDeliveryMode.PullRequest)
{
	<div class="mb-3">
		<label for="modal-defaultTargetBranch" class="form-label">Default target branch</label>
		<InputText id="modal-defaultTargetBranch" @bind-Value="Project.DefaultTargetBranch" class="form-control"
				   placeholder="develop" maxlength="@ValidationLimits.ProjectDefaultTargetBranchMaxLength" />
		<ValidationMessage For="@(() => Project.DefaultTargetBranch)" class="text-danger small" />
		<div class="form-text">New jobs target this branch when opening pull requests or merging completed work.</div>
	</div>
}

<div class="mb-3">
	<label for="modal-commitSummaryInferenceProvider" class="form-label">Commit message writer</label>
	<InputSelect TValue="Guid?" id="modal-commitSummaryInferenceProvider"
				 @bind-Value="Project.CommitSummaryInferenceProviderId"
				 @bind-Value:after="HandleCommitSummaryProviderChanged" class="form-select">
		<option value="">Use the coding provider</option>
		@foreach (var provider in AvailableInferenceProviders)
		{
			<option value="@provider.Id">@provider.Name (@provider.ProviderType)</option>
		}
	</InputSelect>
	<div class="form-text">
		An inference provider can write a short commit message from the goal and the changed files.
	</div>
</div>

@if (Project.CommitSummaryInferenceProviderId.HasValue)
{
	<div class="mb-3">
		<label for="modal-commitSummaryInferenceModel" class="form-label">
			Commit message model <span class="text-body-secondary fw-normal">(optional)</span>
		</label>
		<InputSelect id="modal-commitSummaryInferenceModel" @bind-Value="Project.CommitSummaryInferenceModelId"
					 class="form-select" disabled="@(!InferenceModels.Any())">
			<option value="">Provider default</option>
			@foreach (var model in InferenceModels)
			{
				<option value="@model.ModelId">@(model.DisplayName ?? model.ModelId)</option>
			}
		</InputSelect>
		@if (!InferenceModels.Any())
		{
			<div class="form-text">No models cached yet — refresh models on the Inference page.</div>
		}
	</div>
}

@if (IsEdit)
{
	<hr class="my-3" />
	<div class="form-check form-switch">
		<InputCheckbox id="modal-isActive" @bind-Value="Project.IsActive" class="form-check-input" />
		<label class="form-check-label" for="modal-isActive">Project is active</label>
	</div>
	<div class="form-text">Inactive projects are hidden from the dashboard and de-emphasized elsewhere.</div>
}

@code {
	[Parameter, EditorRequired]
	public ProjectModalFormModel Project { get; set; } = default!;

	[Parameter]
	public IReadOnlyList<InferenceProvider> AvailableInferenceProviders { get; set; } = [];

	[Parameter]
	public IReadOnlyList<InferenceModel> InferenceModels { get; set; } = [];

	[Parameter]
	public EventCallback OnCommitSummaryProviderChanged { get; set; }

	[Parameter]
	public bool IsEdit { get; set; }

	private Task HandleCommitSummaryProviderChanged() => OnCommitSummaryProviderChanged.InvokeAsync();
}
