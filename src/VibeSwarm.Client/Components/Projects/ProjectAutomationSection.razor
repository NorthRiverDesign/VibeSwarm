@using VibeSwarm.Shared.Validation

<div class="mb-5">
	<label for="modal-developmentBranch" class="form-label">Development branch <span class="fg-1 fw-normal">(optional)</span></label>
	<InputText id="modal-developmentBranch" @bind-Value="Project.DevelopmentBranch" class="form-control"
			   placeholder="develop" maxlength="@ValidationLimits.ProjectBranchMaxLength" />
	<ValidationMessage For="@(() => Project.DevelopmentBranch)" class="fg-danger small" />
	<div class="form-text">Jobs work on this branch. Leave empty to use whichever branch is checked out.</div>
</div>

<div class="mb-5">
	<label for="modal-releaseBranch" class="form-label">Release branch <span class="fg-1 fw-normal">(optional)</span></label>
	<InputText id="modal-releaseBranch" @bind-Value="Project.ReleaseBranch" class="form-control"
			   placeholder="main" maxlength="@ValidationLimits.ProjectBranchMaxLength" />
	<ValidationMessage For="@(() => Project.ReleaseBranch)" class="fg-danger small" />
	<div class="form-text">The branch your CI/CD ships from. With both branches set, the project's Release tab deploys development into it when you're ready.</div>
</div>

<div class="mb-5">
	<label for="modal-autoCommitMode" class="form-label">Auto-commit</label>
	<InputSelect id="modal-autoCommitMode" @bind-Value="Project.AutoCommitMode" class="form-control">
		<option value="@AutoCommitMode.Off">Off — commit manually</option>
		<option value="@AutoCommitMode.CommitOnly">Commit after a job finishes</option>
		<option value="@AutoCommitMode.CommitAndPush">Commit and push after a job finishes</option>
	</InputSelect>
	<div class="form-text">Applies only when the job completes successfully.</div>
</div>

<div class="mb-5">
	<label for="modal-gitChangeDeliveryMode" class="form-label">Result delivery</label>
	<InputSelect id="modal-gitChangeDeliveryMode" @bind-Value="Project.GitChangeDeliveryMode" class="form-control">
		<option value="@GitChangeDeliveryMode.CommitToBranch">Commit to the working branch</option>
		<option value="@GitChangeDeliveryMode.PullRequest">Open a pull request</option>
	</InputSelect>
</div>

@if (Project.GitChangeDeliveryMode == GitChangeDeliveryMode.PullRequest)
{
	<div class="mb-5">
		<label for="modal-defaultTargetBranch" class="form-label">Default target branch</label>
		<InputText id="modal-defaultTargetBranch" @bind-Value="Project.DefaultTargetBranch" class="form-control"
				   placeholder="develop" maxlength="@ValidationLimits.ProjectDefaultTargetBranchMaxLength" />
		<ValidationMessage For="@(() => Project.DefaultTargetBranch)" class="fg-danger small" />
		<div class="form-text">New jobs target this branch when opening pull requests or merging completed work.</div>
	</div>
}

<ProfilePicker Id="modal-commitSummaryProfile" Class="mb-5" Label="Commit message writer" Profiles="Profiles" Allowed="ProjectInferenceRoles.CanAnswerAlone"
			   SelectedProfileId="Project.CommitSummaryProfileId" EmptyLabel="The coding provider"
			   OnSelected="profile => ProjectInferenceRoles.Apply(profile, (id, provider, model) => (Project.CommitSummaryProfileId, Project.CommitSummaryInferenceProviderId, Project.CommitSummaryInferenceModelId) = (id, provider, model))"
			   EmptyHint="An inference profile can write a short commit message from the goal and the changed files." />
@if (IsEdit)
{
	<hr class="my-5" />
	<div class="form-field">
		<div class="switch">
			<InputCheckbox role="switch" switch id="modal-isActive" @bind-Value="Project.IsActive" />
		</div>
		<label for="modal-isActive">Project is active</label>
	</div>
	<div class="form-text">Inactive projects are hidden from the dashboard and de-emphasized elsewhere.</div>
}

@code {
	[Parameter, EditorRequired]
	public ProjectModalFormModel Project { get; set; } = default!;

	/// <summary>Every profile; the commit message writer takes an inference one.</summary>
	[Parameter]
	public IReadOnlyList<Profile> Profiles { get; set; } = [];

	[Parameter]
	public bool IsEdit { get; set; }

}
