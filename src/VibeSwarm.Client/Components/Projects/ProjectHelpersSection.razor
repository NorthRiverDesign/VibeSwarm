@using VibeSwarm.Shared.Validation
@* The profiles a running job can ask for help: Decisions for a second opinion, Research for
   facts. A Claude or Copilot profile reads the repository; an inference profile, such as Grok,
   sees only the question. *@

@if (Project != null)
{
	<div class="form-text mt-0 mb-5">
		While a job runs, its agent can ask these profiles questions with a <code>vibeswarm-ask</code> command, so a large
		model can run the job and lean on others for decisions and research. Each run can ask @ValidationLimits.JobHelperQuestionsPerRun questions.
	</div>

	@if (EligibleProfiles.Count == 0)
	{
		<div class="small fg-1">No profile can help yet. Helpers need a Claude, Copilot or inference profile on an enabled provider.</div>
	}
	else
	{
		<ProfilePicker Id="modal-decisionsProfile" Class="mb-5" Label="Decisions" CustomLabel="None"
					   Profiles="EligibleProfiles" SelectedProfileId="Project.DecisionsProfileId"
					   LinkedNote="@DescribeAccess(Project.DecisionsProfileId)"
					   CustomHint="A second opinion before a design or approach decision."
					   OnSelected="profile => Project.DecisionsProfileId = profile?.Id" />

		<ProfilePicker Id="modal-researchProfile" Label="Research" CustomLabel="None"
					   Profiles="EligibleProfiles" SelectedProfileId="Project.ResearchProfileId"
					   LinkedNote="@DescribeAccess(Project.ResearchProfileId)"
					   CustomHint="Research: libraries, APIs, current facts and how others solve a problem."
					   OnSelected="profile => Project.ResearchProfileId = profile?.Id" />
	}
}

@code {
	[Parameter, EditorRequired]
	public ProjectModalFormModel Project { get; set; } = default!;

	[Parameter]
	public IReadOnlyList<Profile> Profiles { get; set; } = [];

	/// <summary>Enabled Claude and Copilot providers, which can answer read-only.</summary>
	[Parameter]
	public IReadOnlyList<Provider> ReadOnlyProviders { get; set; } = [];

	[Parameter]
	public IReadOnlyList<InferenceProvider> InferenceProviders { get; set; } = [];

	private IReadOnlyList<Profile> EligibleProfiles => Profiles
		.Where(profile => (profile.ProviderId is Guid providerId && ReadOnlyProviders.Any(provider => provider.Id == providerId))
			|| (profile.InferenceProviderId is Guid inferenceId && InferenceProviders.Any(provider => provider.Id == inferenceId)))
		.ToList();

	private string DescribeAccess(Guid? profileId)
		=> EligibleProfiles.FirstOrDefault(profile => profile.Id == profileId)?.InferenceProviderId.HasValue == true
			? "It sees only the question, not the code."
			: "It reads the code but can't change it.";
}
