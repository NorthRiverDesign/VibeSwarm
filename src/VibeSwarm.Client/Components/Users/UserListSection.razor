@* Users as grouped lists: the people who can sign in, then any switched-off accounts. *@

@if (Users.Count == 0)
{
	<EmptyState Icon="people" Title="No users found" Message="Add users to allow access to VibeSwarm." />
}
else
{
	<div class="d-flex flex-column gap-4">
		@foreach (var (heading, users) in GetGroups())
		{
			<section class="d-flex flex-column gap-2" aria-label="@heading">
				<h2 class="text-eyebrow mb-0 px-1">@heading</h2>
				<div class="list-group rounded-4">
					@foreach (var user in users)
					{
						<UserRow @key="user.Id"
								 User="user"
								 CurrentUserId="CurrentUserId"
								 OnResetPassword="OnResetPassword"
								 OnEditRole="OnEditRole"
								 OnToggleActive="OnToggleActive"
								 OnDelete="OnDelete" />
					}
				</div>
			</section>
		}
	</div>
}

@code {
	[Parameter]
	public IReadOnlyList<UserDto> Users { get; set; } = [];

	[Parameter]
	public Guid CurrentUserId { get; set; }

	[Parameter]
	public EventCallback<UserDto> OnResetPassword { get; set; }

	[Parameter]
	public EventCallback<UserDto> OnEditRole { get; set; }

	[Parameter]
	public EventCallback<UserDto> OnToggleActive { get; set; }

	[Parameter]
	public EventCallback<UserDto> OnDelete { get; set; }

	private IEnumerable<(string Heading, List<UserDto> Users)> GetGroups()
	{
		var active = Users.Where(user => user.IsActive).OrderBy(user => user.UserName, StringComparer.OrdinalIgnoreCase).ToList();
		var inactive = Users.Where(user => !user.IsActive).OrderBy(user => user.UserName, StringComparer.OrdinalIgnoreCase).ToList();

		if (active.Count > 0)
		{
			yield return ("Can sign in", active);
		}

		if (inactive.Count > 0)
		{
			yield return ("Switched off", inactive);
		}
	}
}
