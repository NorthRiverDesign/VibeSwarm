@* Uncommitted changes management modal component *@
@using System.Net

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="HandleModalVisibilityChanged" Title="Uncommitted Changes"
             Icon="file-diff" Size="ModalDialog.ModalSize.ExtraLarge" OnClose="HandleClose">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="d-flex align-items-center justify-content-center gap-3 py-12 fg-1">
                <span class="spinner-border spinner-sm" role="status"></span>
                <span>Loading changes...</span>
            </div>
        }
        else if (DiffFiles != null && DiffFiles.Any())
        {
            @* Pending Jobs Section - Show completed jobs that may have contributed to these changes *@
            @if (PendingJobs != null && PendingJobs.Any())
            {
                <div class="alert theme-info py-3 mb-5">
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <i class="bi bi-info-circle"></i>
                            <strong>@PendingJobs.Count completed job(s) may have contributed to these changes</strong>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var job in PendingJobs.Take(5))
                            {
                                <span class="badge badge-subtle theme-success border border-subtle-success">
                                    <i class="bi bi-check-circle"></i>@TruncateTitle(job.Title ?? job.GoalPrompt, 40)
                                </span>
                            }
                            @if (PendingJobs.Count > 5)
                            {
                                <span class="badge badge-subtle theme-secondary">
                                    +@(PendingJobs.Count - 5) more
                                </span>
                            }
                        </div>
                        <div class="mt-3 small fg-1">
                            <i class="bi bi-lightbulb me-1"></i>Committing will link this commit to these jobs.
                        </div>
                    </div>
                </div>
            }

            @* Diff Viewer Section *@
            <div class="mb-5">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="fg-1 small">
                        <i class="bi bi-files me-1"></i>
                        @DiffFiles.Count file(s) modified
                        <span class="ms-3">
                            <span class="fg-success">+@DiffFiles.Sum(f => f.Additions)</span>
                            <span class="fg-danger ms-1">-@DiffFiles.Sum(f => f.Deletions)</span>
                        </span>
                    </span>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn-solid theme-secondary" @onclick="ExpandAll" title="Expand all"
                                disabled="@AllExpanded">
                            <i class="bi bi-arrows-expand"></i>
                        </button>
                        <button type="button" class="btn-solid theme-secondary" @onclick="CollapseAll" title="Collapse all"
                                disabled="@AllCollapsed">
                            <i class="bi bi-arrows-collapse"></i>
                        </button>
                    </div>
                </div>

                <div class="accordion border rounded overflow-y-auto" id="uncommittedChangesAccordion"
                     style="max-height: min(350px, 40vh);">
                    @foreach (var (file, index) in DiffFiles.Select((f, i) => (f, i)))
                    {
                        var isExpanded = _expandedItems.Contains(index);

                        <details class="accordion-item" open="@isExpanded">
              <summary class="accordion-header py-3 px-5" " : "collapsed") py-3 px-5" @onclick="() => ToggleExpanded(index)" @onclick:preventDefault="true">
                                <span class="d-flex align-items-center gap-3 w-100">
                                    @if (file.IsNew)
                                    {
                                        <i class="bi bi-file-earmark-plus fg-success" title="New file"></i>
                                    }
                                    else if (file.IsDeleted)
                                    {
                                        <i class="bi bi-file-earmark-minus fg-danger" title="Deleted file"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-diff fg-warning" title="Modified file"></i>
                                    }
                                    <span class="font-monospace small text-truncate flex-grow-1">@file.FileName</span>
                                    <span class="small">
                                        @if (file.Additions > 0)
                                        {
                                            <span class="fg-success fw-medium">+@file.Additions</span>
                                        }
                                        @if (file.Deletions > 0)
                                        {
                                            <span class="fg-danger fw-medium ms-1">-@file.Deletions</span>
                                        }
                                    </span>
                                </span>
                                <AccordionIcon />
                            </summary>
                            <div class="accordion-body p-0">
                                @if (!file.IsDeleted)
                                {
                                    <div class="terminal-output overscroll-contain white-space-pre-wrap overflow-auto p-3 small" style="max-height: 300px;">
                                        @((MarkupString)FormatDiff(file.DiffContent))
                                    </div>
                                }
                                else
                                {
                                    <div class="p-5 fg-1 small">
                                        <i class="bi bi-trash me-1"></i>File deleted
                                    </div>
                                }
                            </div>
                        </details>
                    }
                </div>
            </div>

            <hr class="my-5" />

            @* Commit Section *@
            <div class="mb-5">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <label for="uncommittedCommitMessage" class="form-label fw-medium mb-0">
                        <i class="bi bi-chat-square-text me-1"></i>Commit Message
                    </label>
                    @if (PendingJobs != null && PendingJobs.Any() && string.IsNullOrWhiteSpace(_commitMessage))
                    {
                        <button type="button" class="btn-sm btn-solid theme-primary" @onclick="GenerateCommitMessage"
                                title="Generate commit message from job summaries">
                            <i class="bi bi-magic"></i>Generate
                        </button>
                    }
                </div>
                <textarea class="form-control font-monospace" id="uncommittedCommitMessage" @bind="_commitMessage"
                          @bind:event="oninput" rows="5" placeholder="Enter commit message..."
                          disabled="@IsCommitting"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <Alert Type="Alert.AlertType.Danger" Class="py-3">@ErrorMessage</Alert>
            }

            @if (!string.IsNullOrEmpty(CommitError))
            {
                <div class="alert theme-danger py-3 align-items-center justify-content-between">
                    <div class="min-w-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>@CommitError
                    </div>
                    @if (ShowPushRetry)
                    {
                        <button type="button" class="btn-sm btn-solid theme-danger flex-shrink-0" @onclick="HandleRetryPush"
                                disabled="@IsCommitting">
                            <i class="bi bi-arrow-repeat"></i>Retry Push
                        </button>
                    }
                </div>
            }

            @* Discard Confirmation *@
            @if (ShowDiscardConfirmation)
            {
                <div class="alert theme-warning py-5">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div>
                            <i class="bi bi-exclamation-triangle me-3"></i>
                            <strong>Are you sure?</strong> This will permanently discard all uncommitted changes.
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn-solid theme-secondary btn-sm" @onclick="HandleCancelDiscard">
                                Cancel
                            </button>
                            <button type="button" class="btn-solid theme-danger btn-sm" @onclick="HandleConfirmDiscard"
                                    disabled="@IsDiscarding">
                                @if (IsDiscarding)
                                {
                                    <span class="spinner-border spinner-sm me-1" role="status"></span>
                                }
                                Yes, Discard All
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <EmptyState Icon="check-circle" Title="No uncommitted changes" Message="Your working directory is clean." />
        }
    </ChildContent>
    <FooterContent>
        @if (DiffFiles != null && DiffFiles.Any() && !ShowDiscardConfirmation)
        {
            <div class="d-flex flex-column sm:flex-row justify-content-between w-100 gap-3">
                <button type="button" class="btn-solid theme-danger" @onclick="HandleShowDiscard"
                        disabled="@(IsCommitting || IsDiscarding)">
                    <i class="bi bi-trash"></i>
                    <span>Discard All</span>
                </button>
                <div class="d-flex gap-3">
                    <button type="button" class="btn-solid theme-secondary" @onclick="HandleClose"
                            disabled="@(IsCommitting || IsDiscarding)">
                        Close
                    </button>
                    <button type="button" class="btn-solid theme-secondary" @onclick="HandleCommitOnly"
                            disabled="@(IsCommitting || IsDiscarding || string.IsNullOrWhiteSpace(_commitMessage))">
                        @if (IsCommitting && _isCommitOnly)
                        {
                            <span class="spinner-border spinner-sm me-1" role="status"></span>
                            <span>Committing...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                            <span>Commit</span>
                        }
                    </button>
                    <button type="button" class="btn-solid theme-primary" @onclick="HandleCommitAndPush"
                            disabled="@(IsCommitting || IsDiscarding || string.IsNullOrWhiteSpace(_commitMessage))">
                        @if (IsCommitting && !_isCommitOnly)
                        {
                            <span class="spinner-border spinner-sm me-1" role="status"></span>
                            <span>@(string.IsNullOrEmpty(CommitProgress) ? "Committing..." : CommitProgress)</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-arrow-up"></i>
                            <span>Commit & Push</span>
                        }
                    </button>
                </div>
            </div>
        }
        else if (!ShowDiscardConfirmation)
        {
            <button type="button" class="btn-solid theme-secondary" @onclick="HandleClose">
                Close
            </button>
        }
    </FooterContent>
</ModalDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public List<DiffFile>? DiffFiles { get; set; }

    [Parameter]
    public List<Job>? PendingJobs { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsCommitting { get; set; }

    [Parameter]
    public bool IsDiscarding { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? CommitError { get; set; }

    [Parameter]
    public string? CommitProgress { get; set; }

    [Parameter]
    public bool ShowPushRetry { get; set; }

    [Parameter]
    public EventCallback OnRetryPush { get; set; }

    [Parameter]
    public bool ShowDiscardConfirmation { get; set; }

    [Parameter]
    public EventCallback<string> OnCommitAndPush { get; set; }

    [Parameter]
    public EventCallback<string> OnCommitOnly { get; set; }

    [Parameter]
    public EventCallback OnShowDiscard { get; set; }

    [Parameter]
    public EventCallback OnConfirmDiscard { get; set; }

    [Parameter]
    public EventCallback OnCancelDiscard { get; set; }

    private string _commitMessage = string.Empty;
    private HashSet<int> _expandedItems = new();
    private bool _isCommitOnly;

    private static string TruncateTitle(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "Unnamed Job";
        return text.Length <= maxLength ? text : text[..(maxLength - 3)] + "...";
    }

    private void GenerateCommitMessage()
    {
        if (PendingJobs == null || !PendingJobs.Any()) return;

        var sb = new System.Text.StringBuilder();

        if (PendingJobs.Count == 1)
        {
            var job = PendingJobs[0];
            sb.AppendLine(job.Title ?? "Feature implementation");
            sb.AppendLine();
            sb.AppendLine($"Job #{job.Id}: {TruncateTitle(job.GoalPrompt, 60)}");
        }
        else
        {
            sb.AppendLine($"Implement {PendingJobs.Count} features");
            sb.AppendLine();
            foreach (var job in PendingJobs.Take(10))
            {
                sb.AppendLine($"- Job #{job.Id}: {TruncateTitle(job.Title ?? job.GoalPrompt, 50)}");
            }
            if (PendingJobs.Count > 10)
            {
                sb.AppendLine($"- ... and {PendingJobs.Count - 10} more");
            }
        }

        _commitMessage = sb.ToString().TrimEnd();
    }

    private bool AllExpanded => DiffFiles?.Count > 0 && _expandedItems.Count == DiffFiles.Count;
    private bool AllCollapsed => DiffFiles == null || DiffFiles.Count == 0 || _expandedItems.Count == 0;

    private void ToggleExpanded(int index)
    {
        if (!_expandedItems.Add(index))
        {
            _expandedItems.Remove(index);
        }
    }

    private void ExpandAll()
    {
        if (DiffFiles != null)
        {
            _expandedItems = Enumerable.Range(0, DiffFiles.Count).ToHashSet();
        }
    }

    private void CollapseAll()
    {
        _expandedItems.Clear();
    }

    private async Task HandleCommitOnly()
    {
        if (!string.IsNullOrWhiteSpace(_commitMessage))
        {
            _isCommitOnly = true;
            await OnCommitOnly.InvokeAsync(_commitMessage);
            _commitMessage = string.Empty;
            _isCommitOnly = false;
        }
    }

    private async Task HandleCommitAndPush()
    {
        if (!string.IsNullOrWhiteSpace(_commitMessage))
        {
            _isCommitOnly = false;
            await OnCommitAndPush.InvokeAsync(_commitMessage);
            _commitMessage = string.Empty;
        }
    }

    private async Task HandleShowDiscard()
    {
        await OnShowDiscard.InvokeAsync();
    }

    private async Task HandleConfirmDiscard()
    {
        await OnConfirmDiscard.InvokeAsync();
    }

    private async Task HandleCancelDiscard()
    {
        await OnCancelDiscard.InvokeAsync();
    }

    private async Task HandleRetryPush()
    {
        await OnRetryPush.InvokeAsync();
    }

    private async Task HandleClose()
    {
        _commitMessage = string.Empty;
        _expandedItems.Clear();
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task HandleModalVisibilityChanged(bool visible)
    {
        if (!visible)
        {
            _commitMessage = string.Empty;
            _expandedItems.Clear();
            await IsVisibleChanged.InvokeAsync(false);
        }
    }

    private static MarkupString FormatDiff(string diffContent)
    {
        if (string.IsNullOrWhiteSpace(diffContent))
            return new MarkupString("<span class=\"fg-1\">No changes</span>");

        var lines = diffContent.Split('\n');
        var formattedLines = new System.Text.StringBuilder();
        formattedLines.Append("<div class=\"diff-content font-monospace small\">");

        foreach (var line in lines)
        {
            var escapedLine = WebUtility.HtmlEncode(line);

            if (line.StartsWith("@@"))
            {
                formattedLines.Append($"<div class=\"diff-hunk fg-info bg-black bg-50 px-3\">{escapedLine}</div>");
            }
            else if (line.StartsWith("+") && !line.StartsWith("+++"))
            {
                formattedLines.Append($"<div class=\"diff-add fg-success bg-success bg-10 px-3\">{escapedLine}</div>");
            }
            else if (line.StartsWith("-") && !line.StartsWith("---"))
            {
                formattedLines.Append($"<div class=\"diff-del fg-danger bg-danger bg-10 px-3\">{escapedLine}</div>");
            }
            else if (line.StartsWith("index ") || line.StartsWith("--- ") || line.StartsWith("+++ "))
            {
                formattedLines.Append($"<div class=\"diff-meta fg-secondary px-3\">{escapedLine}</div>");
            }
            else
            {
                formattedLines.Append($"<div class=\"diff-context px-3\">{escapedLine}</div>");
            }
        }

        formattedLines.Append("</div>");
        return new MarkupString(formattedLines.ToString());
    }
}
