@* Uncommitted changes card for failed/cancelled jobs that may have made partial changes *@

<div class="card mb-5 lg:mb-7 @(HasChanges ? "border-warning" : "")">
	<div class="card-header @(HasChanges ? "bg-warning bg-30" : "bg-1")">
		<div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
			<div class="d-flex align-items-center gap-3">
				<i class="bi bi-folder-symlink me-1 opacity-75"></i>
				<strong>Working Directory Changes</strong>
				@if (HasChanges && DiffFiles.Count > 0)
				{
					<span class="badge theme-warning">@DiffFiles.Count file(s)</span>
				}
			</div>
			@if (!IsChecking)
			{
				<button class="btn-sm btn-solid theme-secondary" @onclick="OnRefresh"
					title="Check for changes in working directory">
					<i class="bi bi-arrow-repeat"></i>
					<span class="d-none sm:d-inline">Refresh</span>
				</button>
			}
		</div>
	</div>
	<div class="card-body">
		@if (IsChecking)
		{
			<div class="d-flex align-items-center justify-content-center gap-3 py-7 fg-1">
				<span class="spinner-border spinner-sm" role="status"></span>
				<span>Checking for uncommitted changes...</span>
			</div>
		}
		else if (!string.IsNullOrEmpty(ErrorMessage))
		{
			<Alert Type="Alert.AlertType.Danger" Class="mb-0">@ErrorMessage</Alert>
		}
		else if (!HasChecked)
		{
			<div class="text-center py-5">
				<p class="fg-1 mb-5">
					<i class="bi bi-exclamation-circle me-3"></i>
					This job @(JobFailed ? "failed" : "was cancelled") but the CLI agent may have made changes to the
					working directory.
				</p>
				<button class="btn-solid theme-primary" @onclick="OnCheck">
					<i class="bi bi-search"></i>Check for Changes
				</button>
			</div>
		}
		else if (!HasChanges)
		{
			<div class="text-center py-5 fg-1">
				<i class="bi bi-check-circle me-3 fg-success"></i>
				No uncommitted changes found in the working directory.
			</div>
		}
		else
		{
			@* Show uncommitted changes with options to commit or discard *@
			<div class="alert theme-warning mb-5">
				<i class="bi flex-shrink-0 bi-exclamation-triangle"></i>
				<div class="flex-grow-1 min-w-0">
					<strong>Uncommitted changes detected!</strong>
					<span class="d-block sm:d-inline mt-1 sm:mt-0 sm:ms-1">
						The CLI agent made changes before the job @(JobFailed ? "failed" : "was cancelled").
					</span>
				</div>
			</div>

			@* Diff viewer for uncommitted changes *@
			<div class="mb-5">
				<div class="d-flex align-items-center justify-content-between mb-3">
					<span class="fg-1 small">
						<span class="fg-success">+@GitDiffParser.TotalAdditions(DiffFiles)</span>
						<span class="fg-danger ms-1">-@GitDiffParser.TotalDeletions(DiffFiles)</span>
					</span>
					<div class="btn-group btn-group-sm">
						<button type="button" class="btn-solid theme-secondary" @onclick="ExpandAll" title="Expand all"
							disabled="@(_expandedFiles.Count == DiffFiles.Count)">
							<i class="bi bi-arrows-expand"></i>
						</button>
						<button type="button" class="btn-solid theme-secondary" @onclick="CollapseAll" title="Collapse all"
							disabled="@(_expandedFiles.Count == 0)">
							<i class="bi bi-arrows-collapse"></i>
						</button>
					</div>
				</div>

				<div class="accordion border rounded overflow-y-auto" style="max-height: 350px;">
					@foreach (var (file, index) in DiffFiles.Select((f, i) => (f, i)))
					{
						var isExpanded = _expandedFiles.Contains(index);
						<details class="accordion-item" open="@isExpanded">
							<summary class="accordion-header py-3 px-5" @onclick="() => ToggleFile(index)" @onclick:preventDefault="true">
								<span class="d-flex align-items-center gap-3 w-100">
									@if (file.IsNew)
									{
										<i class="bi bi-file-earmark-plus fg-success" title="New file"></i>
									}
									else if (file.IsDeleted)
									{
										<i class="bi bi-file-earmark-minus fg-danger" title="Deleted file"></i>
									}
									else
									{
										<i class="bi bi-file-earmark-diff fg-warning" title="Modified file"></i>
									}
									<span class="font-monospace small text-truncate flex-grow-1">@file.FileName</span>
									<span class="small">
										@if (file.Additions > 0)
										{
											<span class="fg-success fw-medium">+@file.Additions</span>
										}
										@if (file.Deletions > 0)
										{
											<span class="fg-danger fw-medium ms-1">-@file.Deletions</span>
										}
									</span>
								</span>
								<AccordionIcon />
							</summary>
							<div class="accordion-body p-0">
								@if (!file.IsDeleted)
								{
									<div class="terminal-output overscroll-contain white-space-pre-wrap overflow-auto p-3 small" style="max-height: 250px;">
										@((MarkupString)GitDiffParser.FormatDiffHtml(file.DiffContent))
									</div>
								}
								else
								{
									<div class="p-5 fg-1 small">
										<i class="bi bi-trash me-1"></i>File deleted
									</div>
								}
							</div>
						</details>
					}
				</div>
			</div>

			<hr class="my-5" />

			@* Commit section for uncommitted changes *@
			<div class="mb-5">
				<label for="uncommittedCommitMsg" class="form-label fw-medium small">
					<i class="bi bi-chat-square-text me-1"></i>Commit Message (to keep changes)
				</label>
				<textarea class="form-control font-monospace" id="uncommittedCommitMsg" @bind="CommitMessage"
					@bind:event="oninput" rows="4" placeholder="Enter commit message to keep these changes..."
					disabled="@(IsCommitting || IsDiscarding)"></textarea>
			</div>

			@* Discard confirmation *@
			@if (_showDiscardConfirmation)
			{
				<div class="alert theme-danger py-5 mb-5">
					<div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
						<div>
							<i class="bi bi-exclamation-triangle me-3"></i>
							<strong>Are you sure?</strong> This will permanently discard all uncommitted changes.
						</div>
						<div class="d-flex gap-3">
							<button type="button" class="btn-solid theme-secondary btn-sm"
								@onclick="() => _showDiscardConfirmation = false" disabled="@IsDiscarding">
								Cancel
							</button>
							<button type="button" class="btn-solid theme-danger btn-sm" @onclick="ConfirmDiscard"
								disabled="@IsDiscarding">
								@if (IsDiscarding)
								{
									<span class="spinner-border spinner-sm me-1" role="status"></span>
								}
								Yes, Discard All
							</button>
						</div>
					</div>
				</div>
			}

			@* Action buttons *@
			<div class="d-flex flex-wrap gap-3">
				<button class="btn-solid theme-success" @onclick="OnCommit"
					disabled="@(IsCommitting || IsDiscarding || string.IsNullOrWhiteSpace(CommitMessage))">
					@if (IsCommitting)
					{
						<span class="spinner-border spinner-sm me-1" role="status"></span>
						<span>Committing...</span>
					}
					else
					{
						<i class="bi bi-check-circle"></i>
						<span>Keep Changes</span>
					}
				</button>
				<button class="btn-solid theme-danger" @onclick="() => _showDiscardConfirmation = true"
					disabled="@(IsCommitting || IsDiscarding || _showDiscardConfirmation)">
					<i class="bi bi-trash"></i>
					<span>Discard Changes</span>
				</button>
			</div>
		}
	</div>
</div>

@code {
	[Parameter]
	public List<DiffFile> DiffFiles { get; set; } = new();

	[Parameter]
	public bool IsChecking { get; set; }

	[Parameter]
	public bool HasChecked { get; set; }

	[Parameter]
	public bool HasChanges { get; set; }

	[Parameter]
	public string? ErrorMessage { get; set; }

	[Parameter]
	public bool JobFailed { get; set; }

	[Parameter]
	public string CommitMessage { get; set; } = string.Empty;

	[Parameter]
	public EventCallback<string> CommitMessageChanged { get; set; }

	[Parameter]
	public bool IsCommitting { get; set; }

	[Parameter]
	public bool IsDiscarding { get; set; }

	[Parameter]
	public EventCallback OnCheck { get; set; }

	[Parameter]
	public EventCallback OnRefresh { get; set; }

	[Parameter]
	public EventCallback OnCommit { get; set; }

	[Parameter]
	public EventCallback OnDiscard { get; set; }

	private HashSet<int> _expandedFiles = new();
	private bool _showDiscardConfirmation = false;

	protected override void OnParametersSet()
	{
		// Auto-expand first file if there's only one
		if (DiffFiles.Count == 1 && _expandedFiles.Count == 0)
		{
			_expandedFiles.Add(0);
		}
	}

	private void ToggleFile(int index)
	{
		if (_expandedFiles.Contains(index))
			_expandedFiles.Remove(index);
		else
			_expandedFiles.Add(index);
	}

	private void ExpandAll()
	{
		_expandedFiles = Enumerable.Range(0, DiffFiles.Count).ToHashSet();
	}

	private void CollapseAll()
	{
		_expandedFiles.Clear();
	}

	private async Task ConfirmDiscard()
	{
		await OnDiscard.InvokeAsync();
		_showDiscardConfirmation = false;
	}
}