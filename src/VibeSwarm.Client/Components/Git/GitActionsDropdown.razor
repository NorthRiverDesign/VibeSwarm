@* Git actions dropdown menu component *@

<div class="flex-shrink-0">
	<button class="btn-sm btn-solid theme-secondary" type="button" data-bs-toggle="menu" data-bs-placement="bottom-end"
		aria-expanded="false" disabled="@IsDisabled" title="Git actions">
		<i class="bi bi-git"></i>
		<span class="d-none sm:d-inline ms-1">Git</span>
		<i class="bi bi-chevron-down small opacity-75"></i>
	</button>
	<div class="menu">
			<button class="menu-item" @onclick="OnCreateBranch" disabled="@IsDisabled">
				<i class="bi bi-plus-lg fg-primary"></i>New Branch
			</button>
			<button class="menu-item" @onclick="OnSync" disabled="@IsDisabled">
				@if (IsSyncing)
				{
					<span class="spinner-border spinner-sm me-3" role="status"></span>
				}
				else
				{
					<i class="bi bi-cloud-download fg-success"></i>
				}
				Sync with Origin
			</button>
			<button class="menu-item" @onclick="OnPruneBranches" disabled="@(IsDisabled || IsPruning)">
				@if (IsPruning)
				{
					<span class="spinner-border spinner-sm me-3" role="status"></span>
				}
				else
				{
					<i class="bi bi-scissors fg-warning"></i>
				}
				Prune Stale Branches
			</button>
			<hr class="menu-divider">
			<button class="menu-item" @onclick="OnRefresh" disabled="@IsDisabled">
				<i class="bi bi-arrow-clockwise @(IsRefreshing ? "spinner-rotate" : "")"></i>
				Refresh Branches
			</button>
	</div>
</div>

@code {
	[Parameter]
	public bool IsDisabled { get; set; }

	[Parameter]
	public bool IsSyncing { get; set; }

	[Parameter]
	public bool IsRefreshing { get; set; }

	[Parameter]
	public bool IsPruning { get; set; }

	[Parameter]
	public EventCallback OnCreateBranch { get; set; }

	[Parameter]
	public EventCallback OnSync { get; set; }

	[Parameter]
	public EventCallback OnRefresh { get; set; }

	[Parameter]
	public EventCallback OnPruneBranches { get; set; }
}