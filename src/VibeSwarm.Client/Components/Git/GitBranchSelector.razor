@* Git branch selector dropdown component *@

@if (Branches.Any())
{
	<div class="git-branch-dropdown">
		<button class="@(Subtle ? "btn-link btn-sm fg-1 text-decoration-none px-0" : "btn btn-sm bg-2 border d-flex gap-3")" type="button"
			data-bs-toggle="menu" data-bs-placement="@(Subtle ? "bottom-start" : "bottom-end")" aria-expanded="false" disabled="@(IsDisabled || !Branches.Any())"
			title="Current branch">
			<i class="bi bi-git @(Subtle ? "" : "fg-danger")"></i>
			<span class="fw-medium text-truncate" style="max-width: 120px;">@(CurrentBranch ?? "No branch")</span>
			@if (!Subtle && !string.IsNullOrEmpty(CurrentCommitHash))
			{
				<span class="font-monospace fg-1 small d-none md:d-inline">@CurrentCommitHash[..Math.Min(7,
								CurrentCommitHash.Length)]</span>
				}
			<i class="bi bi-chevron-down small opacity-75"></i>
		</button>
		<div class="menu menu-scrollable" style="--bs-menu-max-height: 300px;">
				<h6 class="menu-header">Local Branches</h6>
			@foreach (var branch in Branches.Where(b => !b.IsRemote))
			{
				var isCurrentBranch = branch.Name == CurrentBranch;
					<button class="menu-item @(isCurrentBranch ? "active" : "")"
						@onclick="@(() => OnBranchSelected.InvokeAsync(branch.Name))" disabled="@isCurrentBranch">
						@if (isCurrentBranch)
						{
							<i class="bi bi-check-lg"></i>
						}
						else
						{
							<i class="bi bi-git opacity-50"></i>
						}
						<span>@branch.Name</span>
					</button>
			}
			@if (Branches.Any(b => b.IsRemote))
			{
					<hr class="menu-divider">
					<h6 class="menu-header">Remote Branches</h6>
				@foreach (var branch in Branches.Where(b => b.IsRemote))
				{
						<button class="menu-item"
							@onclick="@(() => OnBranchSelected.InvokeAsync(branch.ShortName))">
							<i class="bi bi-cloud opacity-50"></i>
							<span>@branch.Name</span>
						</button>
				}
			}
		</div>
	</div>
}
else if (!string.IsNullOrEmpty(CurrentBranch))
{
	<span class="badge d-flex">
		<i class="bi bi-git fg-danger"></i>
		@CurrentBranch
	</span>
}

@code {
	[Parameter]
	public List<GitBranchInfo> Branches { get; set; } = new();

	[Parameter]
	public string? CurrentBranch { get; set; }

	[Parameter]
	public string? CurrentCommitHash { get; set; }

	[Parameter]
	public bool IsDisabled { get; set; }

	/// <summary>Renders the trigger as plain secondary text, for use inside a line of metadata.</summary>
	[Parameter]
	public bool Subtle { get; set; }

	[Parameter]
	public EventCallback<string> OnBranchSelected { get; set; }
}