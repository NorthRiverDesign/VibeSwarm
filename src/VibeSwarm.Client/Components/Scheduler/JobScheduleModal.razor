@using VibeSwarm.Shared.Validation
@inject IJobScheduleService JobScheduleService
@inject IProjectService ProjectService
@inject IAgentService AgentService
@inject IServiceProvider Services
@inject IInferenceProviderService InferenceProviderService
@inject AppTimeZoneService AppTimeZoneService
@inject NotificationService NotificationService

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="HandleModalVisibilityChanged"
			 Title="@(IsEdit ? "Edit Schedule" : "Add Schedule")" Icon="calendar-event"
			 Size="ModalDialog.ModalSize.Large" OnClose="HandleClose">
	<ChildContent>
		<EditForm Model="@Schedule" OnValidSubmit="HandleValidSubmit">
			<DataAnnotationsValidator />
			<ValidationSummary class="fg-danger mb-5" />

			<div class="mb-5">
				<label for="schedule-project" class="form-label">Project</label>
				<select id="schedule-project" class="form-control" value="@GetProjectValue()" @onchange="OnProjectChanged">
					<option value="">Select project...</option>
					@foreach (var project in _projects)
					{
						<option value="@project.Id">@project.Name</option>
					}
				</select>
			</div>

			<div class="row g-5 mb-5">
				<div class="col-12 lg:col-4">
					<label for="schedule-type" class="form-label">Schedule Type</label>
					<InputSelect id="schedule-type" @bind-Value="Schedule.ScheduleType" @bind-Value:after="OnScheduleTypeChanged" class="form-control">
						<option value="@JobScheduleType.RunJob">Run Job</option>
						<option value="@JobScheduleType.GenerateIdeas">Generate Ideas</option>
					</InputSelect>
				</div>
			</div>

			@if (Schedule.ScheduleType == JobScheduleType.RunJob)
			{
				<div class="mb-5">
					<label for="schedule-prompt" class="form-label">Prompt</label>
					<InputTextArea id="schedule-prompt" @bind-Value="Schedule.Prompt" class="form-control" rows="5"
								   placeholder="update dependencies, check for security issues" />
					<ValidationMessage For="@(() => Schedule.Prompt)" class="fg-danger small" />
					<div class="form-text">Each time this schedule runs, VibeSwarm will create a new job with this prompt.</div>
				</div>
			}
			else
			{
				<div class="mb-5">
					<label for="schedule-idea-count" class="form-label">Ideas to Generate</label>
					<InputSelect id="schedule-idea-count" @bind-Value="Schedule.IdeaCount" class="form-control">
						@for (var count = ValidationLimits.JobScheduleIdeaCountMin; count <= ValidationLimits.JobScheduleIdeaCountMax; count++)
						{
							<option value="@count">@count</option>
						}
					</InputSelect>
					<div class="form-text">Each run will analyze the project and add fresh ideas while avoiding existing backlog duplicates.</div>
				</div>
			}

			<div class="row g-5">
				@if (Schedule.ScheduleType == JobScheduleType.RunJob)
				{
					<div class="col-12 lg:col-4">
						<label for="schedule-target" class="form-label">Run as</label>
						<InputSelect id="schedule-target" @bind-Value="Schedule.ExecutionTarget" @bind-Value:after="OnExecutionTargetChanged" class="form-control">
							<option value="@JobScheduleExecutionTarget.Provider">A job on a profile</option>
							<option value="@JobScheduleExecutionTarget.Agent">One of your agents</option>
						</InputSelect>
					</div>

					@if (Schedule.ExecutionTarget == JobScheduleExecutionTarget.Provider)
					{
						<ProfilePicker Id="schedule-profile" Class="col-12 lg:col-4" Label="Run with" Profiles="_profiles" Allowed="ProfileRoles.CanBuild"
									   SelectedProfileId="Schedule.ProfileId" EmptyLabel="Project's Build profile"
									   OnSelected="profile => Schedule.ProfileId = profile?.Id" />
					}
					else
					{
						<div class="col-12 lg:col-4">
							<label for="schedule-team-role" class="form-label">Agent</label>
							<select id="schedule-team-role" class="form-control" value="@GetAgentValue()" @onchange="OnAgentChanged"
									disabled="@(!_agents.Any())">
								<option value="">@(_agents.Any() ? "Select agent..." : "No enabled agents")</option>
								@foreach (var agent in _agents)
								{
									<option value="@agent.Id">@GetAgentDisplayText(agent)</option>
								}
							</select>
							@if (!_agents.Any())
							{
								<div class="form-text fg-warning">Create an enabled agent from the Agents page first.</div>
							}
						</div>
					}
				}
				else
				{
					<div class="col-12 lg:col-4">
						<label for="schedule-inference-provider" class="form-label">Inference Provider</label>
						<select id="schedule-inference-provider" class="form-control" value="@GetInferenceProviderValue()" @onchange="OnInferenceProviderChanged"
								disabled="@(!_inferenceProviders.Any())">
							<option value="">@(_inferenceProviders.Any() ? "Select inference provider..." : "No enabled inference providers")</option>
							@foreach (var provider in _inferenceProviders)
							{
								<option value="@provider.Id">@provider.Name</option>
							}
						</select>
						@if (!_inferenceProviders.Any())
						{
							<div class="form-text fg-warning">Configure an enabled inference provider first.</div>
						}
					</div>
				}

				@* A job's model comes with its profile; only idea schedules pick one here. *@
				@if (Schedule.ScheduleType == JobScheduleType.GenerateIdeas)
				{
				<div class="col-12 lg:col-4">
					<label for="schedule-model" class="form-label">Model</label>
					<div class="input-group">
						<select id="schedule-model" class="form-control" @bind="_selectedModelId" @bind:after="OnModelChanged"
								disabled="@(_isLoadingModels || !_models.Any())">
							<option value="">@(_isLoadingModels ? "Loading..." : "Use assigned default")</option>
							@foreach (var model in _models)
							{
								<option value="@model.ModelId">@(model.DisplayName ?? model.ModelId)</option>
							}
						</select>
						<button type="button" class="btn-solid theme-secondary"
								@onclick="RefreshModelsAsync"
								disabled="@(_isRefreshingModels || _isLoadingModels || !ResolveSelectedProviderId().HasValue)"
								title="Refresh models from provider">
							@if (_isRefreshingModels)
							{
								<span class="spinner-border spinner-sm" role="status"></span>
							}
							else
							{
								<i class="bi bi-arrow-clockwise"></i>
							}
						</button>
					</div>
					<div class="form-text">Leave empty to use the inference provider's default suggest/default model.</div>
				</div>
				}
			</div>

			@if (Schedule.ScheduleType == JobScheduleType.RunJob && Schedule.ExecutionTarget == JobScheduleExecutionTarget.Agent)
			{
				var selectedAgent = GetSelectedAgent();
				@if (selectedAgent != null)
				{
					<div class="small fg-1 mt-3">
						<i class="bi bi-person-badge opacity-75 me-1"></i>@GetAgentRunsOn(selectedAgent)
					</div>
				}
			}

			<div class="row g-5 mt-1">
				<div class="col-12 lg:col-4">
					<label for="schedule-frequency" class="form-label">Schedule</label>
					<InputSelect id="schedule-frequency" @bind-Value="Schedule.Frequency" class="form-control">
						@foreach (var frequency in Enum.GetValues<JobScheduleFrequency>())
						{
							<option value="@frequency">@GetFrequencyLabel(frequency)</option>
						}
					</InputSelect>
				</div>

				@if (Schedule.Frequency == JobScheduleFrequency.Minutes)
				{
					<div class="col-12 lg:col-4">
						<label for="schedule-interval-minutes" class="form-label">Run every</label>
						<div class="input-group">
							<InputNumber id="schedule-interval-minutes" @bind-Value="Schedule.IntervalMinutes" class="form-control" min="5" max="60" />
							<span class="input-group-text">minutes</span>
						</div>
						<div class="form-text">Between 5 and 60 minutes.</div>
					</div>
				}
				else if (Schedule.Frequency == JobScheduleFrequency.Hourly)
				{
					<div class="col-12 lg:col-4">
						<label for="schedule-minute" class="form-label">Minute past the hour</label>
						<InputNumber id="schedule-minute" @bind-Value="Schedule.MinuteUtc" class="form-control" min="0" max="59" />
					</div>
				}
				else
				{
					<div class="col-12 lg:col-4">
						<label for="schedule-time" class="form-label">Run time</label>
						<input id="schedule-time" type="time" class="form-control" value="@_timeValue" @onchange="OnTimeChanged" />
					</div>
				}

				@if (Schedule.Frequency == JobScheduleFrequency.Weekly)
				{
					<div class="col-12 lg:col-4">
						<label for="schedule-weekday" class="form-label">Day of week</label>
						<InputSelect id="schedule-weekday" @bind-Value="Schedule.WeeklyDay" class="form-control">
							@foreach (var day in Enum.GetValues<DayOfWeek>())
							{
								<option value="@day">@day</option>
							}
						</InputSelect>
					</div>
				}
				else if (Schedule.Frequency == JobScheduleFrequency.Monthly)
				{
					<div class="col-12 lg:col-4">
						<label for="schedule-day-of-month" class="form-label">Day of month</label>
						<InputNumber id="schedule-day-of-month" @bind-Value="Schedule.DayOfMonth" class="form-control" min="1" max="31" />
						<div class="form-text">Shorter months run on their final day.</div>
					</div>
				}
			</div>

			<div class="form-field mt-5">
				<div class="switch">
					<InputCheckbox role="switch" switch id="schedule-enabled" @bind-Value="Schedule.IsEnabled" />
				</div>
				<label for="schedule-enabled">Active</label>
			</div>
			<div class="form-text">Times use the configured timezone and are converted to UTC when the scheduler runs.</div>

			@if (!string.IsNullOrEmpty(ErrorMessage))
			{
				<div class="fg-danger small mt-5">
					<i class="bi bi-exclamation-circle me-1"></i>@ErrorMessage
				</div>
			}

			<div class="mt-7">
				<ModalFooterActions OnCancel="HandleCancel" Busy="@IsSaving" IsSubmit="true"
									SubmitText="@(IsEdit ? "Update Schedule" : "Add Schedule")"
									SubmitLoadingText="Saving..."
									SubmitIcon="@(IsEdit ? "check-lg" : "plus-lg")" />
			</div>
		</EditForm>
	</ChildContent>
</ModalDialog>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public EventCallback<bool> IsVisibleChanged { get; set; }

	[Parameter]
	public JobSchedule? EditSchedule { get; set; }

	[Parameter]
	public EventCallback<Guid?> OnSaved { get; set; }

	[Parameter]
	public EventCallback OnCancelled { get; set; }

	[Parameter]
	public EventCallback OnClosed { get; set; }

	private JobSchedule Schedule { get; set; } = new();
	private bool IsEdit => EditSchedule != null;
	private bool IsSaving { get; set; }
	private string? ErrorMessage { get; set; }
	private bool _previousIsVisible;
	private List<Project> _projects = [];
	private readonly Dictionary<Guid, Project> _projectDetailsById = [];
	private List<Agent> _agents = [];
	private List<Profile> _profiles = [];
	private List<InferenceProvider> _inferenceProviders = [];
	private List<ProviderModel> _models = [];
	private bool _isLoadingModels;
	private bool _isRefreshingModels;
	private string _selectedModelId = string.Empty;
	private string _timeValue = "09:00";

	protected override async Task OnInitializedAsync()
	{
		await AppTimeZoneService.EnsureInitializedAsync();
		await LoadLookupDataAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		if (IsVisible && !_previousIsVisible)
		{
			await LoadLookupDataAsync();
			await ResetStateAsync();
		}
		else if (!_projects.Any() || !_agents.Any())
		{
			await LoadLookupDataAsync();
			await SyncExecutionTargetsAsync(preserveCurrentSelection: true);
		}
		else if (IsVisible && Schedule.ProjectId != Guid.Empty)
		{
			// Modal is already open — clear the project detail cache so provider
			// selections are refreshed on re-render (e.g. timer-driven parent updates).
			_projectDetailsById.Remove(Schedule.ProjectId);
			await SyncExecutionTargetsAsync(preserveCurrentSelection: true);
		}

		_previousIsVisible = IsVisible;
	}

	private async Task LoadLookupDataAsync()
	{
		var projectsTask = ProjectService.GetAllAsync();
		var agentsTask = AgentService.GetAllAsync();
		var inferenceProvidersTask = InferenceProviderService.GetEnabledAsync();
		await Task.WhenAll(projectsTask, agentsTask, inferenceProvidersTask);

		_projects = projectsTask.Result
			.OrderBy(project => project.Name)
			.ToList();
		_projectDetailsById.Clear();
		_agents = agentsTask.Result
			.Where(agent => agent.IsEnabled)
			.OrderBy(agent => agent.Name)
			.ToList();
		_inferenceProviders = inferenceProvidersTask.Result.ToList();

		// Resolved lazily so pages and tests that never open the editor need no registration.
		try
		{
			_profiles = Services.GetService<IProfileService>() is { } profileService
				? (await profileService.GetAllAsync()).ToList()
				: [];
		}
		catch (HttpRequestException)
		{
			_profiles = [];
		}
	}

	private async Task ResetStateAsync()
	{
		ErrorMessage = null;
		IsSaving = false;
		_models = [];

		if (EditSchedule != null)
		{
			Schedule = new JobSchedule
			{
				Id = EditSchedule.Id,
				ProjectId = EditSchedule.ProjectId,
				ScheduleType = EditSchedule.ScheduleType,
				ExecutionTarget = EditSchedule.ExecutionTarget,
				// The server keeps the provider and model beside the profile; only the profile is sent.
				ProfileId = EditSchedule.ProfileId,
				AgentId = EditSchedule.AgentId,
				InferenceProviderId = EditSchedule.InferenceProviderId,
				Prompt = EditSchedule.Prompt,
				ModelId = EditSchedule.ModelId,
				IdeaCount = EditSchedule.IdeaCount,
				Frequency = EditSchedule.Frequency,
				IntervalMinutes = EditSchedule.IntervalMinutes,
				HourUtc = EditSchedule.HourUtc,
				MinuteUtc = EditSchedule.MinuteUtc,
				WeeklyDay = EditSchedule.WeeklyDay,
				DayOfMonth = EditSchedule.DayOfMonth,
				IsEnabled = EditSchedule.IsEnabled,
				CreatedAt = EditSchedule.CreatedAt,
				UpdatedAt = EditSchedule.UpdatedAt,
				NextRunAtUtc = EditSchedule.NextRunAtUtc,
				LastRunAtUtc = EditSchedule.LastRunAtUtc,
				LastError = EditSchedule.LastError
			};
		}
		else
		{
			var project = _projects.FirstOrDefault();
			Schedule = new JobSchedule
			{
				ProjectId = project?.Id ?? Guid.Empty,
				ScheduleType = JobScheduleType.RunJob,
				ExecutionTarget = JobScheduleExecutionTarget.Provider,
				InferenceProviderId = _inferenceProviders.FirstOrDefault()?.Id,
				IdeaCount = SuggestIdeasRequest.DefaultIdeaCount,
				Frequency = JobScheduleFrequency.Daily,
				IntervalMinutes = 15,
				HourUtc = 9,
				MinuteUtc = 0,
				WeeklyDay = DayOfWeek.Monday,
				DayOfMonth = 1,
				IsEnabled = true
			};
		}

		_timeValue = $"{Schedule.HourUtc:D2}:{Schedule.MinuteUtc:D2}";
		await SyncExecutionTargetsAsync(preserveCurrentSelection: IsEdit);
	}

	private Project? GetSelectedProject()
		=> _projects.FirstOrDefault(project => project.Id == Schedule.ProjectId);

	private async Task<Project?> GetSelectedProjectAsync()
	{
		if (Schedule.ProjectId == Guid.Empty)
		{
			return null;
		}

		if (_projectDetailsById.TryGetValue(Schedule.ProjectId, out var cachedProject))
		{
			return cachedProject;
		}

		var detailedProject = await ProjectService.GetByIdAsync(Schedule.ProjectId);
		if (detailedProject == null)
		{
			return GetSelectedProject();
		}

		_projectDetailsById[Schedule.ProjectId] = detailedProject;
		var projectIndex = _projects.FindIndex(project => project.Id == detailedProject.Id);
		if (projectIndex >= 0)
		{
			_projects[projectIndex] = detailedProject;
		}
		else
		{
			_projects.Add(detailedProject);
			_projects = _projects
				.OrderBy(project => project.Name)
				.ToList();
		}

		return detailedProject;
	}

	private async Task SyncExecutionTargetsAsync(bool preserveCurrentSelection)
	{
		if (Schedule.ScheduleType == JobScheduleType.GenerateIdeas)
		{
			if (!preserveCurrentSelection || !Schedule.InferenceProviderId.HasValue || !_inferenceProviders.Any(provider => provider.Id == Schedule.InferenceProviderId.Value))
			{
				Schedule.InferenceProviderId = _inferenceProviders.FirstOrDefault()?.Id;
			}

			Schedule.ProfileId = null;
			Schedule.AgentId = null;
		}
		else if (Schedule.ExecutionTarget == JobScheduleExecutionTarget.Provider)
		{
			// No profile is a choice too: the job then runs on the project's Build profile.
			Schedule.AgentId = null;
		}
		else
		{
			if (!preserveCurrentSelection || !Schedule.AgentId.HasValue || !_agents.Any(agent => agent.Id == Schedule.AgentId.Value))
			{
				Schedule.AgentId = _agents.FirstOrDefault()?.Id;
			}

			Schedule.ProfileId = null;
		}

		await LoadModelsAsync();
	}

	private async Task LoadModelsAsync()
	{
		_models = [];
		_selectedModelId = string.Empty;

		var resolvedProviderId = ResolveSelectedProviderId();
		if (!resolvedProviderId.HasValue)
		{
			Schedule.ModelId = null;
			return;
		}

		_isLoadingModels = true;
		StateHasChanged();

		try
		{
			_models = (await InferenceProviderService.GetModelsAsync(resolvedProviderId.Value))
				.Where(model => model.IsAvailable)
				.Select(model => new ProviderModel
				{
					Id = model.Id,
					ModelId = model.ModelId,
					DisplayName = model.DisplayName ?? model.ModelId,
					IsAvailable = model.IsAvailable,
					IsDefault = model.IsDefault
				})
				.OrderByDescending(model => model.IsDefault)
				.ThenBy(model => model.DisplayName ?? model.ModelId)
				.ToList();

			if (!string.IsNullOrWhiteSpace(Schedule.ModelId) && _models.Any(model => model.ModelId == Schedule.ModelId))
			{
				_selectedModelId = Schedule.ModelId;
			}
			else
			{
				_selectedModelId = ResolveDefaultModel(resolvedProviderId.Value);
				Schedule.ModelId = string.IsNullOrWhiteSpace(_selectedModelId) ? null : _selectedModelId;
			}
		}
		catch
		{
			_models = [];
			_selectedModelId = string.Empty;
			Schedule.ModelId = null;
		}
		finally
		{
			_isLoadingModels = false;
		}
	}

	private async Task OnProjectChanged(ChangeEventArgs args)
	{
		Schedule.ProjectId = TryParseGuid(args.Value);
		ErrorMessage = null;
		await SyncExecutionTargetsAsync(preserveCurrentSelection: false);
	}

	private async Task OnExecutionTargetChanged()
	{
		ErrorMessage = null;
		await SyncExecutionTargetsAsync(preserveCurrentSelection: false);
	}

	private async Task OnScheduleTypeChanged()
	{
		ErrorMessage = null;
		await SyncExecutionTargetsAsync(preserveCurrentSelection: false);
	}

	private async Task OnInferenceProviderChanged(ChangeEventArgs args)
	{
		Schedule.InferenceProviderId = TryParseNullableGuid(args.Value);
		ErrorMessage = null;
		await LoadModelsAsync();
	}

	private async Task OnAgentChanged(ChangeEventArgs args)
	{
		Schedule.AgentId = TryParseNullableGuid(args.Value);
		ErrorMessage = null;
		await LoadModelsAsync();
	}

	private Task OnModelChanged()
	{
		Schedule.ModelId = string.IsNullOrWhiteSpace(_selectedModelId) ? null : _selectedModelId;
		return Task.CompletedTask;
	}

	private async Task RefreshModelsAsync()
	{
		var providerId = ResolveSelectedProviderId();
		if (!providerId.HasValue)
		{
			return;
		}

		_isRefreshingModels = true;
		StateHasChanged();
		try
		{
			var refreshed = (await InferenceProviderService.RefreshModelsAsync(providerId.Value)).ToList();
			_models = refreshed
				.Where(model => model.IsAvailable)
				.Select(model => new ProviderModel
				{
					Id = model.Id,
					ModelId = model.ModelId,
					DisplayName = model.DisplayName ?? model.ModelId,
					IsAvailable = model.IsAvailable,
					IsDefault = model.IsDefault
				})
				.OrderByDescending(model => model.IsDefault)
				.ThenBy(model => model.DisplayName ?? model.ModelId)
				.ToList();

			if (!string.IsNullOrWhiteSpace(_selectedModelId) && _models.Any(model => model.ModelId == _selectedModelId))
			{
				// Preserve current selection when still available.
			}
			else
			{
				_selectedModelId = ResolveDefaultModel(providerId.Value);
				Schedule.ModelId = string.IsNullOrWhiteSpace(_selectedModelId) ? null : _selectedModelId;
			}

			NotificationService.ShowSuccess($"Found {_models.Count} model(s).");
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to refresh models: {ex.Message}");
		}
		finally
		{
			_isRefreshingModels = false;
			StateHasChanged();
		}
	}

	private static string GetFrequencyLabel(JobScheduleFrequency frequency)
		=> frequency switch
		{
			JobScheduleFrequency.Minutes => "Every N Minutes",
			JobScheduleFrequency.Hourly => "Hourly",
			JobScheduleFrequency.Daily => "Daily",
			JobScheduleFrequency.Weekly => "Weekly",
			JobScheduleFrequency.Monthly => "Monthly",
			_ => frequency.ToString()
		};

	private Task OnTimeChanged(ChangeEventArgs args)
	{
		_timeValue = args.Value?.ToString() ?? string.Empty;
		return Task.CompletedTask;
	}

	private async Task HandleValidSubmit()
	{
		ErrorMessage = null;

		if (Schedule.ProjectId == Guid.Empty)
		{
			ErrorMessage = "Please select a project.";
			return;
		}

		if (Schedule.ScheduleType == JobScheduleType.RunJob && Schedule.ExecutionTarget == JobScheduleExecutionTarget.Agent && !Schedule.AgentId.HasValue)
		{
			ErrorMessage = "Please select an agent.";
			return;
		}

		if (Schedule.ScheduleType == JobScheduleType.GenerateIdeas && !Schedule.InferenceProviderId.HasValue)
		{
			ErrorMessage = "Please select an inference provider.";
			return;
		}

		if (Schedule.Frequency == JobScheduleFrequency.Minutes)
		{
			if (Schedule.IntervalMinutes < 5 || Schedule.IntervalMinutes > 60)
			{
				ErrorMessage = "Interval must be between 5 and 60 minutes.";
				return;
			}

			Schedule.HourUtc = 0;
			Schedule.MinuteUtc = 0;
		}
		else if (Schedule.Frequency != JobScheduleFrequency.Hourly)
		{
			if (!TimeOnly.TryParse(_timeValue, out var time))
			{
				ErrorMessage = "Please provide a valid run time.";
				return;
			}

			Schedule.HourUtc = time.Hour;
			Schedule.MinuteUtc = time.Minute;
		}
		else
		{
			Schedule.HourUtc = 0;
		}

		// A provider is never sent: the server takes it from the profile, or from the agent.
		Schedule.ProviderId = null;
		if (Schedule.ScheduleType == JobScheduleType.GenerateIdeas)
		{
			Schedule.ProfileId = null;
			Schedule.AgentId = null;
			Schedule.Prompt = string.Empty;
		}
		else if (Schedule.ExecutionTarget == JobScheduleExecutionTarget.Provider)
		{
			Schedule.AgentId = null;
			Schedule.InferenceProviderId = null;
		}
		else
		{
			Schedule.ProfileId = null;
			Schedule.InferenceProviderId = null;
		}

		Schedule.ModelId = string.IsNullOrWhiteSpace(_selectedModelId) ? null : _selectedModelId;

		IsSaving = true;
		try
		{
			var saved = IsEdit
				? await JobScheduleService.UpdateAsync(Schedule)
				: await JobScheduleService.CreateAsync(Schedule);

			NotificationService.ShowSuccess(IsEdit ? "Schedule updated successfully." : "Schedule created successfully.");
			await IsVisibleChanged.InvokeAsync(false);
			await OnSaved.InvokeAsync(saved.Id);
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
		finally
		{
			IsSaving = false;
		}
	}

	private async Task HandleCancel()
	{
		await IsVisibleChanged.InvokeAsync(false);
		await OnCancelled.InvokeAsync();
	}

	private async Task HandleClose()
	{
		await IsVisibleChanged.InvokeAsync(false);
		await OnClosed.InvokeAsync();
	}

	private async Task HandleModalVisibilityChanged(bool isVisible)
	{
		IsVisible = isVisible;
		await IsVisibleChanged.InvokeAsync(isVisible);
	}

	private Agent? GetSelectedAgent()
		=> Schedule.AgentId.HasValue
			? _agents.FirstOrDefault(agent => agent.Id == Schedule.AgentId.Value)
			: null;

	/// <summary>The inference provider whose models an idea schedule picks from. A job's model comes with its profile.</summary>
	private Guid? ResolveSelectedProviderId()
		=> Schedule.ScheduleType == JobScheduleType.GenerateIdeas ? Schedule.InferenceProviderId : null;

	private string ResolveDefaultModel(Guid providerId)
		=> _models.FirstOrDefault(model => model.IsDefault)?.ModelId ?? string.Empty;

	/// <summary>What the agent runs on: its profile by name, else the provider it was set up with.</summary>
	private string GetAgentRunsOn(Agent agent)
		=> _profiles.FirstOrDefault(profile => profile.Id == agent.ProfileId)?.Name
			?? agent.DefaultProvider?.Name
			?? "No profile yet";

	private string GetAgentDisplayText(Agent agent) => $"{agent.Name} ({GetAgentRunsOn(agent)})";

	private string GetProjectValue() => Schedule.ProjectId == Guid.Empty ? string.Empty : Schedule.ProjectId.ToString();
	private string GetAgentValue() => Schedule.AgentId?.ToString() ?? string.Empty;
	private string GetInferenceProviderValue() => Schedule.InferenceProviderId?.ToString() ?? string.Empty;

	private static Guid TryParseGuid(object? value)
		=> Guid.TryParse(value?.ToString(), out var id) ? id : Guid.Empty;

	private static Guid? TryParseNullableGuid(object? value)
		=> Guid.TryParse(value?.ToString(), out var id) ? id : null;
}
