@* One schedule as a grouped-list row: what it runs, for which project and when next. A failed last
   run replaces the second line; a job it started shows as Running. Opens in place for the full
   cadence and the pause, edit and delete actions. *@

<ListRow Icon="@(IsIdeas ? "stars" : "calendar-event")"
		 IconClass="@(Schedule.IsEnabled ? "text-primary" : "text-body-tertiary")"
		 Title="@GetTitle(Schedule)" TitleClass="@(Schedule.IsEnabled ? null : "text-body-secondary")"
		 Subtitle="@GetSummary()"
		 AttentionLine="@(string.IsNullOrWhiteSpace(Schedule.LastError) ? null : "Last run failed")">
	<Trailing>
		@if (ActiveJob != null)
		{
			<span class="small text-success flex-shrink-0 d-inline-flex align-items-center gap-1"><span class="live-dot"></span>Running</span>
		}
		else if (!Schedule.IsEnabled)
		{
			<span class="small text-body-tertiary flex-shrink-0">Paused</span>
		}
	</Trailing>
	<ChildContent>
		<dl class="d-flex flex-column gap-2 small mb-0">
			<div class="d-flex justify-content-between gap-3">
				<dt class="fw-normal text-body-secondary flex-shrink-0">Project</dt>
				<dd class="mb-0 text-end text-break">@(Schedule.Project?.Name ?? "Unknown project")</dd>
			</div>
			<div class="d-flex justify-content-between gap-3">
				<dt class="fw-normal text-body-secondary flex-shrink-0">@(IsIdeas ? "Inference" : Schedule.ExecutionTarget == JobScheduleExecutionTarget.Agent ? "Agent" : "Provider")</dt>
				<dd class="mb-0 text-end text-break">@GetRunner()</dd>
			</div>
			@if (!string.IsNullOrWhiteSpace(Schedule.ModelId))
			{
				<div class="d-flex justify-content-between gap-3">
					<dt class="fw-normal text-body-secondary flex-shrink-0">Model</dt>
					<dd class="mb-0 text-end text-break">@Schedule.ModelId</dd>
				</div>
			}
			<div class="d-flex justify-content-between gap-3">
				<dt class="fw-normal text-body-secondary flex-shrink-0">Repeats</dt>
				<dd class="mb-0 text-end">@DescribeCadence()</dd>
			</div>
			<div class="d-flex justify-content-between gap-3">
				<dt class="fw-normal text-body-secondary flex-shrink-0">Next run</dt>
				<dd class="mb-0 text-end" title="@Schedule.NextRunAtUtc.FormatDateTimeShort()">@(Schedule.IsEnabled ? FormatNextRun(Schedule.NextRunAtUtc) : "Paused")</dd>
			</div>
			@if (Schedule.LastRunAtUtc is { } lastRun)
			{
				<div class="d-flex justify-content-between gap-3">
					<dt class="fw-normal text-body-secondary flex-shrink-0">Last run</dt>
					<dd class="mb-0 text-end" title="@lastRun.FormatDateTimeShort()">@lastRun.FormatRelativeToNow()</dd>
				</div>
			}
		</dl>

		@if (!IsIdeas && !string.IsNullOrWhiteSpace(Schedule.Prompt))
		{
			<div class="d-flex flex-column gap-1">
				<div class="text-eyebrow">Prompt</div>
				<div class="small white-space-pre-wrap text-break">@Schedule.Prompt</div>
			</div>
		}

		@if (!string.IsNullOrWhiteSpace(Schedule.LastError))
		{
			<div class="small rounded-3 p-2 text-danger-emphasis bg-danger-subtle text-break">
				<i class="bi bi-exclamation-triangle me-1"></i>@TruncateText(Schedule.LastError, 400)
			</div>
		}

		@if (ActiveJob != null)
		{
			<a class="small rounded-3 p-2 bg-success-subtle text-success-emphasis text-decoration-none d-flex align-items-center gap-2 min-width-0"
			   href="@($"/jobs/view/{ActiveJob.Id}")">
				<span class="live-dot flex-shrink-0"></span>
				<span class="text-truncate">@(string.IsNullOrEmpty(ActiveJob.CurrentActivity) ? "Job running" : ActiveJob.CurrentActivity)</span>
				<i class="bi bi-chevron-right ms-auto flex-shrink-0"></i>
			</a>
		}

		<div class="d-flex align-items-center gap-2">
			<button type="button" class="btn btn-sm btn-secondary" @onclick="() => OnToggle.InvokeAsync(Schedule)">
				<i class="bi @(Schedule.IsEnabled ? "bi-pause-fill" : "bi-play-fill") me-1"></i>@(Schedule.IsEnabled ? "Pause" : "Resume")
			</button>
			<button type="button" class="btn btn-sm btn-secondary" @onclick="() => OnEdit.InvokeAsync(Schedule)">Edit</button>
			<button type="button" class="btn btn-sm btn-link text-danger text-decoration-none px-0 ms-auto" @onclick="() => OnDelete.InvokeAsync(Schedule)">
				<i class="bi bi-trash me-1"></i>Delete
			</button>
		</div>
	</ChildContent>
</ListRow>

@code {
	[Parameter, EditorRequired]
	public JobSchedule Schedule { get; set; } = new();

	/// <summary>The job this schedule started that is still running, if any.</summary>
	[Parameter]
	public JobSummary? ActiveJob { get; set; }

	[Parameter]
	public EventCallback<JobSchedule> OnToggle { get; set; }

	[Parameter]
	public EventCallback<JobSchedule> OnEdit { get; set; }

	[Parameter]
	public EventCallback<JobSchedule> OnDelete { get; set; }

	private bool IsIdeas => Schedule.ScheduleType == JobScheduleType.GenerateIdeas;

	/// <summary>What the schedule does, short enough for one line.</summary>
	public static string GetTitle(JobSchedule schedule)
	{
		if (schedule.ScheduleType == JobScheduleType.GenerateIdeas)
		{
			return $"Generate {schedule.IdeaCount} idea{(schedule.IdeaCount == 1 ? string.Empty : "s")}";
		}

		return TruncateText(schedule.Prompt, 110);
	}

	private string GetSummary()
	{
		var project = Schedule.Project?.Name ?? "Unknown project";
		return Schedule.IsEnabled ? $"{project} · next {FormatNextRun(Schedule.NextRunAtUtc)}" : project;
	}

	private string GetRunner()
	{
		if (IsIdeas)
		{
			return Schedule.InferenceProvider?.Name ?? "Unknown inference provider";
		}

		return Schedule.ExecutionTarget == JobScheduleExecutionTarget.Agent
			? Schedule.Agent?.Name ?? "Unknown agent"
			: Schedule.Provider?.Name ?? "Unknown provider";
	}

	private string DescribeCadence()
	{
		var time = $"{Schedule.HourUtc:D2}:{Schedule.MinuteUtc:D2}";
		return Schedule.Frequency switch
		{
			JobScheduleFrequency.Minutes => $"Every {Schedule.IntervalMinutes} minute{(Schedule.IntervalMinutes == 1 ? string.Empty : "s")}",
			JobScheduleFrequency.Hourly => $"Hourly at {Schedule.MinuteUtc:D2} past",
			JobScheduleFrequency.Weekly => $"Weekly on {Schedule.WeeklyDay} at {time}",
			JobScheduleFrequency.Monthly => $"Monthly on day {Schedule.DayOfMonth} at {time}",
			_ => $"Daily at {time}"
		};
	}

	private static string FormatNextRun(DateTime nextRunUtc)
	{
		// The poller runs every 30s and a re-enabled schedule can sit slightly in the past, where
		// "next 35m ago" would read as nonsense.
		return nextRunUtc - DateTime.UtcNow <= TimeSpan.FromMinutes(1)
			? "due now"
			: nextRunUtc.FormatRelativeToNow();
	}

	private static string TruncateText(string? text, int maxLength)
	{
		if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
		{
			return text ?? string.Empty;
		}

		return text[..maxLength] + "...";
	}
}
