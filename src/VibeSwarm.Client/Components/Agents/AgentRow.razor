@* One agent as a grouped-list row: its name and purpose, opening in place for its defaults, duties
   and skills. *@

<ListRow Icon="robot" IconClass="@(Agent.IsEnabled ? "text-primary" : "text-body-tertiary")"
		 Title="@Agent.Name" TitleClass="@(Agent.IsEnabled ? null : "text-body-secondary")"
		 Subtitle="@GetSummary()">
	<Trailing>
		@if (!Agent.IsEnabled)
		{
			<span class="small text-body-tertiary flex-shrink-0">Off</span>
		}
	</Trailing>
	<ChildContent>
		@if (GetDefaults() is { Count: > 0 } defaults)
		{
			<dl class="d-flex flex-column gap-2 small mb-0">
				@foreach (var (label, value) in defaults)
				{
					<div class="d-flex justify-content-between gap-3">
						<dt class="fw-normal text-body-secondary flex-shrink-0">@label</dt>
						<dd class="mb-0 text-end text-break">@value</dd>
					</div>
				}
			</dl>
		}

		@if (!string.IsNullOrWhiteSpace(Agent.Responsibilities))
		{
			<div class="d-flex flex-column gap-1">
				<div class="text-eyebrow">Responsibilities</div>
				<div class="small white-space-pre-wrap">@TruncateText(Agent.Responsibilities, 240)</div>
			</div>
		}

		@if (LinkedSkills.Count > 0)
		{
			<div class="d-flex flex-column gap-1">
				<div class="text-eyebrow">@LinkedSkills.Count linked skill@(LinkedSkills.Count == 1 ? string.Empty : "s")</div>
				<div class="d-flex flex-wrap gap-1">
					@foreach (var skill in LinkedSkills)
					{
						<span class="badge bg-primary-subtle text-primary-emphasis">@skill.Name</span>
					}
				</div>
			</div>
		}

		<div class="form-check form-switch mb-0">
			<input class="form-check-input" type="checkbox" role="switch" id="@_enabledSwitchId"
				   checked="@Agent.IsEnabled" @onchange="() => OnToggleEnabled.InvokeAsync(Agent)" />
			<label class="form-check-label" for="@_enabledSwitchId">Offer this agent for new jobs</label>
		</div>

		<div class="d-flex align-items-center gap-2">
			<button type="button" class="btn btn-sm btn-secondary" @onclick="() => OnEdit.InvokeAsync(Agent)">Edit</button>
			<button type="button" class="btn btn-sm btn-link text-danger text-decoration-none px-0 ms-auto" @onclick="() => OnDelete.InvokeAsync(Agent)">
				<i class="bi bi-trash me-1"></i>Delete
			</button>
		</div>
	</ChildContent>
</ListRow>

@code {
	[Parameter, EditorRequired]
	public Agent Agent { get; set; } = new();

	[Parameter]
	public EventCallback<Agent> OnToggleEnabled { get; set; }

	[Parameter]
	public EventCallback<Agent> OnEdit { get; set; }

	[Parameter]
	public EventCallback<Agent> OnDelete { get; set; }

	private readonly string _enabledSwitchId = $"agent-enabled-{Guid.NewGuid():N}";

	private List<Skill> LinkedSkills => Agent.SkillLinks
		.Where(link => link.Skill != null)
		.Select(link => link.Skill!)
		.ToList();

	/// <summary>The agent's purpose if it has one, otherwise what it runs on.</summary>
	private string? GetSummary()
	{
		if (!string.IsNullOrWhiteSpace(Agent.Description))
		{
			return Agent.Description;
		}

		var parts = new[] { Agent.DefaultProvider?.Name, Agent.DefaultModelId }
			.Where(part => !string.IsNullOrWhiteSpace(part));
		return string.Join(" · ", parts);
	}

	private List<(string Label, string Value)> GetDefaults()
	{
		var defaults = new List<(string, string)>();
		if (Agent.DefaultProvider != null)
		{
			defaults.Add(("Provider", Agent.DefaultProvider.Name));
		}

		if (!string.IsNullOrWhiteSpace(Agent.DefaultModelId))
		{
			defaults.Add(("Model", Agent.DefaultModelId));
		}

		if (!string.IsNullOrWhiteSpace(Agent.DefaultReasoningEffort))
		{
			defaults.Add(("Reasoning", Agent.DefaultReasoningEffort));
		}

		defaults.Add(("Runs", DescribeExecutionProfile(Agent)));
		return defaults;
	}

	private static string TruncateText(string text, int maxLength)
		=> string.IsNullOrEmpty(text) || text.Length <= maxLength ? text : text[..maxLength] + "...";

	private static string DescribeExecutionProfile(Agent agent)
	{
		var cycleMode = agent.DefaultCycleMode switch
		{
			CycleMode.FixedCount => $"{agent.DefaultMaxCycles} fixed cycles",
			CycleMode.Autonomous => $"Autonomous, up to {agent.DefaultMaxCycles} cycles",
			_ => "One cycle"
		};
		if (agent.DefaultCycleMode == CycleMode.SingleCycle)
		{
			return cycleMode;
		}

		var sessionMode = agent.DefaultCycleSessionMode == CycleSessionMode.ContinueSession
			? "resumes the session"
			: "fresh session each cycle";
		return $"{cycleMode}, {sessionMode}";
	}
}
