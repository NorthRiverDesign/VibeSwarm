@* Reusable model selection component for idea expansion *@

<div class="text-start mb-3">
	@if (HasInference)
	{
		<div class="form-field mb-3">
			<div class="switch">
				<input role="switch" switch type="checkbox" id="useInference" checked="@UseInference"
					   @onchange="HandleToggleInference">
			</div>
				<label for="useInference">
					<i class="bi bi-pc-display me-1"></i>Use inference
				</label>
			</div>
		}

		@if (UseInference)
		{
			@if (AvailableModels.Any())
			{
				<div class="mb-3">
					<label class="form-label fw-semibold small mb-1">
						<i class="bi bi-cpu me-1"></i>Model
					</label>
					<select class="form-control form-control-sm" value="@SelectedModelName" @onchange="HandleModelChanged">
						<option value="">Auto (default model)</option>
						@foreach (var model in AvailableModels)
						{
							<option value="@model.Name">
								@(model.DisplayName ?? model.Name)
								@if (!string.IsNullOrEmpty(model.ParameterSize))
								{
									@($" ({model.ParameterSize})")
								}
							</option>
						}
					</select>
				</div>
			}
			else
			{
				<div class="fg-warning small">
					<i class="bi bi-exclamation-triangle me-1"></i>No local models available. Check your inference provider
					settings.
				</div>
			}
		}
		else
		{
			@if (AvailableProviders.Count > 1)
			{
				<div class="mb-3">
					<label class="form-label fw-semibold small mb-1">
						<i class="bi bi-cloud me-1"></i>Provider
					</label>
					<select class="form-control form-control-sm" value="@SelectedProviderId" @onchange="HandleProviderChanged">
						@foreach (var provider in AvailableProviders)
						{
							<option value="@provider.Id">
								@provider.Name
								@if (provider.IsDefault)
								{
									@(" (default)")
								}
							</option>
						}
					</select>
				</div>
			}
			else if (AvailableProviders.Count == 1)
			{
				<div class="fg-1 small">
					<i class="bi bi-cloud me-1"></i>Using @AvailableProviders[0].Name
				</div>
			}
			else
			{
				<div class="fg-warning small">
					<i class="bi bi-exclamation-triangle me-1"></i>No providers configured.
					<a href="/providers">Set up a provider</a> first.
				</div>
			}
		}
	</div>

@code {
	[Parameter]
	public bool UseInference { get; set; }

	[Parameter]
	public EventCallback<bool> UseInferenceChanged { get; set; }

	[Parameter]
	public string? SelectedModelName { get; set; }

	[Parameter]
	public EventCallback<string?> SelectedModelNameChanged { get; set; }

	[Parameter]
	public List<DiscoveredModel> AvailableModels { get; set; } = new();

	[Parameter]
	public bool HasInference { get; set; }

	[Parameter]
	public List<Provider> AvailableProviders { get; set; } = new();

	[Parameter]
	public string? SelectedProviderId { get; set; }

	[Parameter]
	public EventCallback<string?> SelectedProviderIdChanged { get; set; }

	private async Task HandleToggleInference(ChangeEventArgs e)
	{
		var value = (bool)(e.Value ?? false);
		UseInference = value;
		await UseInferenceChanged.InvokeAsync(value);

		// Reset model selection when toggling
		if (!value)
		{
			SelectedModelName = null;
			await SelectedModelNameChanged.InvokeAsync(null);
		}
	}

	private async Task HandleModelChanged(ChangeEventArgs e)
	{
		var value = e.Value?.ToString();
		SelectedModelName = string.IsNullOrEmpty(value) ? null : value;
		await SelectedModelNameChanged.InvokeAsync(SelectedModelName);
	}

	private async Task HandleProviderChanged(ChangeEventArgs e)
	{
		var value = e.Value?.ToString();
		SelectedProviderId = string.IsNullOrEmpty(value) ? null : value;
		await SelectedProviderIdChanged.InvokeAsync(SelectedProviderId);
	}
}