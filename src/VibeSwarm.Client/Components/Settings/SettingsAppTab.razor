@inject ISettingsService SettingsService
@inject IDeveloperModeService DeveloperModeService
@inject AppTimeZoneService AppTimeZoneService
@inject IFileSystemService FileSystemService
@inject NotificationService NotificationService
@inject ICriticalErrorLogService CriticalErrorLogService
@inject DeveloperUpdateOverlayService DeveloperUpdateOverlayService
@using VibeSwarm.Shared.Models

@if (_isLoading)
{
<LoadingSpinner />
}
else
{
<EditForm Model="@_settings" OnValidSubmit="SaveSettings">
<DataAnnotationsValidator />

@if (_developerModeStatus?.IsEnabled == true)
{
<h2 class="text-eyebrow mb-3 px-1">Developer mode</h2>

<div class="border rounded-5 p-5 bg-2 mb-7 d-flex flex-column gap-5">
<div class="d-flex flex-column lg:flex-row justify-content-between gap-5">
<div class="d-flex flex-column gap-3">
<div class="d-flex align-items-center gap-3 flex-wrap">
<span class="@GetDeveloperModeBadgeClass()">@GetDeveloperModeBadgeText()</span>
<span class="small fg-1">@_developerModeStatus.StatusMessage</span>
</div>
@if (!string.IsNullOrWhiteSpace(_developerModeStatus.WorkingDirectory))
{
<div class="small fg-1 text-break">
<i class="bi bi-folder2-open me-1"></i>@_developerModeStatus.WorkingDirectory
</div>
}
@if (!string.IsNullOrWhiteSpace(_developerModeStatus.BuildCommandSummary))
{
<div class="small">
<div class="fg-1 fw-semibold mb-1">Build command</div>
<code class="text-break white-space-pre-wrap">@_developerModeStatus.BuildCommandSummary</code>
</div>
}
@if (!string.IsNullOrWhiteSpace(_developerModeStatus.RestartCommandSummary))
{
<div class="small">
<div class="fg-1 fw-semibold mb-1">Restart command</div>
<code class="text-break white-space-pre-wrap">@_developerModeStatus.RestartCommandSummary</code>
</div>
}
</div>
<div class="d-flex flex-column gap-3">
<button type="button" class="btn-solid theme-primary" @onclick="StartSelfUpdate" disabled="@(_isStartingSelfUpdate || !_developerModeStatus.CanStartUpdate)">
@if (_isStartingSelfUpdate)
{
<span class="spinner-border spinner-sm me-1" role="status"></span>
<span>Starting...</span>
}
else if (_developerModeStatus.IsUpdateInProgress)
{
<i class="bi bi-arrow-repeat"></i>
<span>Update In Progress</span>
}
else
{
<i class="bi bi-arrow-repeat"></i>
<span>Rebuild And Restart</span>
}
</button>
@if (!_developerModeStatus.SupportsSelfUpdate)
{
<div class="small fg-emphasis-warning">
Set <code>DeveloperMode__BuildCommand</code> and either <code>DeveloperMode__RestartCommand</code> or <code>DeveloperMode__ServiceName</code> in <code>.env</code>.
</div>
}
</div>
</div>
<div class="small fg-1">
This starts a local rebuild and launches the configured restart command. The app will show a full-screen updating state and refresh automatically after the service comes back online.
</div>
</div>

<hr class="my-7" />
}

<div class="accordion mb-7">
<AccordionSection Title="Project defaults" Icon="folder"
Summary="Where new projects live and which clock the app runs on"
@bind-IsOpen="_openProjectDefaults">

<div class="mb-5">
<label for="defaultProjectsDirectory" class="form-label">Default Projects Directory</label>
<div class="input-group">
<input type="text" id="defaultProjectsDirectory" class="form-control font-monospace"
   @bind="_settings.DefaultProjectsDirectory" @bind:after="CheckDirectoryExists"
   placeholder="@_placeholder" />
<button type="button" class="btn-solid theme-secondary" @onclick="OpenDirectoryBrowser"
title="Browse directories">
<i class="bi bi-folder2-open"></i>
</button>
</div>
<div class="form-text">
This path will be used as the default prefix when creating new projects.
For example, if you set this to <code>@_examplePath</code> and create a project named
"MyApp",
the working path will default to
<code>@_examplePath@Path.DirectorySeparatorChar@("MyApp")</code>.
</div>

@if (!string.IsNullOrEmpty(_settings.DefaultProjectsDirectory))
{
<div class="mt-3 d-flex flex-wrap align-items-center gap-3">
@if (_directoryExists)
{
<span class="badge badge-subtle theme-success">
<i class="bi bi-check-circle"></i>Directory exists
</span>
<button type="button" class="btn-solid theme-primary btn-sm" @onclick="OpenScanProjectsModal">
<i class="bi bi-folder-symlink"></i>Import projects
</button>
}
else
{
<span class="badge badge-subtle theme-warning">
<i class="bi bi-exclamation-triangle"></i>Directory does not exist
</span>
}
</div>
}
</div>

<div class="mb-5">
<label for="timeZoneId" class="form-label">Timezone</label>
<select id="timeZoneId" class="form-control" @bind="_settings.TimeZoneId">
	@foreach (var option in _timeZoneOptions)
	{
		<option value="@option.Zone.Id">@option.Label</option>
	}
</select>
<div class="form-text">
Recurring schedules and timestamp displays use this timezone. Existing schedules keep the same local
clock time when you change it.
</div>
</div>

</AccordionSection>

<AccordionSection Title="Agent quality" Icon="robot"
Summary="What every agent prompt includes"
@bind-IsOpen="_openAgentQuality">

<div class="mb-5">
<div class="form-field">
<div class="switch">
	<input role="switch" switch type="checkbox" id="enablePromptStructuring"
	   @bind="_settings.EnablePromptStructuring" />
</div>
<label for="enablePromptStructuring">
Structure job prompts with XML tags
</label>
</div>
<div class="form-text">
Wraps job prompts with project context and constraints using XML tags for clearer agent
instructions.
</div>
</div>

<div class="mb-5">
<div class="form-field">
<div class="switch">
	<input role="switch" switch type="checkbox" id="injectRepoMap"
	   @bind="_settings.InjectRepoMap" />
</div>
<label for="injectRepoMap">
Inject repo map into system prompt
</label>
</div>
<div class="form-text">
Auto-generates a compact project file tree and injects it into the agent's system prompt for
faster codebase navigation.
</div>
</div>

<div class="mb-5">
<div class="form-field">
<div class="switch">
	<input role="switch" switch type="checkbox" id="injectEfficiencyRules"
	   @bind="_settings.InjectEfficiencyRules" />
</div>
<label for="injectEfficiencyRules">
Inject efficiency rules into system prompt
</label>
</div>
<div class="form-text">
Adds rules to prevent agents from modifying unrelated files, adding unnecessary comments, or
refactoring beyond the task.
</div>
</div>

<div class="mb-5">
<div class="form-field">
<div class="switch">
	<input role="switch" switch type="checkbox" id="enableCommitAttribution"
	   @bind="_settings.EnableCommitAttribution" />
</div>
<label for="enableCommitAttribution">
Enable provider commit attribution
</label>
</div>
<div class="form-text">
When enabled, VibeSwarm's auto-commits credit the provider that ran the job, such as a Copilot
co-author trailer or the provider's identity as author. When disabled, auto-commits use the
repository's default git identity.
</div>
</div>

</AccordionSection>

<AccordionSection Title="Idea prompts" Icon="lightbulb"
Summary="Templates used when generating improvement ideas"
@bind-IsOpen="_openIdeaPrompts">
<SettingsIdeaPromptTemplatesSection Settings="_settings" OnRestoreDefaults="RestoreIdeaPromptDefaults" />
</AccordionSection>

<AccordionSection Title="Skills marketplace" Icon="shop"
Summary="GitHub token for browsing published skills"
@bind-IsOpen="_openMarketplace">

<div class="mb-0">
	<label for="githubToken" class="form-label">GitHub token <span class="fg-1">(optional)</span></label>
	<div class="input-group">
		<input type="@(_showGitHubToken ? "text" : "password")" id="githubToken" class="form-control font-monospace"
			   @bind="_settings.GitHubToken" placeholder="ghp_..." autocomplete="off" />
		<button type="button" class="btn-solid theme-secondary" @onclick="ToggleGitHubTokenVisibility"
				title="@(_showGitHubToken ? "Hide token" : "Show token")">
			<i class="bi @(_showGitHubToken ? "bi-eye-slash" : "bi-eye")"></i>
		</button>
	</div>
	<div class="form-text">
		Used only when browsing the <code>anthropics/skills</code> marketplace from the Skills page.
		Without a token, GitHub limits anonymous requests to 60/hour per IP; adding an unscoped
		read-only personal access token lifts that to 5000/hour. The token is never sent to
		CLI agents.
	</div>
	<ValidationMessage For="@(() => _settings.GitHubToken)" class="fg-danger small" />
</div>
</AccordionSection>

<AccordionSection Title="Critical error logs" Icon="exclamation-octagon"
Summary="Crash reports captured from this browser"
Badge="@(_criticalErrorLogs.Count > 0 ? _criticalErrorLogs.Count.ToString() : null)"
BadgeClass="theme-danger" @bind-IsOpen="_openErrorLogs">

<div class="row g-5">
	<div class="col-12 md:col-6">
		<label for="criticalErrorLogRetentionDays" class="form-label">Retention (days)</label>
		<InputNumber id="criticalErrorLogRetentionDays" @bind-Value="_settings.CriticalErrorLogRetentionDays" class="form-control" />
		<div class="form-text">
			Keep critical crash logs for between @AppSettings.MinCriticalErrorLogRetentionDays and @AppSettings.MaxCriticalErrorLogRetentionDays days.
		</div>
		<ValidationMessage For="@(() => _settings.CriticalErrorLogRetentionDays)" class="fg-danger small" />
	</div>
	<div class="col-12 md:col-6">
		<label for="criticalErrorLogMaxEntries" class="form-label">Maximum stored entries</label>
		<InputNumber id="criticalErrorLogMaxEntries" @bind-Value="_settings.CriticalErrorLogMaxEntries" class="form-control" />
		<div class="form-text">
			Once this cap is reached, the oldest critical logs are removed automatically.
		</div>
		<ValidationMessage For="@(() => _settings.CriticalErrorLogMaxEntries)" class="fg-danger small" />
	</div>
</div>

<div class="mt-5 d-flex flex-wrap gap-3">
	<button type="button" class="btn-solid theme-secondary btn-sm" @onclick="RefreshCriticalErrorLogs" disabled="@_isLoadingCriticalErrorLogs">
		@if (_isLoadingCriticalErrorLogs)
		{
			<span class="spinner-border spinner-sm me-1" role="status"></span>
		}
		<i class="bi bi-arrow-clockwise"></i>Refresh Logs
	</button>
	<button type="button" class="btn-solid theme-secondary btn-sm" @onclick="PruneCriticalErrorLogs" disabled="@_isPruningCriticalErrorLogs">
		@if (_isPruningCriticalErrorLogs)
		{
			<span class="spinner-border spinner-sm me-1" role="status"></span>
		}
		<i class="bi bi-trash3"></i>Apply Retention Now
	</button>
</div>

<div class="mt-5 border rounded-5">
	<div class="list-group list-group-flush">
		@if (_criticalErrorLogs.Count == 0)
		{
			<div class="list-group-item fg-1 small">
				No critical errors have been recorded yet.
			</div>
		}
		else
		{
			@foreach (var entry in _criticalErrorLogs)
			{
				<div class="list-group-item">
					<div class="d-flex flex-column gap-3">
						<div class="d-flex flex-wrap align-items-center gap-3">
							<span class="badge badge-subtle theme-danger text-uppercase">@entry.Source</span>
							<span class="badge text-uppercase">@entry.Category</span>
							@if (entry.TriggeredRefresh)
							{
								<span class="badge badge-subtle theme-warning">
									<i class="bi bi-arrow-clockwise"></i>@(string.IsNullOrWhiteSpace(entry.RefreshAction) ? "Refresh triggered" : entry.RefreshAction)
								</span>
							}
							<span class="small fg-1">@entry.CreatedAt.FormatDateTimeShort()</span>
						</div>
						<div class="fw-semibold text-break">@entry.Message</div>
						@if (!string.IsNullOrWhiteSpace(entry.Url))
						{
							<div class="small fg-1 text-break">
								<i class="bi bi-link-45deg me-1"></i>@entry.Url
							</div>
						}
						@if (!string.IsNullOrWhiteSpace(entry.TraceId))
						{
							<div class="small fg-1 font-monospace text-break">Trace: @entry.TraceId</div>
						}
						@if (!string.IsNullOrWhiteSpace(entry.Details))
						{
							<details class="small">
								<summary class="cursor-pointer">Show details</summary>
								<pre class="mb-0 mt-3 p-3 bg-2 rounded small font-monospace white-space-pre-wrap">@entry.Details</pre>
							</details>
						}
					</div>
				</div>
			}
		}
	</div>
</div>
</AccordionSection>
</div>

<div class="d-grid sm:d-flex gap-3">
<button type="submit" class="btn-solid theme-primary" disabled="@_isSaving">
@if (_isSaving)
{
<span class="spinner-border spinner-sm me-1" role="status"></span>
<span>Saving...</span>
}
else
{
<i class="bi bi-check-lg"></i>
<span>Save settings</span>
}
</button>
<button type="button" class="btn-solid theme-secondary" @onclick="ReloadSettings" disabled="@_isSaving">
<i class="bi bi-arrow-counterclockwise"></i>Reset
</button>
</div>
</EditForm>
}

@if (_showDirectoryBrowser)
{
<DirectoryBrowser @ref="_directoryBrowser" InitialPath="@_settings.DefaultProjectsDirectory"
  OnDirectorySelected="OnDirectorySelected" OnClosed="CloseDirectoryBrowser" />
}

<ScanProjectsModal @ref="_scanProjectsModal" OnProjectsImported="OnProjectsImported" />

@code {
	[Parameter] public EventCallback OnSettingsSaved { get; set; }

	private AppSettings _settings = new();
	private bool _openProjectDefaults = true;
	private bool _openAgentQuality;
	private bool _openIdeaPrompts;
	private bool _openMarketplace;
	private bool _openErrorLogs;
	private bool _isLoading = true;
	private bool _isSaving;
	private bool _showDirectoryBrowser;
	private bool _directoryExists;
	private DirectoryBrowser? _directoryBrowser;
	private ScanProjectsModal? _scanProjectsModal;
	private IReadOnlyList<TimeZoneOption> _timeZoneOptions = [];
	private bool _isLoadingCriticalErrorLogs;
	private bool _isPruningCriticalErrorLogs;
	private List<CriticalErrorLogEntry> _criticalErrorLogs = [];
	private DeveloperModeStatus? _developerModeStatus;
	private bool _isStartingSelfUpdate;
	private bool _showGitHubToken;

	private void ToggleGitHubTokenVisibility() => _showGitHubToken = !_showGitHubToken;

	private string _placeholder => OperatingSystem.IsWindows() ? @"C:\Projects" : "/home/user/projects";
	private string _examplePath => OperatingSystem.IsWindows() ? @"C:\Projects" : "/home/user/projects";

	protected override async Task OnInitializedAsync()
	{
		_timeZoneOptions = AppTimeZoneService.GetTimeZoneOptions();
		await AppTimeZoneService.EnsureInitializedAsync();
		await LoadSettings();
	}

	private async Task LoadSettings()
	{
		_isLoading = true;

		try
		{
			_settings = await SettingsService.GetSettingsAsync();
			_settings.TimeZoneId = DateTimeHelper.ResolveTimeZone(_settings.TimeZoneId).Id;
			_timeZoneOptions = AppTimeZoneService.GetTimeZoneOptions(_settings.TimeZoneId);
			AppTimeZoneService.ApplyTimeZone(_settings.TimeZoneId);
			_developerModeStatus = await DeveloperModeService.GetStatusAsync();
			await CheckDirectoryExists();
			await LoadCriticalErrorLogs();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to load settings: {ex.Message}");
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task SaveSettings()
	{
		_isSaving = true;

		try
		{
			if (!string.IsNullOrWhiteSpace(_settings.DefaultProjectsDirectory))
			{
				_settings.DefaultProjectsDirectory = _settings.DefaultProjectsDirectory.Trim();
			}
			else
			{
				_settings.DefaultProjectsDirectory = null;
			}

			_settings.TimeZoneId = DateTimeHelper.ResolveTimeZone(_settings.TimeZoneId).Id;
			_settings = await SettingsService.UpdateSettingsAsync(_settings);
			AppTimeZoneService.ApplyTimeZone(_settings.TimeZoneId);
			await CheckDirectoryExists();
			await LoadCriticalErrorLogs();
			NotificationService.ShowSuccess("Settings saved successfully!");
			await OnSettingsSaved.InvokeAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to save settings: {ex.Message}");
		}
		finally
		{
			_isSaving = false;
		}
	}

	private async Task ReloadSettings() => await LoadSettings();

	private Task RestoreIdeaPromptDefaults()
	{
		_settings.IdeaExpansionPromptTemplate = PromptBuilder.DefaultIdeaExpansionPromptTemplate;
		_settings.IdeaImplementationPromptTemplate = PromptBuilder.DefaultIdeaImplementationPromptTemplate;
		_settings.ApprovedIdeaImplementationPromptTemplate = PromptBuilder.DefaultApprovedIdeaImplementationPromptTemplate;
		return Task.CompletedTask;
	}

	private async Task StartSelfUpdate()
	{
		_isStartingSelfUpdate = true;

		try
		{
			_developerModeStatus = await DeveloperModeService.StartSelfUpdateAsync();
			DeveloperUpdateOverlayService.SetStatus(_developerModeStatus);
			NotificationService.ShowInfo("Developer update started. The page will refresh automatically after restart.", "Developer Mode");
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to start developer update: {ex.Message}");
		}
		finally
		{
			_isStartingSelfUpdate = false;
		}
	}

	private async Task RefreshCriticalErrorLogs() => await LoadCriticalErrorLogs();

	private async Task PruneCriticalErrorLogs()
	{
		_isPruningCriticalErrorLogs = true;

		try
		{
			await CriticalErrorLogService.ApplyRetentionPolicyAsync();
			await LoadCriticalErrorLogs();
			NotificationService.ShowSuccess("Critical error log retention applied.");
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to prune critical error logs: {ex.Message}");
		}
		finally
		{
			_isPruningCriticalErrorLogs = false;
		}
	}

	private async Task LoadCriticalErrorLogs()
	{
		_isLoadingCriticalErrorLogs = true;

		try
		{
			_criticalErrorLogs = (await CriticalErrorLogService.GetRecentAsync()).ToList();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to load critical error logs: {ex.Message}");
		}
		finally
		{
			_isLoadingCriticalErrorLogs = false;
		}
	}

	private async Task CheckDirectoryExists()
	{
		if (!string.IsNullOrWhiteSpace(_settings.DefaultProjectsDirectory))
		{
			_directoryExists = await FileSystemService.DirectoryExistsAsync(_settings.DefaultProjectsDirectory);
		}
		else
		{
			_directoryExists = false;
		}
	}

	private async Task OpenDirectoryBrowser()
	{
		_showDirectoryBrowser = true;
		StateHasChanged();

		await Task.Delay(50);

		if (_directoryBrowser != null)
		{
			await _directoryBrowser.ShowAsync(_settings.DefaultProjectsDirectory);
		}
	}

	private async Task OnDirectorySelected(string path)
	{
		_settings.DefaultProjectsDirectory = path;
		_showDirectoryBrowser = false;
		await CheckDirectoryExists();
		StateHasChanged();
	}

	private void CloseDirectoryBrowser()
	{
		_showDirectoryBrowser = false;
	}

	private async Task OpenScanProjectsModal()
	{
		if (_scanProjectsModal != null)
		{
			await _scanProjectsModal.ShowAsync(_settings.DefaultProjectsDirectory);
		}
	}

	private void OnProjectsImported()
	{
		NotificationService.ShowSuccess("Projects imported successfully!");
		StateHasChanged();
	}

	private string GetDeveloperModeBadgeClass()
	{
		return _developerModeStatus?.Stage switch
		{
			DeveloperUpdateStage.Building => "badge badge-subtle theme-primary",
			DeveloperUpdateStage.Restarting => "badge badge-subtle theme-primary",
			DeveloperUpdateStage.Failed => "badge badge-subtle theme-danger",
			_ when _developerModeStatus?.SupportsSelfUpdate == true => "badge badge-subtle theme-success",
			_ => "badge badge-subtle theme-warning"
		};
	}

	private string GetDeveloperModeBadgeText()
	{
		return _developerModeStatus?.Stage switch
		{
			DeveloperUpdateStage.Building => "Building",
			DeveloperUpdateStage.Restarting => "Restarting",
			DeveloperUpdateStage.Failed => "Failed",
			_ when _developerModeStatus?.SupportsSelfUpdate == true => "Ready",
			_ => "Needs Configuration"
		};
	}
}
