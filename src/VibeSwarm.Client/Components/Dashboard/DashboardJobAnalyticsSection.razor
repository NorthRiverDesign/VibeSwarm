@* Job analytics: one chart that switches between jobs (failures stacked on completed ones),
   average duration, and tokens (output stacked on input). DashboardView owns the figures, so
   the number tiles above it read the same fetch. *@

<section class="d-flex flex-column gap-3" aria-label="Job analytics">
	<SectionHeader Title="Job analytics">
		<Actions>
			<select class="form-control form-control-sm" aria-label="Time range" disabled="@IsRefreshing"
					value="@RangeDays" @onchange="OnRangeSelectedAsync">
				@foreach (var rangeDays in RangeOptions)
				{
					<option value="@rangeDays">@FormatRangeOption(rangeDays)</option>
				}
			</select>
		</Actions>
	</SectionHeader>

	@if (IsLoading)
	{
		<LoadingSpinner />
	}
	else if (!string.IsNullOrWhiteSpace(LoadError))
	{
		<EmptyState Icon="exclamation-triangle" Title="Unable to load analytics" Message="@LoadError">
			<button type="button" class="btn-sm btn-solid theme-primary" @onclick="OnRetry">
				<i class="bi bi-arrow-clockwise"></i>Try Again
			</button>
		</EmptyState>
	}
	else if (Metrics.TotalCompletedJobs + Metrics.TotalFailedJobs == 0)
	{
		@* An empty chart would fill the screen to say one thing. *@
		<div class="list-group rounded-9">
			<div class="list-group-item d-flex align-items-center gap-5">
				<i class="bi bi-graph-up fg-2 flex-shrink-0"></i>
				<span class="flex-grow-1 min-w-0">
					<span class="d-block">No jobs finished @GetEmptyRangeText()</span>
					<span class="d-block small fg-1">Charts of jobs, duration and tokens appear once they do.</span>
				</span>
			</div>
		</div>
	}
	else
	{
		<div class="list-group rounded-9">
			<div class="list-group-item d-flex flex-column gap-5 p-5">
				<div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
					<ul class="nav gap-1 small flex-nowrap" aria-label="Chart">
						@foreach (var metric in ChartMetrics)
						{
							<li class="nav-item">
								<button type="button" class="nav-link rounded-pill px-5 @(SelectedMetric == metric ? "active" : "")"
										aria-pressed="@(SelectedMetric == metric ? "true" : "false")"
										@onclick="() => SelectedMetric = metric">
									@GetMetricLabel(metric)
								</button>
							</li>
						}
					</ul>
					<div class="d-flex flex-wrap align-items-center gap-5 small fg-1">
						@switch (SelectedMetric)
						{
							case ChartMetric.Jobs:
								<span class="d-flex align-items-center gap-3"><span class="dashboard-swatch bg-data-success"></span>Completed <strong class="fg-body tabular-nums">@Metrics.TotalCompletedJobs</strong></span>
								<span class="d-flex align-items-center gap-3"><span class="dashboard-swatch bg-data-danger"></span>Failed <strong class="fg-body tabular-nums">@Metrics.TotalFailedJobs</strong></span>
								break;
							case ChartMetric.Duration:
								<span>Average <strong class="fg-body tabular-nums">@(Metrics.AverageDurationSeconds.HasValue ? TokenHelper.FormatDuration(Metrics.AverageDurationSeconds) : "none yet")</strong></span>
								break;
							default:
								<span class="d-flex align-items-center gap-3"><span class="dashboard-swatch bg-data-warning"></span>In <strong class="fg-body tabular-nums">@FormatTokens(Metrics.TotalInputTokens)</strong></span>
								<span class="d-flex align-items-center gap-3"><span class="dashboard-swatch bg-data-violet"></span>Out <strong class="fg-body tabular-nums">@FormatTokens(Metrics.TotalOutputTokens)</strong></span>
								break;
						}
					</div>
				</div>

				@switch (SelectedMetric)
				{
					case ChartMetric.Jobs:
						<DashboardMetricChart @key="SelectedMetric" Framed="false" Title="Jobs finished"
											  Points="@GetJobChartPoints()" BarColor="var(--vs-data-success)"
											  SecondaryBarColor="var(--vs-data-danger)" UseIntegerYAxisTicks="true"
											  YAxisLabelFormatter="FormatCountAxisLabel" />
						break;
					case ChartMetric.Duration:
						<DashboardMetricChart @key="SelectedMetric" Framed="false" Title="Average job duration"
											  EmptyIcon="stopwatch" EmptyTitle="No duration data yet"
											  EmptyMessage="Average duration appears after jobs complete with timing information."
											  Points="@GetDurationChartPoints()" BarColor="var(--vs-data-info)"
											  YAxisLabelFormatter="FormatDurationAxisLabel" />
						break;
					default:
						<DashboardMetricChart @key="SelectedMetric" Framed="false" Title="Tokens"
											  EmptyIcon="arrow-down-circle" EmptyTitle="No token data yet"
											  EmptyMessage="Token usage appears once jobs with token tracking complete."
											  Points="@GetTokenChartPoints()" BarColor="var(--vs-data-warning)"
											  SecondaryBarColor="var(--vs-data-violet)"
											  YAxisLabelFormatter="FormatTokenAxisLabel" />
						break;
				}
			</div>
		</div>
	}
</section>

@code {
	public enum ChartMetric
	{
		Jobs,
		Duration,
		Tokens
	}

	private static readonly int[] RangeOptions = [1, 7, 30, 90];
	private static readonly ChartMetric[] ChartMetrics = [ChartMetric.Jobs, ChartMetric.Duration, ChartMetric.Tokens];

	[Parameter]
	public DashboardJobMetrics Metrics { get; set; } = new();

	[Parameter]
	public int RangeDays { get; set; } = 7;

	[Parameter]
	public bool IsLoading { get; set; }

	[Parameter]
	public bool IsRefreshing { get; set; }

	[Parameter]
	public string? LoadError { get; set; }

	[Parameter]
	public EventCallback<int> OnRangeChanged { get; set; }

	[Parameter]
	public EventCallback OnRetry { get; set; }

	private ChartMetric SelectedMetric { get; set; } = ChartMetric.Jobs;

	private async Task OnRangeSelectedAsync(ChangeEventArgs args)
	{
		if (int.TryParse(args.Value?.ToString(), out var rangeDays) && rangeDays != RangeDays)
		{
			await OnRangeChanged.InvokeAsync(rangeDays);
		}
	}

	private static string GetMetricLabel(ChartMetric metric) => metric switch
	{
		ChartMetric.Jobs => "Jobs",
		ChartMetric.Duration => "Duration",
		_ => "Tokens"
	};

	internal static string FormatRangeOption(int rangeDays) => rangeDays switch
	{
		1 => "Last 24 hours",
		_ => $"Last {rangeDays} days"
	};

	private string GetEmptyRangeText() => Metrics.RangeDays switch
	{
		1 => "in the last 24 hours",
		_ => $"in the last {Metrics.RangeDays} days"
	};

	private IReadOnlyList<DashboardChartPoint> GetJobChartPoints()
	{
		return Metrics.Buckets
			.Select(bucket => new DashboardChartPoint
			{
				Label = FormatBucketLabel(bucket.BucketStartUtc),
				Value = bucket.CompletedJobs,
				SecondaryValue = bucket.FailedJobs,
				ValueLabel = (bucket.CompletedJobs == 1 ? "1 completed job" : $"{bucket.CompletedJobs} completed jobs") +
					(bucket.FailedJobs > 0 ? $" · {bucket.FailedJobs} failed" : string.Empty)
			})
			.ToList();
	}

	private IReadOnlyList<DashboardChartPoint> GetDurationChartPoints()
	{
		return Metrics.Buckets
			.Select(bucket => new DashboardChartPoint
			{
				Label = FormatBucketLabel(bucket.BucketStartUtc),
				Value = bucket.AverageDurationSeconds ?? 0,
				ValueLabel = bucket.AverageDurationSeconds.HasValue
					? TokenHelper.FormatDuration(bucket.AverageDurationSeconds)
					: "No completed jobs"
			})
			.ToList();
	}

	private IReadOnlyList<DashboardChartPoint> GetTokenChartPoints()
	{
		return Metrics.Buckets
			.Select(bucket => new DashboardChartPoint
			{
				Label = FormatBucketLabel(bucket.BucketStartUtc),
				Value = bucket.TotalInputTokens,
				SecondaryValue = bucket.TotalOutputTokens,
				ValueLabel = $"{FormatTokens(bucket.TotalInputTokens)} in · {FormatTokens(bucket.TotalOutputTokens)} out"
			})
			.ToList();
	}

	private string FormatBucketLabel(DateTime bucketStartUtc)
	{
		var localTime = DateTime.SpecifyKind(bucketStartUtc, DateTimeKind.Utc).ToConfiguredTime();

		return Metrics.RangeDays switch
		{
			1 => localTime.ToString("ha").ToLowerInvariant(),
			_ => localTime.ToString("M/d")
		};
	}

	private static string FormatTokens(long tokens) => TokenHelper.FormatTokenCount((int)Math.Min(tokens, int.MaxValue));

	private static string FormatTokenAxisLabel(double value) => value <= 0
		? "0"
		: TokenHelper.FormatTokenCount((int)Math.Min(value, int.MaxValue));

	private static string FormatCountAxisLabel(double value) => Math.Round(value).ToString("0");

	private static string FormatDurationAxisLabel(double value) => value <= 0
		? "0s"
		: TokenHelper.FormatDuration(value);
}
