<section class="d-flex flex-column gap-3" aria-label="Running now">
	<SectionHeader Title="Running now">
		<Actions>
			<a href="/jobs" class="btn-sm btn-link text-decoration-none px-0">All jobs</a>
		</Actions>
	</SectionHeader>

	<div class="list-group rounded-9">
		@foreach (var item in Items)
		{
			<a href="/jobs/view/@item.Job.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-5">
				<span class="live-dot flex-shrink-0"></span>
				<span class="flex-grow-1 min-w-0">
					<span class="d-block fw-medium text-truncate">@item.Job.DisplayTitle</span>
					<span class="d-block small fg-1 text-truncate">@item.Project.Name · @GetStartedDisplay(item.Job)</span>
					@if (!string.IsNullOrWhiteSpace(item.Job.CurrentActivity))
					{
						<span class="d-block small fg-2 text-truncate">@item.Job.CurrentActivity</span>
					}
				</span>
				<i class="bi bi-chevron-right fg-2 flex-shrink-0"></i>
			</a>
		}
	</div>
</section>

@code {
	[Parameter]
	public IReadOnlyList<DashboardRunningJobInfo> Items { get; set; } = [];

	private static string GetStartedDisplay(JobSummary job)
	{
		var startedAt = job.StartedAt ?? job.CreatedAt;
		var elapsed = DateTime.UtcNow - startedAt;
		return $"running for {TokenHelper.FormatDuration(elapsed)}";
	}
}