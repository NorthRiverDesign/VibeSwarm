@* Single chat message component *@

<div class="@GetContainerClasses()">
	<div class="chat-bubble py-3 px-5 text-break @GetBubbleClasses()">
		@if (IsCombinedToolActivity)
		{
			<details>
				<summary class="fw-semibold small opacity-75">
					<i class="bi bi-tools me-1"></i>@GetToolDisplayName()
				</summary>
				@if (!string.IsNullOrEmpty(ToolInput))
				{
					<div class="mt-3">
						<div class="small fw-semibold fg-1 text-uppercase mb-1">Call</div>
						<pre class="chat-tool-code white-space-pre-wrap m-0 p-3 rounded small text-break overflow-auto"
							style="max-height: 150px;">@ToolInput</pre>
					</div>
				}
				@if (!string.IsNullOrEmpty(ToolOutput))
				{
					<div class="mt-3">
						<div class="small fw-semibold fg-1 text-uppercase mb-1">Response</div>
						<pre class="chat-tool-code white-space-pre-wrap m-0 p-3 rounded small text-break overflow-auto"
							style="max-height: 150px;">@TruncateOutput(ToolOutput, 500)</pre>
					</div>
				}
			</details>
		}
		else if (Role == MessageRole.ToolUse)
		{
			<details>
				<summary class="fw-semibold small opacity-75">
					<i class="bi bi-tools me-1"></i>@GetToolDisplayName()
				</summary>
				@if (!string.IsNullOrEmpty(ToolInput))
				{
					<pre class="chat-tool-code white-space-pre-wrap m-0 mt-3 p-3 rounded small text-break overflow-auto"
						style="max-height: 150px;">@ToolInput</pre>
				}
			</details>
		}
		else if (Role == MessageRole.ToolResult)
		{
			<details>
				<summary class="fw-semibold small opacity-75">
					<i class="bi bi-arrow-return-right me-1"></i>@GetToolDisplayName()
				</summary>
				<pre class="chat-tool-code white-space-pre-wrap m-0 mt-3 p-3 rounded small text-break overflow-auto"
					style="max-height: 150px;">@TruncateOutput(ToolOutput ?? Content ?? "", 500)</pre>
			</details>
		}
		else
		{
			<div class="@GetContentClasses()">@Content</div>
		}
	</div>
	<div class="d-flex gap-3 mt-1 px-3 small fg-secondary">
		<span class="fw-medium"><i class="@GetLabelIcon() me-1"></i>@GetLabel()</span>
		<span class="opacity-75">@Timestamp.FormatTime()</span>
	</div>
</div>

@code {
	[Parameter, EditorRequired]
	public MessageRole Role { get; set; }

	[Parameter]
	public string? Content { get; set; }

	[Parameter]
	public string? ToolName { get; set; }

	[Parameter]
	public string? ToolInput { get; set; }

	[Parameter]
	public string? ToolOutput { get; set; }

	[Parameter]
	public DateTime Timestamp { get; set; }

	[Parameter]
	public MessageSource Source { get; set; } = MessageSource.System;

	[Parameter]
	public MessageLevel Level { get; set; } = MessageLevel.Normal;

	[Parameter]
	public MessageDisplayVariant DisplayVariant { get; set; } = MessageDisplayVariant.Standard;

	[Parameter]
	public string? LabelOverride { get; set; }

	[Parameter]
	public string? BubbleClassOverride { get; set; }

	[Parameter]
	public string? IconOverride { get; set; }

	private bool IsCombinedToolActivity
		=> Role == MessageRole.ToolUse
			&& !string.IsNullOrWhiteSpace(ToolOutput);

	private static string TruncateOutput(string text, int maxLength)
	{
		if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
			return text;
		return text[..maxLength] + "\n... (truncated)";
	}

	private string GetToolDisplayName()
		=> string.IsNullOrWhiteSpace(ToolName) ? "unknown_tool" : ToolName;

	private string GetLabel()
	{
		if (!string.IsNullOrWhiteSpace(LabelOverride))
			return LabelOverride;

		if (DisplayVariant == MessageDisplayVariant.Thinking)
			return "Thinking";

		if (IsCombinedToolActivity)
			return "Tool Activity";

		return Role switch
		{
			MessageRole.User => "User",
			MessageRole.Assistant => "Provider",
			MessageRole.ToolUse => "Tool Call",
			MessageRole.ToolResult => "Tool Result",
			MessageRole.System => Source switch
			{
				MessageSource.Provider => "Provider",
				MessageSource.User => "User",
				_ => "System"
			},
			_ => Role.ToString()
		};
	}

	private string GetBubbleClasses()
	{
		if (!string.IsNullOrWhiteSpace(BubbleClassOverride))
			return BubbleClassOverride;

		if (DisplayVariant == MessageDisplayVariant.Thinking)
			return "bg-subtle-secondary fg-emphasis-secondary border border-subtle-secondary";

		if (IsCombinedToolActivity)
			return "bg-subtle-info fg-emphasis-info border";

		if (Role == MessageRole.System)
		{
			return Level switch
			{
				MessageLevel.Success => "bg-subtle-success fg-emphasis-success border border-subtle-success",
				MessageLevel.Warning => "bg-subtle-warning fg-emphasis-warning border border-subtle-warning",
				MessageLevel.Error => "bg-subtle-danger fg-emphasis-danger border border-subtle-danger",
				_ => "bg-subtle-primary fg-emphasis-primary border border-subtle-primary"
			};
		}

		return Role switch
		{
			MessageRole.User => "bg-primary fg-white",
			MessageRole.Assistant => "bg-2 border",
			MessageRole.ToolUse => "bg-subtle-info fg-emphasis-info border",
			MessageRole.ToolResult => "bg-subtle-success fg-emphasis-success border",
			_ => ""
		};
	}

	private string GetLabelIcon()
	{
		if (!string.IsNullOrWhiteSpace(IconOverride))
			return IconOverride;

		if (DisplayVariant == MessageDisplayVariant.Thinking)
			return "bi bi-lightbulb";

		if (IsCombinedToolActivity)
			return "bi bi-tools";

		if (Role == MessageRole.System)
		{
			return Level switch
			{
				MessageLevel.Success => "bi bi-check-circle",
				MessageLevel.Warning => "bi bi-exclamation-triangle",
				MessageLevel.Error => "bi bi-x-circle",
				_ => "bi bi-info-circle"
			};
		}

		return Role switch
		{
			MessageRole.User => "bi bi-person-circle",
			MessageRole.Assistant => "bi bi-stars",
			MessageRole.ToolUse => "bi bi-tools",
			MessageRole.ToolResult => "bi bi-arrow-return-right",
			_ => "bi bi-chat-left-text"
		};
	}

	private string GetContainerClasses()
	{
		var roleClass = DisplayVariant == MessageDisplayVariant.Thinking
			? "chat-message-thinking"
			: $"chat-message-{Role.ToString().ToLower()}";
		var indentClass = Role is MessageRole.ToolUse or MessageRole.ToolResult ? " ms-5" : string.Empty;
		return $"chat-message d-flex flex-column {roleClass}{indentClass}";
	}

	private string GetContentClasses()
		=> DisplayVariant == MessageDisplayVariant.Thinking
			? "white-space-pre-wrap m-0 lh-md fst-italic"
			: "white-space-pre-wrap m-0 lh-md";
}
