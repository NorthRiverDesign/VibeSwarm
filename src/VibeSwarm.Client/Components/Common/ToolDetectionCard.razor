@* Tool Detection Card - Shows status of detected CLI tools with install support *@
@inject HttpClient Http

<div class="d-flex flex-column gap-3">
	<div class="d-flex align-items-center gap-5 px-1">
		<h2 class="text-eyebrow mb-0 me-auto">Tools on this host</h2>
		<button type="button" class="btn-sm btn-link text-decoration-none px-0" @onclick="DetectTools" disabled="@(_isLoading || _isInstalling != null)">
			<i class="bi bi-arrow-clockwise @(_isLoading ? "spinner-rotate" : "")"></i>Check again
		</button>
	</div>
	<div class="border rounded-9 p-5">
		@if (_isLoading)
		{
			<div class="d-flex align-items-center gap-3 fg-1">
				<span class="spinner-border spinner-sm" role="status"></span>
				<span>Detecting tools...</span>
			</div>
		}
		else
		{
			<ul class="list-unstyled mb-0">
				@* Git *@
				<li class="d-flex align-items-center gap-3 mb-3">
					<i class="bi bi-git fg-danger"></i>
					<span class="flex-grow-1">Git</span>
					@if (_gitAvailable)
					{
						<span class="badge badge-subtle theme-success">
							<i class="bi bi-check-circle"></i>Available
						</span>
					}
					else
					{
						<span class="badge badge-subtle theme-danger me-1">
							<i class="bi bi-x-circle"></i>Not Found
						</span>
						<button type="button" class="btn-sm btn-solid theme-primary"
								@onclick='() => InstallTool("git")'
								disabled="@(_isInstalling != null)">
							@if (_isInstalling == "git")
							{
								<span class="spinner-border spinner-sm me-1" role="status"></span>
								<span>Installing...</span>
							}
							else
							{
								<i class="bi bi-download"></i>
								<span>Install</span>
							}
						</button>
					}
				</li>

				@* GitHub CLI *@
				<li class="d-flex align-items-center gap-3 mb-3">
					<i class="bi bi-github"></i>
					<span class="flex-grow-1">GitHub CLI</span>
					@if (_ghAvailable)
					{
						<span class="badge badge-subtle theme-success">
							<i class="bi bi-check-circle"></i>Available
						</span>
					}
					else
					{
						<span class="badge badge-subtle theme-danger me-1">
							<i class="bi bi-x-circle"></i>Not Found
						</span>
						<button type="button" class="btn-sm btn-solid theme-primary"
								@onclick='() => InstallTool("gh")'
								disabled="@(_isInstalling != null)">
							@if (_isInstalling == "gh")
							{
								<span class="spinner-border spinner-sm me-1" role="status"></span>
								<span>Installing...</span>
							}
							else
							{
								<i class="bi bi-download"></i>
								<span>Install</span>
							}
						</button>
					}
				</li>

				@* GitHub CLI Auth Status (sub-status) *@
				@if (_ghAvailable)
				{
					<li class="d-flex align-items-center gap-3 ps-7">
						<i class="bi bi-shield-lock opacity-50"></i>
						<span class="flex-grow-1 fg-1 small">Authentication</span>
						@if (_ghAuthenticated)
						{
							<span class="badge badge-subtle theme-success">
								<i class="bi bi-check-circle"></i>Authenticated
							</span>
						}
						else
						{
							<span class="badge badge-subtle theme-warning">
								<i class="bi bi-exclamation-triangle"></i>Not Authenticated
							</span>
						}
					</li>
				}

				@* Separator *@
				<li><hr class="my-3"></li>

				@* Section header for optional browser tools *@
				<li class="mb-3">
					<span class="small fw-semibold fg-1 text-uppercase">Browser Tools</span>
					<span class="small fg-1 ms-1">(optional)</span>
				</li>

				@* Node.js *@
				<li class="d-flex align-items-center gap-3 mb-3">
					<i class="bi bi-node-plus fg-success"></i>
					<span class="flex-grow-1">Node.js</span>
					@if (_nodeAvailable)
					{
						<span class="badge badge-subtle theme-success">
							<i class="bi bi-check-circle"></i>@(_nodeVersion ?? "Available")
						</span>
					}
					else
					{
						<span class="badge badge-subtle theme-secondary me-1">
							<i class="bi bi-dash-circle"></i>Not Found
						</span>
						<button type="button" class="btn-sm btn-solid theme-secondary"
								@onclick='() => InstallTool("nodejs")'
								disabled="@(_isInstalling != null)">
							@if (_isInstalling == "nodejs")
							{
								<span class="spinner-border spinner-sm me-1" role="status"></span>
								<span>Installing...</span>
							}
							else
							{
								<i class="bi bi-download"></i>
								<span>Install</span>
							}
						</button>
					}
				</li>

				@* Playwright Chromium *@
				<li class="d-flex align-items-center gap-3 mb-3">
					<i class="bi bi-browser-chrome fg-primary"></i>
					<span class="flex-grow-1">Playwright Chromium</span>
					@if (_playwrightInstalled)
					{
						<span class="badge badge-subtle theme-success">
							<i class="bi bi-check-circle"></i>Installed
						</span>
					}
					else if (!_nodeAvailable)
					{
						<span class="badge badge-subtle theme-secondary">
							<i class="bi bi-dash-circle"></i>Requires Node.js
						</span>
					}
					else
					{
						<span class="badge badge-subtle theme-secondary me-1">
							<i class="bi bi-dash-circle"></i>Not Installed
						</span>
						<button type="button" class="btn-sm btn-solid theme-secondary"
								@onclick='() => InstallTool("playwright")'
								disabled="@(_isInstalling != null)">
							@if (_isInstalling == "playwright")
							{
								<span class="spinner-border spinner-sm me-1" role="status"></span>
								<span>Installing...</span>
							}
							else
							{
								<i class="bi bi-download"></i>
								<span>Install</span>
							}
						</button>
					}
				</li>

				@* Playwright status detail *@
				@if (_playwrightStatus != null && !_playwrightInstalled)
				{
					<li class="d-flex align-items-center gap-3 ps-7">
						<i class="bi bi-info-circle opacity-50"></i>
						<span class="small fg-1">@_playwrightStatus</span>
					</li>
				}
			</ul>

			@if (_installResult != null)
			{
				<div class="mt-5 border rounded p-3 @(_installResult.Success ? "border-subtle-success bg-subtle-success" : "border-subtle-danger bg-subtle-danger")">
					<div class="d-flex align-items-center gap-3 mb-1">
						@if (_installResult.Success)
						{
							<i class="bi bi-check-circle fg-success"></i>
							<span class="small fw-semibold fg-emphasis-success">Installation complete</span>
						}
						else
						{
							<i class="bi bi-x-circle fg-danger"></i>
							<span class="small fw-semibold fg-emphasis-danger">Installation failed</span>
						}
						<button type="button" class="btn-close ms-auto" @onclick="() => _installResult = null"></button>
					</div>
					@if (!string.IsNullOrWhiteSpace(_installResult.Output))
					{
						<pre class="mb-0 fg-body white-space-pre-wrap text-xs @(_installResult.Success ? "fg-emphasis-success" : "fg-emphasis-danger")" style="max-height: 200px; overflow-y: auto;">@_installResult.Output</pre>
					}
					@if (!_installResult.Success && !string.IsNullOrWhiteSpace(_installResult.Error))
					{
						<pre class="mb-0 fg-emphasis-danger white-space-pre-wrap text-xs" style="max-height: 200px; overflow-y: auto;">@_installResult.Error</pre>
					}
				</div>
			}

			@if (_error != null)
			{
				<div class="fg-danger small mt-3">
					<i class="bi bi-exclamation-triangle me-1"></i>@_error
				</div>
			}
		}
	</div>
</div>

@code {
	private bool _isLoading = true;
	private bool _gitAvailable;
	private bool _ghAvailable;
	private bool _ghAuthenticated;
	private bool _nodeAvailable;
	private string? _nodeVersion;
	private bool _playwrightInstalled;
	private string? _playwrightStatus;
	private string? _error;
	private string? _isInstalling;
	private InstallResult? _installResult;

	protected override async Task OnInitializedAsync()
	{
		await DetectTools();
	}

	private async Task DetectTools()
	{
		_isLoading = true;
		_error = null;
		StateHasChanged();

		try
		{
			var gitTask = Http.GetAsync("/api/git/detected-tools");
			var systemTask = Http.GetAsync("/api/system-tools/detected");
			await Task.WhenAll(gitTask, systemTask);

			var gitResponse = gitTask.Result;
			if (gitResponse.IsSuccessStatusCode)
			{
				var result = await gitResponse.Content.ReadFromJsonAsync<DetectedToolsResult>();
				if (result != null)
				{
					_gitAvailable = result.GitAvailable;
					_ghAvailable = result.GitHubCliAvailable;
					_ghAuthenticated = result.GitHubCliAuthenticated;
				}
			}
			else
			{
				_error = "Failed to detect git tools";
			}

			var systemResponse = systemTask.Result;
			if (systemResponse.IsSuccessStatusCode)
			{
				var result = await systemResponse.Content.ReadFromJsonAsync<SystemToolsResult>();
				if (result != null)
				{
					_nodeAvailable = result.NodeAvailable;
					_nodeVersion = result.NodeVersion;
					_playwrightInstalled = result.PlaywrightBrowsersInstalled;
					_playwrightStatus = result.PlaywrightStatus;
				}
			}
		}
		catch (Exception ex)
		{
			_error = $"Error detecting tools: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private async Task InstallTool(string tool)
	{
		_isInstalling = tool;
		_installResult = null;
		StateHasChanged();

		try
		{
			var response = await Http.PostAsync($"/api/system-tools/install/{tool}", null);
			var result = await response.Content.ReadFromJsonAsync<InstallResponse>();
			if (result != null)
			{
				_installResult = new InstallResult(result.Success, result.Output, result.Error);
				if (result.Success)
				{
					await DetectTools();
				}
			}
			else
			{
				_installResult = new InstallResult(false, null, "Unexpected response from server.");
			}
		}
		catch (Exception ex)
		{
			_installResult = new InstallResult(false, null, $"Error: {ex.Message}");
		}
		finally
		{
			_isInstalling = null;
			StateHasChanged();
		}
	}

	private sealed class DetectedToolsResult
	{
		public bool GitAvailable { get; set; }
		public bool GitHubCliAvailable { get; set; }
		public bool GitHubCliAuthenticated { get; set; }
	}

	private sealed class SystemToolsResult
	{
		public bool NodeAvailable { get; set; }
		public string? NodeVersion { get; set; }
		public bool NpxAvailable { get; set; }
		public bool PlaywrightBrowsersInstalled { get; set; }
		public string? PlaywrightStatus { get; set; }
	}

	private sealed class InstallResponse
	{
		public bool Success { get; set; }
		public string? Output { get; set; }
		public string? Error { get; set; }
	}

	private sealed record InstallResult(bool Success, string? Output, string? Error);
}
