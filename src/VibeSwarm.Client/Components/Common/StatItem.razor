@* Reusable stat display component for key-value pairs *@

<div class="bg-2 rounded-4 p-3 @(FlexGrow ? "flex-grow-1" : "")">
	<div class="fg-1 mb-1 text-eyebrow">
		@Label
	</div>
	<div class="fw-semibold @(Monospace ? "font-monospace small" : "")">
		@if (ChildContent != null)
		{
			@ChildContent
		}
		else
		{
			@Value
		}
	</div>
</div>

@code {
	[Parameter]
	public string Label { get; set; } = string.Empty;

	[Parameter]
	public string? Value { get; set; }

	[Parameter]
	public bool Monospace { get; set; }

	[Parameter]
	public bool FlexGrow { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}