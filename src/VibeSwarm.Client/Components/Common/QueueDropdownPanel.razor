@inject IIdeaService IdeaService
@inject IJobQueueControlService JobQueueControl
@inject NotificationService NotificationService
@inject QueuePanelStateService QueuePanelStateService
@implements IDisposable

<div class="@(Compact ? "mobile-header-dropdown" : string.Empty)">
	<button class="btn-link fg-secondary p-0 fs-lg d-flex align-items-center justify-content-center position-relative touch-manipulation @(Compact ? "mobile-header-icon" : "lh-1")"
			type="button"
			data-bs-toggle="menu" data-bs-placement="@(OpenUpward ? "top-end" : "bottom-end")"
			data-bs-display="@(Compact ? "static" : null)"
			aria-expanded="false"
			title="Queue"
			aria-label="Queue"
			@onclick="HandleToggleAsync">
		<i class="bi @(_queueState.IsPaused ? "bi-pause-circle-fill fg-warning" : "bi-list-task")"></i>
		@if (BadgeCount > 0)
		{
			<span class="notification-bell-badge position-absolute badge rounded-pill theme-primary"
				  aria-label="@BadgeCount queue item@(BadgeCount == 1 ? string.Empty : "s")">
				@(BadgeCount > 9 ? "9+" : BadgeCount.ToString())
			</span>
		}
	</button>

	<div class="menu vs-nav-dropdown-menu p-0 overflow-hidden" style="min-width: min(24rem, 92vw); max-width: min(24rem, 92vw);">
		<div class="p-5 border-bottom bg-2">
			<div class="d-flex align-items-start justify-content-between gap-5">
				<div class="min-w-0">
					<div class="fw-semibold">Queue</div>
					<div class="small fg-1">
						@_snapshot.RunningJobsCount running
						@if (_snapshot.QueuedJobsCount > 0)
						{
							<span class="mx-1">&bull;</span>
							<span>@_snapshot.QueuedJobsCount queued</span>
						}
						<span class="mx-1">&bull;</span>
						@_snapshot.UpcomingIdeasCount upcoming
					</div>
				</div>
				<span class="badge @QueueStatusClass">@QueueStatusLabel</span>
			</div>

			@if (_queueState.IsPaused)
			{
				<div class="small fg-emphasis-warning mt-3">
					<i class="bi bi-pause-circle me-1"></i>
					@(_queueState.RunningJobs > 0
						? "Nothing new will start. Jobs already running are finishing."
						: "Stopped. Nothing will start until you start it again.")
				</div>
			}

			@* One button, and it does the obvious thing. Stopping work that is already
			   running is offered afterwards, so a tap can never throw away a job by
			   accident. *@
			<div class="d-grid gap-3 mt-5">
				@if (_queueState.IsPaused)
				{
					<button type="button" class="btn-solid theme-primary btn-lg" @onclick="ResumeQueueAsync" disabled="@_isMutatingQueue">
						@if (_isMutatingQueue)
						{
							<span class="spinner-border spinner-sm me-3" role="status"></span>
						}
						else
						{
							<i class="bi bi-play-fill me-3"></i>
						}
						Start queue
					</button>

					@if (_queueState.RunningJobs > 0)
					{
						<button type="button" class="btn-outline theme-danger" @onclick="() => StopQueueAsync(true)" disabled="@_isMutatingQueue">
							<i class="bi bi-stop-fill me-3"></i>
							Also stop @_queueState.RunningJobs job@(_queueState.RunningJobs == 1 ? "" : "s") still finishing
						</button>
					}
				}
				else if (IsQueueRunning)
				{
					<button type="button" class="btn-solid theme-danger btn-lg" @onclick="() => StopQueueAsync(false)" disabled="@_isMutatingQueue">
						@if (_isMutatingQueue)
						{
							<span class="spinner-border spinner-sm me-3" role="status"></span>
						}
						else
						{
							<i class="bi bi-stop-fill me-3"></i>
						}
						Stop queue
					</button>
				}
				else if (CanStartIdeas)
				{
					<button type="button" class="btn-solid theme-primary btn-lg" @onclick="StartQueueAsync" disabled="@_isMutatingQueue">
						@if (_isMutatingQueue)
						{
							<span class="spinner-border spinner-sm me-3" role="status"></span>
						}
						else
						{
							<i class="bi bi-play-fill me-3"></i>
						}
						Start queued ideas
					</button>
				}

				<a class="btn-solid theme-secondary" href="/jobs">
					<i class="bi bi-box-arrow-up-right me-3"></i>All jobs
				</a>
			</div>

			@if (IsQueueRunning && CanStartIdeas)
			{
				<button type="button" class="btn-sm btn-link px-0 mt-1" @onclick="StartQueueAsync" disabled="@_isMutatingQueue">
					<i class="bi bi-play-circle me-1"></i>Start queued ideas across active projects
				</button>
			}
		</div>

		@if (!string.IsNullOrWhiteSpace(_loadError))
		{
			<div class="px-5 py-3 border-bottom small fg-danger">
				<i class="bi bi-exclamation-circle me-1"></i>@_loadError
			</div>
		}

		@if (!_hasLoadedSnapshot && _isLoadingSnapshot)
		{
			<div class="p-5 small fg-1 d-flex align-items-center gap-3">
				<span class="spinner-border spinner-sm" role="status"></span>
				<span>Loading queue...</span>
			</div>
		}
		else if (TotalItemCount == 0)
		{
			<div class="p-5 small fg-1">
				No running or queued jobs or upcoming ideas.
			</div>
		}
		else
		{
			<div class="overflow-y-auto pb-3" style="max-height: min(28rem, 70vh);">
				@if (_snapshot.RunningJobs.Count > 0)
				{
					<div class="text-eyebrow px-5 pt-5 pb-3">Running</div>
					<div class="list-group list-group-flush">
						@foreach (var job in _snapshot.RunningJobs)
						{
							<JobRow @key="job.Id" Job="@ToJobSummary(job)" ShowProjectName="true" />
						}
					</div>
				}

				@if (_snapshot.QueuedJobs.Count > 0)
				{
					<div class="text-eyebrow px-5 pt-5 pb-3">Queued</div>
					<div class="list-group list-group-flush">
						@foreach (var job in _snapshot.QueuedJobs)
						{
							<JobRow @key="job.Id" Job="@ToJobSummary(job)" ShowProjectName="true"
									TrailingText="@job.CreatedAt.FormatShortAge()" />
						}
					</div>
				}

				@if (_snapshot.UpcomingIdeas.Count > 0)
				{
					<div class="text-eyebrow px-5 pt-5 pb-3">Upcoming ideas</div>
					<div class="list-group list-group-flush">
						@foreach (var idea in _snapshot.UpcomingIdeas)
						{
							var isQueued = idea.IsProjectProcessing || idea.HasQueuedJob;
							<ListRow @key="idea.IdeaId"
									 Href="@($"/projects/{idea.ProjectId}")"
									 Icon="@(isQueued ? "hourglass-split" : "lightbulb")"
									 IconClass="@(isQueued ? "fg-warning" : "fg-2")"
									 Title="@idea.Description"
									 Subtitle="@idea.ProjectName">
								<Trailing>
									<span class="small fg-1 flex-shrink-0">@(isQueued ? "Queued" : "Pending")</span>
								</Trailing>
							</ListRow>
						}
					</div>
				}
			</div>
		}
	</div>
</div>

@code {
	[Parameter]
	public bool Compact { get; set; }

	[Parameter]
	public bool OpenUpward { get; set; }

	private GlobalQueueSnapshot _snapshot = new();
	private bool _hasLoadedSnapshot;
	private bool _isLoadingSnapshot;
	private bool _pendingRefresh;
	private bool _isMutatingQueue;
	private string? _loadError;

	private JobQueueState _queueState = new();

	private bool IsQueueActive => _snapshot.ProjectsCurrentlyProcessing > 0;

	/// <summary>
	/// Something is running, waiting to start, or being fed by idea processing, so there is
	/// something for Stop queue to stop. An idle queue offers no Stop.
	/// </summary>
	private bool IsQueueRunning => !_queueState.IsPaused && (_queueState.RunningJobs > 0 || BadgeCount > 0 || IsQueueActive);

	private bool CanStartIdeas => !_queueState.IsPaused && _snapshot.UpcomingIdeasCount > 0 && !IsQueueActive;

	private string QueueStatusLabel => _queueState.IsPaused
		? "Paused"
		: IsQueueRunning ? "Running" : "Idle";

	private string QueueStatusClass => _queueState.IsPaused
		? "bg-warning fg-contrast-warning"
		: IsQueueRunning ? "bg-info fg-contrast-info" : "bg-1 fg-body";
	private int BadgeCount => _snapshot.RunningJobsCount + _snapshot.QueuedJobsCount;
	private int TotalItemCount => BadgeCount + _snapshot.UpcomingIdeasCount;

	private static JobSummary ToJobSummary(GlobalQueueJobSummary job) => new()
	{
		Id = job.Id,
		Title = job.Title,
		GoalPrompt = job.GoalPrompt,
		Status = job.Status,
		ProjectId = job.ProjectId,
		ProjectName = job.ProjectName,
		ProviderName = job.ProviderName,
		CurrentActivity = job.CurrentActivity,
		CreatedAt = job.CreatedAt,
		StartedAt = job.StartedAt
	};

	protected override async Task OnInitializedAsync()
	{
		QueuePanelStateService.RefreshRequested += RefreshQueueAsync;
		await RefreshQueueAsync();
	}

	private async Task HandleToggleAsync()
	{
		await RefreshQueueAsync();
	}

	private async Task RefreshQueueAsync()
	{
		if (_isLoadingSnapshot)
		{
			_pendingRefresh = true;
			return;
		}

		do
		{
			_pendingRefresh = false;
			_isLoadingSnapshot = true;

			try
			{
				_snapshot = await IdeaService.GetGlobalQueueSnapshotAsync();
				_queueState = await JobQueueControl.GetStateAsync();
				_loadError = null;
				_hasLoadedSnapshot = true;
			}
			catch (Exception ex)
			{
				_loadError = $"Failed to load queue: {ex.Message}";
			}
			finally
			{
				_isLoadingSnapshot = false;
			}

			await InvokeAsync(StateHasChanged);
		}
		while (_pendingRefresh);
	}

	private async Task StartQueueAsync()
	{
		if (_isMutatingQueue || _snapshot.UpcomingIdeasCount == 0)
		{
			return;
		}

		_isMutatingQueue = true;
		try
		{
			await IdeaService.StartAllProcessingAsync();
			NotificationService.ShowSuccess("Started queued ideas across active projects.", "Queue started");
			await RefreshQueueAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to start queue: {ex.Message}");
		}
		finally
		{
			_isMutatingQueue = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	/// <summary>
	/// Stops the queue for real: no new jobs start, and idea auto-processing stops feeding
	/// it. <paramref name="cancelRunning"/> also stops the jobs already in flight.
	/// </summary>
	private async Task StopQueueAsync(bool cancelRunning)
	{
		if (_isMutatingQueue)
		{
			return;
		}

		_isMutatingQueue = true;
		try
		{
			var state = await JobQueueControl.PauseAsync("Stopped from the queue panel", cancelRunning);

			// Leaving idea processing on would keep converting ideas into jobs that then
			// pile up pending, which is not what "stop" means to anyone.
			try
			{
				await IdeaService.StopAllProcessingAsync();
			}
			catch
			{
				// The queue is already stopped; idea processing can be stopped separately.
			}

			NotificationService.ShowSuccess(
				cancelRunning
					? $"Queue stopped. {state.CancelledJobs} running job{(state.CancelledJobs == 1 ? string.Empty : "s")} asked to stop."
					: "Queue stopped. Running jobs will finish.",
				"Queue stopped");

			await RefreshQueueAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to stop queue: {ex.Message}");
		}
		finally
		{
			_isMutatingQueue = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task ResumeQueueAsync()
	{
		if (_isMutatingQueue)
		{
			return;
		}

		_isMutatingQueue = true;
		try
		{
			await JobQueueControl.ResumeAsync();
			NotificationService.ShowSuccess("Queue resumed. Pending jobs will start again.", "Queue resumed");
			await RefreshQueueAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to resume queue: {ex.Message}");
		}
		finally
		{
			_isMutatingQueue = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	public void Dispose()
	{
		QueuePanelStateService.RefreshRequested -= RefreshQueueAsync;
	}
}
