@inject IIdeaService IdeaService
@inject IJobQueueControlService JobQueueControl
@inject NotificationService NotificationService
@inject QueuePanelStateService QueuePanelStateService
@implements IDisposable

<div class="@(Compact ? "mobile-header-dropdown" : string.Empty)">
	<button class="btn-link fg-secondary p-0 fs-lg d-flex position-relative touch-manipulation @(Compact ? "mobile-header-icon" : "lh-1")"
			type="button"
			data-bs-toggle="menu" data-bs-placement="@(OpenUpward ? "top-end" : "bottom-end")"
			data-bs-display="@(Compact ? "static" : null)"
			aria-expanded="false"
			title="Queue"
			aria-label="Queue"
			@onclick="HandleToggleAsync">
		<i class="bi @(_queueState.IsPaused ? "bi-pause-circle-fill fg-warning" : "bi-list-task")"></i>
		@if (BadgeCount > 0)
		{
			<span class="notification-bell-badge position-absolute badge rounded-pill theme-primary"
				  aria-label="@BadgeCount queue item@(BadgeCount == 1 ? string.Empty : "s")">
				@(BadgeCount > 9 ? "9+" : BadgeCount.ToString())
			</span>
		}
	</button>

	<div class="menu menu-panel @(OpenUpward ? "menu-panel-up" : null) shadow-xl shadow-opacity-100 p-0 overflow-hidden"
		 style="min-width: min(24rem, 92vw); max-width: min(24rem, 92vw); --bs-menu-max-height: min(40rem, 75dvh);">
		@* The header says what the queue is doing and offers the one button that does the obvious
		   thing. Stopping work already running is offered only after the queue is stopped, so a tap
		   can never throw a job away by accident. *@
		<div class="d-flex flex-column gap-5 p-5 border-bottom flex-shrink-0">
			<div class="d-flex flex-column gap-1">
				<div class="d-flex align-items-center gap-3">
					<h2 class="mb-0 me-auto">Queue</h2>
					<span class="badge badge-subtle @QueueStatusTheme flex-shrink-0">
						@if (QueueStatusLabel == "Running")
						{
							<span class="live-dot"></span>
						}
						@QueueStatusLabel
					</span>
				</div>
				@if (QueueSummary is { Count: > 0 } summary)
				{
					@* Each count stays whole, so a wrapped line never strands a number. *@
					<p class="small fg-1 mb-0">
						@for (var i = 0; i < summary.Count; i++)
						{
							@(i > 0 ? " · " : null)<span class="text-nowrap">@summary[i]</span>
						}
					</p>
				}
				@if (_queueState.IsPaused)
				{
					<p class="small fg-emphasis-warning mb-0">
						@(_queueState.RunningJobs > 0
							? "Nothing new will start. Jobs already running are finishing."
							: "Nothing will start until you start it again.")
					</p>
				}
			</div>

			@if (!IsQuiet)
			{
				<div class="d-flex flex-column gap-3">
					@if (_queueState.IsPaused)
					{
						<button type="button" class="btn-solid theme-primary rounded-pill" @onclick="ResumeQueueAsync" disabled="@_isMutatingQueue">
							@if (_isMutatingQueue)
							{
								<span class="spinner-border spinner-sm" role="status"></span>
							}
							else
							{
								<i class="bi bi-play-fill"></i>
							}
							Start queue
						</button>
					}
					else if (IsQueueRunning)
					{
						<button type="button" class="btn-outline theme-danger rounded-pill" @onclick="() => StopQueueAsync(false)" disabled="@_isMutatingQueue">
							@if (_isMutatingQueue)
							{
								<span class="spinner-border spinner-sm" role="status"></span>
							}
							else
							{
								<i class="bi bi-stop-fill"></i>
							}
							Stop queue
						</button>
					}
					else if (CanStartIdeas)
					{
						<button type="button" class="btn-solid theme-primary rounded-pill" @onclick="StartQueueAsync" disabled="@_isMutatingQueue">
							@if (_isMutatingQueue)
							{
								<span class="spinner-border spinner-sm" role="status"></span>
							}
							else
							{
								<i class="bi bi-play-fill"></i>
							}
							Start queued ideas
						</button>
					}

					<div class="d-flex align-items-center gap-5">
						@if (_queueState.IsPaused && _queueState.RunningJobs > 0)
						{
							<button type="button" class="btn-sm btn-link fg-danger text-decoration-none px-0 text-start" @onclick="() => StopQueueAsync(true)" disabled="@_isMutatingQueue">
								Also stop @_queueState.RunningJobs job@(_queueState.RunningJobs == 1 ? "" : "s") still finishing
							</button>
						}
						else if (IsQueueRunning && CanStartIdeas)
						{
							<button type="button" class="btn-sm btn-link text-decoration-none px-0" @onclick="StartQueueAsync" disabled="@_isMutatingQueue"
									title="Start queued ideas across active projects">
								Start queued ideas
							</button>
						}
						<a href="/jobs" class="btn-sm btn-link text-decoration-none px-0 ms-auto flex-shrink-0">All jobs</a>
					</div>
				</div>
			}
		</div>

		@if (!string.IsNullOrWhiteSpace(_loadError))
		{
			<div class="px-5 py-3 border-bottom small fg-danger flex-shrink-0">
				<i class="bi bi-exclamation-circle me-1"></i>@_loadError
			</div>
		}

		@if (!_hasLoadedSnapshot && _isLoadingSnapshot)
		{
			<div class="p-5 small fg-1 d-flex align-items-center gap-3">
				<span class="spinner-border spinner-sm" role="status"></span>
				<span>Loading queue...</span>
			</div>
		}
		else if (TotalItemCount == 0)
		{
			<div class="d-flex flex-column align-items-center gap-3 p-7 fg-1">
				<i class="bi bi-check2-circle fs-3xl fg-2"></i>
				<span class="small">Nothing running or queued</span>
				@if (IsQuiet)
				{
					<a href="/jobs" class="btn-sm btn-link text-decoration-none">All jobs</a>
				}
			</div>
		}
		else
		{
			@* Grouped by state, and every row has one shape: status glyph, title, the project on the
			   second line, a short fact on the right, and a chevron. *@
			var activeJobs = _snapshot.RunningJobs.Where(job => !NeedsYou(job)).ToList();
			var needsYouJobs = _snapshot.RunningJobs.Where(NeedsYou).ToList();
			<div class="overflow-y-auto overscroll-contain min-h-0">
				<div class="d-flex flex-column gap-7 px-3 py-5">
					@if (activeJobs.Count > 0)
					{
						<section class="d-flex flex-column gap-3">
							<SectionHeader Title="Running" />
							<div class="list-group rounded-9">
								@foreach (var job in activeJobs)
								{
									<ListRow @key="job.Id" Href="@GetJobHref(job)" Title="@job.DisplayTitle" Subtitle="@GetRunningSubtitle(job)">
										<Leading><JobStatusIcon Status="@job.Status" /></Leading>
										<Trailing>@RenderSince(job.StartedAt ?? job.CreatedAt, "Started")</Trailing>
									</ListRow>
								}
							</div>
						</section>
					}

					@if (needsYouJobs.Count > 0)
					{
						<section class="d-flex flex-column gap-3">
							<SectionHeader Title="Needs you" />
							<div class="list-group rounded-9">
								@foreach (var job in needsYouJobs)
								{
									<ListRow @key="job.Id" Href="@GetJobHref(job)" Title="@job.DisplayTitle" AttentionLine="@GetAttentionLine(job)">
										<Leading><JobStatusIcon Status="@job.Status" /></Leading>
										<Trailing>@RenderSince(job.StartedAt ?? job.CreatedAt, "Started")</Trailing>
									</ListRow>
								}
							</div>
						</section>
					}

					@if (_snapshot.QueuedJobs.Count > 0)
					{
						<section class="d-flex flex-column gap-3">
							<SectionHeader Title="Queued" />
							<div class="list-group rounded-9">
								@foreach (var job in _snapshot.QueuedJobs)
								{
									<ListRow @key="job.Id" Href="@GetJobHref(job)" Title="@job.DisplayTitle" Subtitle="@GetProjectLabel(job.ProjectName)">
										<Leading><JobStatusIcon Status="@job.Status" /></Leading>
										<Trailing>@RenderSince(job.CreatedAt, "Queued")</Trailing>
									</ListRow>
								}
							</div>
						</section>
					}

					@if (_snapshot.UpcomingIdeas.Count > 0)
					{
						<section class="d-flex flex-column gap-3">
							<SectionHeader Title="Upcoming ideas" />
							<div class="list-group rounded-9">
								@foreach (var idea in _snapshot.UpcomingIdeas)
								{
									var isQueued = idea.IsProjectProcessing || idea.HasQueuedJob;
									<ListRow @key="idea.IdeaId"
											 Href="@($"/projects/{idea.ProjectId}")"
											 Icon="@(isQueued ? "hourglass-split" : "lightbulb")"
											 IconClass="@(isQueued ? "fg-warning" : "fg-2")"
											 Title="@idea.Description"
											 Subtitle="@GetProjectLabel(idea.ProjectName)">
										<Trailing>
											<span class="small fg-1 flex-shrink-0">@(isQueued ? "Queued" : "Pending")</span>
										</Trailing>
									</ListRow>
								}
							</div>
						</section>
					}
				</div>
			</div>
		}
	</div>
</div>

@code {
	[Parameter]
	public bool Compact { get; set; }

	[Parameter]
	public bool OpenUpward { get; set; }

	private GlobalQueueSnapshot _snapshot = new();
	private bool _hasLoadedSnapshot;
	private bool _isLoadingSnapshot;
	private bool _pendingRefresh;
	private bool _isMutatingQueue;
	private string? _loadError;

	private JobQueueState _queueState = new();

	private bool IsQueueActive => _snapshot.ProjectsCurrentlyProcessing > 0;

	/// <summary>
	/// Something is running, waiting to start, or being fed by idea processing, so there is
	/// something for Stop queue to stop. An idle queue offers no Stop.
	/// </summary>
	private bool IsQueueRunning => !_queueState.IsPaused && (_queueState.RunningJobs > 0 || BadgeCount > 0 || IsQueueActive);

	private bool CanStartIdeas => !_queueState.IsPaused && _snapshot.UpcomingIdeasCount > 0 && !IsQueueActive;

	// "Stopped", not "Paused": it is what the Stop queue button did and what Start queue undoes.
	private string QueueStatusLabel => _queueState.IsPaused
		? "Stopped"
		: IsQueueRunning ? "Running" : "Idle";

	private string QueueStatusTheme => _queueState.IsPaused
		? "theme-warning"
		: IsQueueRunning ? "theme-success" : "theme-secondary";

	/// <summary>Nothing to list and no button to press: All jobs moves down beside the empty message.</summary>
	private bool IsQuiet => TotalItemCount == 0 && !_queueState.IsPaused && !IsQueueRunning;

	private int BadgeCount => _snapshot.RunningJobsCount + _snapshot.QueuedJobsCount;
	private int TotalItemCount => BadgeCount + _snapshot.UpcomingIdeasCount;

	/// <summary>
	/// The header's line of counts, in the words the sections below use, leaving out anything
	/// there is none of. Empty when the queue is.
	/// </summary>
	private List<string> QueueSummary
	{
		get
		{
			// The server counts jobs waiting on the user as running; they get their own section.
			var needsYou = _snapshot.RunningJobs.Count(NeedsYou);
			var running = Math.Max(0, _snapshot.RunningJobsCount - needsYou);
			var ideas = _snapshot.UpcomingIdeasCount;
			var parts = new List<string>(4);

			if (running > 0) parts.Add($"{running} running");
			if (needsYou > 0) parts.Add(needsYou == 1 ? "1 needs you" : $"{needsYou} need you");
			if (_snapshot.QueuedJobsCount > 0) parts.Add($"{_snapshot.QueuedJobsCount} queued");
			if (ideas > 0) parts.Add(ideas == 1 ? "1 upcoming idea" : $"{ideas} upcoming ideas");

			return parts;
		}
	}

	/// <summary>Waiting for a reply or stalled: the job can't go on without the user.</summary>
	private static bool NeedsYou(GlobalQueueJobSummary job) => job.Status is JobStatus.Paused or JobStatus.Stalled;

	private static string GetJobHref(GlobalQueueJobSummary job) => $"/jobs/view/{job.Id}";

	private static string GetProjectLabel(string? projectName) =>
		string.IsNullOrWhiteSpace(projectName) ? "Unknown project" : projectName;

	private static string GetRunningSubtitle(GlobalQueueJobSummary job)
	{
		var activity = !string.IsNullOrWhiteSpace(job.CurrentActivity)
			? job.CurrentActivity
			: job.Status == JobStatus.Planning ? "Planning…" : "Working…";
		return $"{GetProjectLabel(job.ProjectName)} · {activity}";
	}

	// The reason leads, so a narrow row cuts the project name rather than what the job needs.
	private static string GetAttentionLine(GlobalQueueJobSummary job) =>
		$"{(job.Status == JobStatus.Paused ? "Waiting for your reply" : "Stalled")} · {GetProjectLabel(job.ProjectName)}";

	/// <summary>A row's trailing fact: how long since it started or was queued.</summary>
	private static RenderFragment RenderSince(DateTime since, string label) => __builder =>
	{
		<span class="small fg-1 flex-shrink-0" title="@($"{label} {since.FormatDateTimeShort()}")">@since.FormatShortAge()</span>
	};

	protected override async Task OnInitializedAsync()
	{
		QueuePanelStateService.RefreshRequested += RefreshQueueAsync;
		await RefreshQueueAsync();
	}

	private async Task HandleToggleAsync()
	{
		await RefreshQueueAsync();
	}

	private async Task RefreshQueueAsync()
	{
		if (_isLoadingSnapshot)
		{
			_pendingRefresh = true;
			return;
		}

		do
		{
			_pendingRefresh = false;
			_isLoadingSnapshot = true;

			try
			{
				_snapshot = await IdeaService.GetGlobalQueueSnapshotAsync();
				_queueState = await JobQueueControl.GetStateAsync();
				_loadError = null;
				_hasLoadedSnapshot = true;
			}
			catch (Exception ex)
			{
				_loadError = $"Failed to load queue: {ex.Message}";
			}
			finally
			{
				_isLoadingSnapshot = false;
			}

			await InvokeAsync(StateHasChanged);
		}
		while (_pendingRefresh);
	}

	private async Task StartQueueAsync()
	{
		if (_isMutatingQueue || _snapshot.UpcomingIdeasCount == 0)
		{
			return;
		}

		_isMutatingQueue = true;
		try
		{
			await IdeaService.StartAllProcessingAsync();
			NotificationService.ShowSuccess("Started queued ideas across active projects.", "Queue started");
			await RefreshQueueAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to start queue: {ex.Message}");
		}
		finally
		{
			_isMutatingQueue = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	/// <summary>
	/// Stops the queue for real: no new jobs start, and idea auto-processing stops feeding
	/// it. <paramref name="cancelRunning"/> also stops the jobs already in flight.
	/// </summary>
	private async Task StopQueueAsync(bool cancelRunning)
	{
		if (_isMutatingQueue)
		{
			return;
		}

		_isMutatingQueue = true;
		try
		{
			var state = await JobQueueControl.PauseAsync("Stopped from the queue panel", cancelRunning);

			// Leaving idea processing on would keep converting ideas into jobs that then
			// pile up pending, which is not what "stop" means to anyone.
			try
			{
				await IdeaService.StopAllProcessingAsync();
			}
			catch
			{
				// The queue is already stopped; idea processing can be stopped separately.
			}

			NotificationService.ShowSuccess(
				cancelRunning
					? $"Queue stopped. {state.CancelledJobs} running job{(state.CancelledJobs == 1 ? string.Empty : "s")} asked to stop."
					: "Queue stopped. Running jobs will finish.",
				"Queue stopped");

			await RefreshQueueAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to stop queue: {ex.Message}");
		}
		finally
		{
			_isMutatingQueue = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task ResumeQueueAsync()
	{
		if (_isMutatingQueue)
		{
			return;
		}

		_isMutatingQueue = true;
		try
		{
			await JobQueueControl.ResumeAsync();
			NotificationService.ShowSuccess("Queue resumed. Pending jobs will start again.", "Queue resumed");
			await RefreshQueueAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to resume queue: {ex.Message}");
		}
		finally
		{
			_isMutatingQueue = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	public void Dispose()
	{
		QueuePanelStateService.RefreshRequested -= RefreshQueueAsync;
	}
}
