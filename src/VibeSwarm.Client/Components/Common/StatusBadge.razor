@* Reusable status badge component with consistent styling *@

<span class="badge @GetStatusClass()">
	@if (ShowSpinner && IsActiveStatus())
	{
		<span class="spinner-border spinner-sm me-1" style="width: 0.6rem; height: 0.6rem;" role="status"></span>
	}
	@DisplayText
</span>

@code {
	[Parameter]
	public string Status { get; set; } = string.Empty;

	[Parameter]
	public string? CustomText { get; set; }

	[Parameter]
	public bool ShowSpinner { get; set; } = true;

	private string DisplayText => CustomText ?? Status;

	private bool IsActiveStatus()
	{
		var status = Status.ToLowerInvariant();
		return status is "started" or "planning" or "processing" or "cancelling";
	}

	private string GetStatusClass()
	{
		var status = Status.ToLowerInvariant();
		return status switch
		{
			"new" => "theme-secondary",
			"pending" => "theme-warning",
			"started" or "planning" or "processing" => "theme-info",
			"completed" => "theme-success",
			"failed" => "theme-danger",
			"cancelled" => "theme-secondary",
			"cancelling" => "theme-warning",
			"active" => "theme-success",
			"disabled" or "off" => "theme-secondary",
			_ => "theme-secondary"
		};
	}
}
