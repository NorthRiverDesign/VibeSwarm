@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@implements IDisposable

@if (_isOpen)
{
    <div class="notifications-backdrop position-fixed inset-0" style="z-index: 1049;" @onclick="NotificationService.ClosePanel"></div>

    <div class="notifications-panel position-fixed bg-body border rounded-5 shadow-lg d-flex flex-column" style="z-index: 1050;">
        <div class="d-flex align-items-center justify-content-between px-5 py-3 border-bottom flex-shrink-0 bg-1 rounded-top-5">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-bell fg-secondary"></i>
                <span class="fw-semibold">Notifications</span>
            </div>
            <div class="d-flex align-items-center gap-5">
                @if (_history.Count > 0)
                {
                    <button class="btn-link btn-sm fg-secondary p-0 text-decoration-none small" @onclick="ClearAll"
                            @onclick:stopPropagation="true">
                        Clear all
                    </button>
                }
                <button class="btn-link fg-secondary p-0 lh-1" @onclick="NotificationService.ClosePanel" aria-label="Close">
                    <i class="bi bi-x-lg small"></i>
                </button>
            </div>
        </div>

        <div class="overflow-y-auto flex-grow-1 overscroll-contain">
            @if (_history.Count == 0)
            {
                <div class="d-flex flex-column align-items-center justify-content-center p-7 fg-secondary">
                    <i class="bi bi-bell-slash mb-3 fs-3xl opacity-50"></i>
                    <span class="small">No notifications yet</span>
                </div>
            }
            else
            {
                @foreach (var notification in _history)
                {
                    var isClickable = notification.HasAction;

                    <div class="notification-history-item d-flex gap-3 px-5 py-3 border-bottom @(isClickable ? "cursor-pointer" : string.Empty)"
                         role="@(isClickable ? "button" : null)"
                         tabindex="@(isClickable ? 0 : -1)"
                         @onclick="() => OpenNotification(notification)"
                         @onkeydown="(args) => HandleNotificationKeyDown(args, notification)">
                        <i class="@GetIconClass(notification.Type) flex-shrink-0 mt-1 small"></i>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-baseline justify-content-between gap-3">
                                <span class="fw-medium small text-truncate">@notification.Title</span>
                                <span class="fg-secondary flex-shrink-0 text-caption">@GetTimeAgo(notification.CreatedAt)</span>
                            </div>
                            <div class="small fg-secondary text-break">@notification.Message</div>
                            @if (notification.HasAction)
                            {
                                <div class="small mt-1">
                                    <span class="fg-primary fw-medium">@notification.ActionLabel</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private IReadOnlyList<ToastNotification> _history = Array.Empty<ToastNotification>();
    private Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        NotificationService.OnChange += OnNotificationChange;
        RefreshState();

        // Refresh "time ago" display periodically
        _refreshTimer = new Timer(_ => InvokeAsync(StateHasChanged),
            null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnNotificationChange()
    {
        RefreshState();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshState()
    {
        _isOpen = NotificationService.IsPanelOpen;
        _history = NotificationService.NotificationHistory;
    }

    private void ClearAll()
    {
        NotificationService.ClearHistory();
        RefreshState();
    }

    private void OpenNotification(ToastNotification notification)
    {
        if (!notification.HasAction || string.IsNullOrWhiteSpace(notification.ActionUrl))
        {
            return;
        }

        NotificationService.ClosePanel();
        NavigationManager.NavigateTo(notification.ActionUrl);
    }

    private void HandleNotificationKeyDown(KeyboardEventArgs args, ToastNotification notification)
    {
        if (!notification.HasAction)
        {
            return;
        }

        if (args.Key is "Enter" or " ")
        {
            OpenNotification(notification);
        }
    }

    private static string GetIconClass(NotificationType type) => type switch
    {
        NotificationType.Success => "bi bi-check-circle-fill fg-success",
        NotificationType.Error => "bi bi-x-circle-fill fg-danger",
        NotificationType.Warning => "bi bi-exclamation-triangle-fill fg-warning",
        NotificationType.Info => "bi bi-info-circle-fill fg-info",
        _ => "bi bi-bell-fill"
    };

    private static string GetTimeAgo(DateTime createdAt)
    {
        var elapsed = DateTime.UtcNow - createdAt;
        if (elapsed.TotalSeconds < 5) return "just now";
        if (elapsed.TotalSeconds < 60) return $"{(int)elapsed.TotalSeconds}s ago";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    public void Dispose()
    {
        NotificationService.OnChange -= OnNotificationChange;
        _refreshTimer?.Dispose();
    }
}
