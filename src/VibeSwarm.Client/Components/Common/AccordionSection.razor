@* Bootstrap accordion item on a native <details>, driven by Blazor state rather than the
   browser's own toggle, so expand/collapse survives re-renders. Wrap one or more in
   <div class="accordion">. *@

<details class="accordion-item" open="@IsOpen">
	<summary class="accordion-header gap-5" @onclick="Toggle" @onclick:preventDefault="true">
		@if (!string.IsNullOrWhiteSpace(Icon))
		{
			<i class="bi bi-@Icon fg-primary flex-shrink-0"></i>
		}
		<span class="d-flex flex-column min-w-0 flex-grow-1">
			@* The title wraps rather than truncates: on a phone the badge leaves it
			   little room, and "Providers and ag…" tells the user nothing. *@
			<span class="fw-medium fg-body">@Title</span>
			@if (!string.IsNullOrWhiteSpace(Summary))
			{
				<span class="small fg-1 text-truncate fw-normal">@Summary</span>
			}
		</span>
		@if (!string.IsNullOrWhiteSpace(Badge))
		{
			<span class="badge rounded-pill @BadgeClass flex-shrink-0">@Badge</span>
		}
		<AccordionIcon />
	</summary>
	<div class="accordion-body">
		@ChildContent
	</div>
</details>

@code {
	[Parameter, EditorRequired]
	public string Title { get; set; } = string.Empty;

	/// <summary>Bootstrap Icons name without the "bi-" prefix.</summary>
	[Parameter]
	public string? Icon { get; set; }

	/// <summary>Short description shown under the title so the section can stay collapsed.</summary>
	[Parameter]
	public string? Summary { get; set; }

	/// <summary>Optional pill shown on the right, e.g. the current setting.</summary>
	[Parameter]
	public string? Badge { get; set; }

	[Parameter]
	public string BadgeClass { get; set; } = "theme-secondary";

	[Parameter]
	public bool IsOpen { get; set; }

	[Parameter]
	public EventCallback<bool> IsOpenChanged { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private async Task Toggle()
	{
		IsOpen = !IsOpen;
		await IsOpenChanged.InvokeAsync(IsOpen);
	}
}
