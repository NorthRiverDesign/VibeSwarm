@* Reusable page header component with title, subtitle, and actions *@

<div class="d-flex @ResolvedAlignItemsClass justify-content-between gap-3 mb-7">
	<div class="min-w-0">
		<h1 class="mb-0 text-truncate">@Title</h1>
		@if (!string.IsNullOrWhiteSpace(Subtitle))
		{
			<p class="small fg-1 mb-0 mt-1 d-none sm:d-block">@Subtitle</p>
		}
	</div>
	@if (Actions != null)
	{
		<div class="d-flex align-items-center gap-3 flex-shrink-0 ms-auto">
			@Actions
		</div>
	}
</div>

@code {
	[Parameter]
	public string Title { get; set; } = string.Empty;

	/// <summary>One line orienting a first-time visitor. Hidden on the narrowest screens.</summary>
	[Parameter]
	public string? Subtitle { get; set; }

	[Parameter]
	public RenderFragment? Actions { get; set; }

	/// <summary>Overrides the alignment; by default a subtitle aligns to the top, a bare title centers.</summary>
	[Parameter]
	public string? AlignItemsClass { get; set; }

	private string ResolvedAlignItemsClass => AlignItemsClass
		?? (string.IsNullOrWhiteSpace(Subtitle) ? "align-items-center" : "align-items-center sm:align-items-start");
}
