@* Reusable modal dialog, built on Bootstrap's Dialog: a native <dialog> opened with
   showModal(), so the browser supplies the backdrop, focus trap, Escape key and stacking
   (a dialog opened from another one simply sits above it). Phones get a full-screen sheet. *@
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (IsVisible || _isOpen)
{
	<dialog @ref="_dialog" class="dialog @(FullscreenOnPhones ? "sm-down:dialog-fullscreen" : "") @SizeClass @(IsScrollable ? "dialog-scrollable" : "") @DialogClass"
			aria-labelledby="@(ShowHeader ? _titleId : null)" aria-label="@(ShowHeader ? null : Title)">
		@if (ShowHeader)
		{
		<div class="dialog-header gap-3 min-w-0">
			<h2 id="@_titleId" class="dialog-title mb-0 d-flex align-items-center gap-3 min-w-0">
				@if (!string.IsNullOrEmpty(Icon))
				{
					<i class="bi bi-@Icon opacity-75 flex-shrink-0"></i>
				}
				<span class="text-truncate">@Title</span>
			</h2>
			@if (ShowCloseButton)
			{
				<button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
			}
		</div>
		}
		<div class="dialog-body vs-dialog-body overflow-x-hidden overscroll-contain min-w-0 @BodyClass">
			@ChildContent
		</div>
		@if (FooterContent != null)
		{
			<div class="dialog-footer min-w-0">
				@FooterContent
			</div>
		}
	</dialog>
}

@code {
	public enum ModalSize
	{
		Small,
		Default,
		Large,
		ExtraLarge
	}

	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public EventCallback<bool> IsVisibleChanged { get; set; }

	[Parameter]
	public string Title { get; set; } = string.Empty;

	[Parameter]
	public string? Icon { get; set; }

	[Parameter]
	public ModalSize Size { get; set; } = ModalSize.Default;

	[Parameter]
	public bool IsScrollable { get; set; } = true;

	[Parameter]
	public bool ShowCloseButton { get; set; } = true;

	/// <summary>False drops the title bar, for a dialog that is all body (the search palette).
	/// <see cref="Title"/> still names the dialog for screen readers.</summary>
	[Parameter]
	public bool ShowHeader { get; set; } = true;

	/// <summary>Phones show the dialog as a full-screen sheet unless this is false.</summary>
	[Parameter]
	public bool FullscreenOnPhones { get; set; } = true;

	[Parameter]
	public bool CloseOnBackdropClick { get; set; } = true;

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public RenderFragment? FooterContent { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	/// <summary>Extra classes for the <c>&lt;dialog&gt;</c> element.</summary>
	[Parameter]
	public string? DialogClass { get; set; }

	[Parameter]
	public string? BodyClass { get; set; }

	public const string InteropModulePath = "./js/bootstrap-interop.js";

	private string SizeClass => Size switch
	{
		ModalSize.Small => "dialog-sm",
		ModalSize.Large => "dialog-lg",
		ModalSize.ExtraLarge => "dialog-xl",
		_ => ""
	};

	private readonly string _titleId = $"dialog-title-{Guid.NewGuid():N}";
	private ElementReference _dialog;
	private IJSObjectReference? _interop;
	private DotNetObjectReference<ModalDialog>? _selfReference;

	// The <dialog> stays rendered while it is open, and through its exit transition after
	// IsVisible turns false, so Bootstrap can animate it out before Blazor removes it.
	private bool _isOpen;
	private bool _isClosing;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (IsVisible && !_isOpen)
		{
			var interop = await GetInteropAsync();
			if (interop is null)
			{
				return;
			}

			_isOpen = true;
			_selfReference ??= DotNetObjectReference.Create(this);
			await interop.InvokeVoidAsync("showDialog", _dialog, _selfReference,
				new { closeOnBackdrop = CloseOnBackdropClick, closeOnEscape = true });
		}
		else if (!IsVisible && _isOpen && !_isClosing)
		{
			_isClosing = true;
			try
			{
				var interop = await GetInteropAsync();
				if (interop is not null)
				{
					await interop.InvokeVoidAsync("hideDialog", _dialog);
				}
			}
			catch (JSDisconnectedException)
			{
			}
			finally
			{
				_isOpen = false;
				_isClosing = false;
				StateHasChanged();
			}
		}
	}

	private async Task<IJSObjectReference?> GetInteropAsync()
	{
		_interop ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", InteropModulePath);
		return _interop;
	}

	/// <summary>Called by Bootstrap when the person closes the dialog with Escape or the backdrop.</summary>
	[JSInvokable]
	public async Task HandleDialogDismissed()
	{
		if (!_isOpen || _isClosing)
		{
			return;
		}

		// The browser has already closed the dialog; just let go of it.
		_isOpen = false;
		await Close();
	}

	public async Task Close()
	{
		IsVisible = false;
		await IsVisibleChanged.InvokeAsync(false);
		await OnClose.InvokeAsync();
		StateHasChanged();
	}

	public void Show()
	{
		IsVisible = true;
		StateHasChanged();
	}

	public async ValueTask DisposeAsync()
	{
		if (_interop is not null)
		{
			try
			{
				if (_isOpen)
				{
					await _interop.InvokeVoidAsync("disposeDialog", _dialog);
				}

				await _interop.DisposeAsync();
			}
			catch (JSDisconnectedException)
			{
			}
		}

		_isOpen = false;
		_selfReference?.Dispose();
	}
}
