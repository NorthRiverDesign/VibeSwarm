@* Three-dots menu for list-item CRUD actions. Consumers compose <RowActionsItem> children. *@

<div class="flex-shrink-0 @CssClass">
	<button class="@ButtonVariantClass theme-@ButtonStyle @ButtonSizeClass d-inline-flex align-items-center justify-content-center gap-1 @ButtonClass" type="button"
			data-bs-toggle="menu" data-bs-placement="@Placement" aria-expanded="false"
			aria-label="@AriaLabel"
			disabled="@Disabled">
		<i class="bi bi-three-dots-vertical"></i>
		@if (!string.IsNullOrEmpty(Label))
		{
			<span class="@(HideLabelOnMobile ? "d-none md:d-inline" : string.Empty)">@Label</span>
		}
		else if (!string.IsNullOrEmpty(MobileLabel))
		{
			<span class="d-inline sm:d-none ms-1">@MobileLabel</span>
		}
	</button>
	<div class="menu">
		@ChildContent
	</div>
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }

	/// <summary>Extra classes appended to the outer container.</summary>
	[Parameter] public string? CssClass { get; set; }

	/// <summary>Label shown next to the icon on XS screens only. Null/empty hides it.</summary>
	[Parameter] public string? MobileLabel { get; set; }

	[Parameter] public string? Label { get; set; }

	[Parameter] public bool HideLabelOnMobile { get; set; }

	/// <summary>ARIA label for the toggle button.</summary>
	[Parameter] public string AriaLabel { get; set; } = "More actions";

	/// <summary>Bootstrap theme colour for the toggle (primary|secondary|danger|...). Defaults to secondary.</summary>
	[Parameter] public string ButtonStyle { get; set; } = "secondary";

	/// <summary>Bootstrap button variant for the toggle (solid|outline|subtle|text). Defaults to solid.</summary>
	[Parameter] public string ButtonVariant { get; set; } = "solid";

	/// <summary>Button size: "sm" (default), "" (default size), or "lg".</summary>
	[Parameter] public string ButtonSize { get; set; } = "sm";

	/// <summary>Menu placement against the toggle. Defaults to <c>bottom-end</c> to avoid right-edge clipping on mobile.</summary>
	[Parameter] public string Placement { get; set; } = "bottom-end";

	/// <summary>When true, disables the toggle button.</summary>
	[Parameter] public bool Disabled { get; set; }

	[Parameter] public string? ButtonClass { get; set; }

	private string ButtonSizeClass => string.IsNullOrEmpty(ButtonSize) ? string.Empty : $"btn-{ButtonSize}";

	private string ButtonVariantClass => $"btn-{ButtonVariant}";
}
