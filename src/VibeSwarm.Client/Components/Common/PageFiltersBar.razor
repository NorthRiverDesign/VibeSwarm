@* Reusable index-page filter shell for search, tabs, and secondary actions *@

<div class="d-flex flex-column gap-3 @Class">
	@if (SearchContent != null)
	{
		<div class="min-w-0">
			@SearchContent
		</div>
	}

	@if (Tabs != null || Actions != null)
	{
		<div class="d-flex flex-column sm:flex-row align-items-stretch sm:align-items-center justify-content-between gap-3">
			@if (Tabs != null)
			{
				<div class="flex-grow-1 min-w-0">
					@Tabs
				</div>
			}

			@if (Actions != null)
			{
				<div class="d-flex flex-wrap align-items-stretch justify-content-end gap-3 flex-shrink-0 sm:ms-auto">
					@Actions
				</div>
			}
		</div>
	}
</div>

@code {
	[Parameter]
	public RenderFragment? SearchContent { get; set; }

	[Parameter]
	public RenderFragment? Tabs { get; set; }

	[Parameter]
	public RenderFragment? Actions { get; set; }

	[Parameter]
	public string Class { get; set; } = string.Empty;
}
