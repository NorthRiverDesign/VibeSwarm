@* Bootstrap badge used inline in meta rows. Variant maps to a Bootstrap theme-* colour. *@

<span class="badge @VariantClass d-inline-flex align-items-center gap-1 @CssClass">
	@if (!string.IsNullOrEmpty(Icon))
	{
		<i class="bi @Icon"></i>
	}
	@ChildContent
	@Text
</span>

@code {
	[Parameter] public string? Icon { get; set; }
	[Parameter] public string? Text { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? Variant { get; set; }
	[Parameter] public string? CssClass { get; set; }

	private string VariantClass => Variant?.ToLowerInvariant() switch
	{
		"sha" => "font-monospace theme-secondary",
		"pushed" => "theme-success",
		"failed" or "danger" => "theme-danger",
		"warning" or "warn" => "theme-warning",
		"info" => "theme-info",
		"ai" => "theme-primary",
		_ => "theme-secondary"
	};
}
