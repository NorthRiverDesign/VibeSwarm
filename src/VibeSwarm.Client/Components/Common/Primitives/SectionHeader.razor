@* A section's header: a small uppercase label with quiet actions on the right, sitting above the
   section's grouped list. Every page uses this one look for section headers. *@

<div class="d-flex flex-column gap-1 px-1 @WrapperClass">
	<div class="d-flex align-items-center gap-3 min-width-0">
		<h2 class="text-eyebrow mb-0 me-auto text-truncate">@Title</h2>
		@if (Actions != null)
		{
			<div class="d-flex align-items-center gap-3 flex-shrink-0">
				@Actions
			</div>
		}
	</div>
	@if (!string.IsNullOrEmpty(Subtitle))
	{
		<p class="small text-body-secondary mb-0">@Subtitle</p>
	}
</div>

@code {
	[Parameter] public string Title { get; set; } = string.Empty;
	[Parameter] public string? Subtitle { get; set; }
	[Parameter] public RenderFragment? Actions { get; set; }
	[Parameter] public string WrapperClass { get; set; } = string.Empty;
}
