@inject HttpSearchService SearchService
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<ModalDialog IsVisible="IsVisible" IsVisibleChanged="IsVisibleChanged" Title="Search" ShowHeader="false" FullscreenOnPhones="false"
             DialogClass="vs-search-dialog" BodyClass="p-0 d-flex flex-column">
            @* Search Input *@
            <div class="d-flex align-items-center gap-3 px-5 border-bottom" style="min-height: 52px;">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-sm fg-secondary flex-shrink-0" role="status"></span>
                }
                else
                {
                    <i class="bi bi-search fg-secondary flex-shrink-0"></i>
                }
                <input @ref="_inputRef"
                       autofocus
                       type="text"
                       class="form-control border-0 shadow-none ps-0 bg-transparent"
                       placeholder="Search projects, jobs, ideas..."
                       value="@_query"
                       @oninput="OnQueryChanged"
                       @onkeydown="OnKeyDown"
                       autocomplete="off"
                       spellcheck="false" />
                @if (!string.IsNullOrEmpty(_query))
                {
                    <button class="btn-link p-0 fg-secondary flex-shrink-0" @onclick="ClearQuery" tabindex="-1" aria-label="Clear">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
                <kbd class="border rounded px-1 fg-secondary bg-transparent flex-shrink-0 d-none sm:d-inline text-xs">Esc</kbd>
            </div>

            @* Results *@
            <div class="overflow-y-auto flex-grow-1 overscroll-contain" @onkeydown="OnKeyDown">
                @if (!string.IsNullOrWhiteSpace(_query) && _query.Trim().Length >= 2)
                {
                    @if (_result != null && _result.Items.Count > 0)
                    {
                        var allItems = _result.Items;
                        var projectItems = allItems.Where(i => i.Type == SearchResultType.Project).ToList();
                        var jobItems = allItems.Where(i => i.Type == SearchResultType.Job).ToList();
                        var ideaItems = allItems.Where(i => i.Type == SearchResultType.Idea).ToList();

                        @if (projectItems.Count > 0)
                        {
                            <div class="px-5 pt-3 pb-1">
                                <small class="fg-secondary fw-semibold text-uppercase text-eyebrow">Projects</small>
                            </div>
                            @foreach (var item in projectItems)
                            {
                                var flatIndex = allItems.IndexOf(item);
                                <button class="w-100 text-start border-0 bg-transparent d-flex align-items-center gap-5 px-5 py-3 hover-bg-tertiary @(_selectedIndex == flatIndex ? "bg-1" : "")"
                                        @onclick="() => NavigateTo(item)"
                                        @onmouseover="() => _selectedIndex = flatIndex">
                                    <i class="bi bi-folder fg-primary flex-shrink-0"></i>
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="fw-medium text-truncate">@item.Title</div>
                                        @if (!string.IsNullOrEmpty(item.Subtitle))
                                        {
                                            <div class="small fg-secondary text-truncate">@item.Subtitle</div>
                                        }
                                    </div>
                                </button>
                            }
                        }

                        @if (jobItems.Count > 0)
                        {
                            <div class="px-5 pt-3 pb-1 @(projectItems.Count > 0 ? "border-top mt-1" : "")">
                                <small class="fg-secondary fw-semibold text-uppercase text-eyebrow">Jobs</small>
                            </div>
                            @foreach (var item in jobItems)
                            {
                                var flatIndex = allItems.IndexOf(item);
                                <button class="w-100 text-start border-0 bg-transparent d-flex align-items-center gap-5 px-5 py-3 hover-bg-tertiary @(_selectedIndex == flatIndex ? "bg-1" : "")"
                                        @onclick="() => NavigateTo(item)"
                                        @onmouseover="() => _selectedIndex = flatIndex">
                                    <i class="bi bi-list-check fg-info flex-shrink-0"></i>
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="fw-medium text-truncate">@TruncateTitle(item.Title)</div>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.Subtitle))
                                            {
                                                <span class="small fg-secondary text-truncate">@item.Subtitle</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.StatusLabel))
                                            {
                                                <StatusBadge Status="@item.StatusLabel" ShowSpinner="false" />
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        }

                        @if (ideaItems.Count > 0)
                        {
                            <div class="px-5 pt-3 pb-1 @((projectItems.Count > 0 || jobItems.Count > 0) ? "border-top mt-1" : "")">
                                <small class="fg-secondary fw-semibold text-uppercase text-eyebrow">Ideas</small>
                            </div>
                            @foreach (var item in ideaItems)
                            {
                                var flatIndex = allItems.IndexOf(item);
                                <button class="w-100 text-start border-0 bg-transparent d-flex align-items-center gap-5 px-5 py-3 hover-bg-tertiary @(_selectedIndex == flatIndex ? "bg-1" : "")"
                                        @onclick="() => NavigateTo(item)"
                                        @onmouseover="() => _selectedIndex = flatIndex">
                                    <i class="bi bi-lightbulb fg-warning flex-shrink-0"></i>
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="fw-medium text-truncate">@TruncateTitle(item.Title)</div>
                                        @if (!string.IsNullOrEmpty(item.Subtitle))
                                        {
                                            <div class="small fg-secondary text-truncate">@item.Subtitle</div>
                                        }
                                    </div>
                                </button>
                            }
                        }

                        <div class="px-5 py-3 border-top">
                            <small class="fg-secondary">@_result.TotalCount result@(_result.TotalCount == 1 ? "" : "s")</small>
                        </div>
                    }
                    else if (!_isLoading && _result != null)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center p-12 fg-secondary">
                            <i class="bi bi-search mb-3 fs-xl"></i>
                            <div>No results for "<strong>@_query</strong>"</div>
                        </div>
                    }
                }
                else if (string.IsNullOrWhiteSpace(_query))
                {
                    <div class="d-flex flex-column align-items-center justify-content-center p-12 fg-secondary">
                        <i class="bi bi-search mb-3 fs-xl"></i>
                        <div class="small">Search projects, jobs, and ideas</div>
                    </div>
                }
            </div>

            @* Footer hints *@
            <div class="px-5 py-3 border-top d-flex align-items-center gap-5 bg-1">
                <span class="small fg-secondary d-flex align-items-center gap-1">
                    <kbd class="border rounded px-1 text-xs">↑↓</kbd> navigate
                </span>
                <span class="small fg-secondary d-flex align-items-center gap-1">
                    <kbd class="border rounded px-1 text-xs">↵</kbd> open
                </span>
                <span class="small fg-secondary d-flex align-items-center gap-1">
                    <kbd class="border rounded px-1 text-xs">Esc</kbd> close
                </span>
            </div>
</ModalDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    private string _query = string.Empty;
    private GlobalSearchResult? _result;
    private bool _isLoading;
    private int _selectedIndex = -1;
    private ElementReference _inputRef;
    private CancellationTokenSource? _debounceCts;

    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        // Each opening starts from an empty search.
        if (IsVisible && !_wasVisible)
        {
            _query = string.Empty;
            _result = null;
            _selectedIndex = -1;
        }

        _wasVisible = IsVisible;
    }

    private async Task OnQueryChanged(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _selectedIndex = -1;

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var cts = _debounceCts;

        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_query) || _query.Trim().Length < 2)
        {
            _result = null;
            _isLoading = false;
            StateHasChanged();
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            _result = await SearchService.SearchAsync(_query, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            _result = new GlobalSearchResult();
        }
        finally
        {
            _isLoading = false;
        }

        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_result == null || _result.Items.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            _selectedIndex = Math.Min(_selectedIndex + 1, _result.Items.Count - 1);
            StateHasChanged();
        }
        else if (e.Key == "ArrowUp")
        {
            _selectedIndex = Math.Max(_selectedIndex - 1, 0);
            StateHasChanged();
        }
        else if (e.Key == "Enter" && _selectedIndex >= 0 && _selectedIndex < _result.Items.Count)
        {
            NavigateTo(_result.Items[_selectedIndex]);
        }
    }

    private void NavigateTo(SearchResultItem item)
    {
        _ = Close();
        NavigationManager.NavigateTo(item.Url);
    }

    private void ClearQuery()
    {
        _query = string.Empty;
        _result = null;
        _selectedIndex = -1;
        StateHasChanged();
    }

    public async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private static string TruncateTitle(string title, int maxLength = 80)
    {
        if (string.IsNullOrEmpty(title)) return title;
        return title.Length <= maxLength ? title : title[..(maxLength - 3)] + "...";
    }

    public ValueTask DisposeAsync()
    {
        _debounceCts?.Cancel();
        return ValueTask.CompletedTask;
    }
}
