@* Reusable breadcrumb navigation component *@

@{
	// Phones get one back link to the page above, as an iOS navigation bar does: the whole
	// trail wraps onto extra lines there, and its last step repeats the title beneath it.
	var parent = Items.LastOrDefault(item => !string.IsNullOrEmpty(item.Href));
}

@if (parent != null)
{
	<div class="md:d-none mb-1">
		<a href="@parent.Href" class="small fg-1 text-decoration-none d-inline-flex align-items-center gap-1">
			<i class="bi bi-chevron-left"></i>@parent.Text
		</a>
	</div>
}

<nav aria-label="breadcrumb" class="mb-5 @(parent != null ? "d-none md:d-block" : null)">
	<ol class="breadcrumb">
		@foreach (var (item, index) in Items.Select((item, i) => (item, i)))
		{
			var isLast = index == Items.Count - 1;
			@if (index > 0)
			{
				<li class="breadcrumb-divider" aria-hidden="true"></li>
			}
			<li class="breadcrumb-item">
				@if (isLast)
				{
					<span class="breadcrumb-link active gap-1" aria-current="page">
						@if (!string.IsNullOrEmpty(item.Icon))
						{
							<i class="bi bi-@item.Icon"></i>
						}
						@item.Text
					</span>
				}
				else
				{
					<a href="@item.Href" class="breadcrumb-link gap-1">
						@if (!string.IsNullOrEmpty(item.Icon))
						{
							<i class="bi bi-@item.Icon"></i>
						}
						@item.Text
					</a>
				}
			</li>
		}
	</ol>
</nav>

@code {
	[Parameter]
	public List<BreadcrumbItem> Items { get; set; } = new();

	public class BreadcrumbItem
	{
		public string Text { get; set; } = string.Empty;
		public string? Href { get; set; }
		public string? Icon { get; set; }

		public BreadcrumbItem() { }

		public BreadcrumbItem(string text, string? href = null, string? icon = null)
		{
			Text = text;
			Href = href;
			Icon = icon;
		}
	}
}