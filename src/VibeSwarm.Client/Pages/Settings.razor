@page "/settings"
@attribute [Authorize]
@inject IDatabaseService DatabaseService
@inject NotificationService NotificationService

<PageHeader Title="Settings" Subtitle="Defaults that apply across every project and job." />

<ul class="nav gap-1 small flex-nowrap overflow-x-auto overflow-y-hidden overscroll-contain mb-7" aria-label="Settings section">
	@foreach (var (key, label) in Sections)
	{
		<li class="nav-item">
			<button type="button" class="nav-link rounded-pill px-5 @(_activeTab == key ? "active" : "")"
					aria-pressed="@(_activeTab == key ? "true" : "false")" @onclick="() => SetTab(key)">@label</button>
		</li>
	}
</ul>

@if (_activeTab == "app")
{
	<SettingsAppTab OnSettingsSaved="RefreshDatabaseSummary" />
}
else if (_activeTab == "database")
{
<SettingsDatabaseTab DatabaseSummary="@_databaseSummary" OnDatabaseChanged="RefreshDatabaseSummary" />
}
else
{
	<div class="d-flex flex-column gap-7">
		<div class="list-group rounded-9">
			<div class="list-group-item d-flex align-items-center gap-5 py-5">
				<img src="img/logo_icon.png" alt="" class="brand-icon flex-shrink-0" />
				<span class="min-w-0">
					<span class="d-block fw-medium">@AppBranding.Name</span>
					<span class="d-block small fg-1">@AppBranding.Tagline</span>
				</span>
			</div>
			<div class="list-group-item d-flex justify-content-between gap-5 small">
				<span class="fg-1 flex-shrink-0">Runtime</span>
				<span class="text-end text-break">@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</span>
			</div>
		</div>
		<ToolDetectionCard />
	</div>
}

@code {
	private static readonly (string Key, string Label)[] Sections = [("app", "General"), ("database", "Database"), ("about", "About")];
	private string _activeTab = "app";
	private DatabaseStorageSummary? _databaseSummary;

	private void SetTab(string tab)
	{
		_activeTab = tab;
	}

	protected override async Task OnInitializedAsync()
	{
		await LoadDatabaseSummary();
	}

	private async Task RefreshDatabaseSummary()
	{
		await LoadDatabaseSummary();
	}

	private async Task LoadDatabaseSummary()
	{
		try
		{
			_databaseSummary = await DatabaseService.GetStorageSummaryAsync();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to load database size: {ex.Message}");
		}
	}
}
