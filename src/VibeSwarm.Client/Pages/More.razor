@page "/more"
@attribute [Authorize]

@* The tab bar's More tab: every destination that doesn't have a tab of its own, as an iOS app
   lists them. Desktop shows the same links in the sidebar. *@

<PageHeader Title="More" />

<div class="d-flex flex-column gap-4">
	<section class="d-flex flex-column gap-2" aria-label="Automate">
		<SectionHeader Title="Automate" />
		<div class="list-group rounded-4">
			<ListRow Icon="calendar3" Title="Scheduler" Href="/scheduler" />
			<ListRow Icon="robot" Title="Agents" Href="/agents" />
			<ListRow Icon="stars" Title="Skills" Href="/skills" />
		</div>
	</section>

	<section class="d-flex flex-column gap-2" aria-label="Configure">
		<SectionHeader Title="Configure" />
		<div class="list-group rounded-4">
			<ListRow Icon="plug" Title="Providers" Href="/providers" />
			<ListRow Icon="cpu" Title="Inference" Href="/inference" />
			<AuthorizeView Roles="Admin">
				<Authorized>
					<ListRow Icon="people" Title="Users" Href="/users" />
				</Authorized>
			</AuthorizeView>
			<ListRow Icon="gear" Title="Settings" Href="/settings" />
		</div>
	</section>
</div>
