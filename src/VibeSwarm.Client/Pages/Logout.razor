@page "/logout"
@attribute [Authorize]
@inject NavigationManager NavigationManager

<PageTitle>Logout - VibeSwarm</PageTitle>

<ModalDialog IsVisible="true" Title="Log Out" Icon="box-arrow-right" Size="ModalDialog.ModalSize.Small"
			 ShowCloseButton="false" CloseOnBackdropClick="false" BodyClass="text-center" OnClose="Cancel">
	<ChildContent>
		@if (_isLoggingOut)
		{
			<div class="py-5">
				<LoadingSpinner />
				<p class="mb-0 fg-1">Logging out...</p>
			</div>
		}
		else
		{
			<p class="mb-5 fg-1">Are you sure you want to log out?</p>
		}
	</ChildContent>
	<FooterContent>
		@if (!_isLoggingOut)
		{
			<div class="d-flex justify-content-center gap-3 w-100">
				<ActionButton Icon="x-lg" Text="Cancel" OnClick="Cancel" />
				<ActionButton Icon="box-arrow-right" Text="Log Out" Style="ActionButton.ButtonStyle.Danger" OnClick="ConfirmLogout" />
			</div>
		}
	</FooterContent>
</ModalDialog>

@code {
    private bool _isLoggingOut = false;

    private void ConfirmLogout()
    {
        _isLoggingOut = true;
        NavigationManager.NavigateTo("/account/logout", forceLoad: true);
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/");
    }
}