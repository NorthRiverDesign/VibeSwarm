@page "/agents"
@attribute [Authorize]
@inject IAgentService AgentService
@inject NotificationService NotificationService

<PageHeader Title="Agents" Subtitle="Reusable presets that pair a purpose with a provider and model.">
	<Actions>
		<TitleAction Icon="plus-lg" Label="Add an agent" Primary="true" OnClick="ShowAddModal" />
	</Actions>
</PageHeader>

@if (_isLoading)
{
	<LoadingSpinner Text="Loading agents..." />
}
else if (!_agents.Any())
{
	<EmptyState Icon="robot" Title="No agents yet"
				Message="Agents are reusable presets — Security Reviewer, Front End Designer, Deployment Engineer — that keep work consistent across projects.">
		<ActionButton Icon="plus-lg" Text="New agent" Style="ActionButton.ButtonStyle.Primary"
					  Size="ActionButton.ButtonSize.Small" OnClick="ShowAddModal" />
	</EmptyState>
}
else
{
	<div class="list-group rounded-9">
		@foreach (var agent in _agents)
		{
			<AgentRow @key="agent.Id" Agent="agent" OnToggleEnabled="ToggleEnabled" OnEdit="EditAgent" OnDelete="ShowDeleteConfirmation" />
		}
	</div>
}

<AgentModal @bind-IsVisible="_showAgentModal" EditAgent="@_editingAgent" OnSaved="HandleAgentSaved"
			   OnCancelled="HandleModalCancelled" OnClosed="HandleAgentModalClosed" />

<ConfirmationModal @bind-IsVisible="_showDeleteModal" Title="Delete Agent"
				   Message="@($"Are you sure you want to delete {_agentToDelete?.Name}?")" SubMessage="This action cannot be undone."
				   ConfirmText="Delete" ButtonClass="btn-solid theme-danger" IsProcessing="_isDeleting" OnConfirm="ConfirmDelete"
				   OnCancel="CancelDelete" />

@code {
	private List<Agent> _agents = [];
	private bool _isLoading = true;
	private bool _showAgentModal;
	private Agent? _editingAgent;
	private bool _showDeleteModal;
	private Agent? _agentToDelete;
	private bool _isDeleting;

	protected override async Task OnInitializedAsync()
	{
		await LoadAgents();
	}

	private async Task LoadAgents()
	{
		_isLoading = true;
		try
		{
			_agents = (await AgentService.GetAllAsync()).ToList();
		}
		catch (Exception ex)
		{
			NotificationService.ShowError($"Failed to load agents: {ex.Message}");
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void ShowAddModal()
	{
		_showDeleteModal = false;
		_agentToDelete = null;
		_editingAgent = null;
		_showAgentModal = true;
		StateHasChanged();
	}

	private void EditAgent(Agent agent)
	{
		_showDeleteModal = false;
		_agentToDelete = null;
		_editingAgent = agent;
		_showAgentModal = true;
		StateHasChanged();
	}

	private async Task HandleAgentSaved(Guid? newAgentId)
	{
		_showAgentModal = false;
		_editingAgent = null;
		await LoadAgents();
	}

	private void HandleModalCancelled()
	{
		_showAgentModal = false;
		_editingAgent = null;
	}

	private void HandleAgentModalClosed()
	{
		_showAgentModal = false;
		_editingAgent = null;
		StateHasChanged();
	}

	private void ShowDeleteConfirmation(Agent agent)
	{
		_showAgentModal = false;
		_editingAgent = null;
		_agentToDelete = agent;
		_showDeleteModal = true;
		StateHasChanged();
	}

	private void CancelDelete()
	{
		_showDeleteModal = false;
		_agentToDelete = null;
	}

	private async Task ConfirmDelete()
	{
		if (_agentToDelete == null)
		{
			return;
		}

		_isDeleting = true;
		try
		{
			await AgentService.DeleteAsync(_agentToDelete.Id);
			_showDeleteModal = false;
			_agentToDelete = null;
			await LoadAgents();
		}
		finally
		{
			_isDeleting = false;
		}
	}

	private async Task ToggleEnabled(Agent agent)
	{
		try
		{
			agent.IsEnabled = !agent.IsEnabled;
			await AgentService.UpdateAsync(agent);
			await LoadAgents();
		}
		catch (Exception)
		{
		}
	}
}
