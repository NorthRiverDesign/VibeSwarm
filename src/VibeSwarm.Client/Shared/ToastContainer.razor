@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

@* A manual popover, so the toasts share the browser's top layer with open dialogs and
   show above them rather than under their backdrop. *@
<div @ref="_layer" class="toast-container position-fixed top-0 end-0 p-5" popover="manual" data-vs-toast-layer>
	@foreach (var notification in NotificationService.Notifications)
	{
		<div class="toast show @GetToastClass(notification.Type)" role="alert" aria-live="assertive"
			aria-atomic="true">
			<div class="toast-header gap-3">
				<i class="@notification.IconClass"></i>
				<strong class="me-auto">@notification.Title</strong>
				<small class="fg-1">@notification.CreatedAt.FormatRelativeToNow()</small>
				<button type="button" class="btn-close" aria-label="Close"
					@onclick="() => Dismiss(notification.Id)"></button>
			</div>
			<div class="toast-body">
				<div class="text-break">@notification.Message</div>

				@if (notification.HasAction)
				{
					<div class="mt-5 d-flex justify-content-end">
						<button type="button"
								class="btn-solid theme-primary btn-sm"
								@onclick="() => HandleAction(notification)">
							<i class="bi bi-box-arrow-up-right"></i>@notification.ActionLabel
						</button>
					</div>
				}
			</div>
		</div>
	}
</div>

@code {
	private ElementReference _layer;
	private IJSObjectReference? _interop;
	private bool _layerShown;
	private int _shownCount;
	private Timer? _autoRemoveTimer;
	private Timer? _refreshTimer;
	private Action? _onNotificationChanged;

	protected override void OnInitialized()
	{
		_onNotificationChanged = () => _ = InvokeAsync(StateHasChanged);
		NotificationService.OnChange += _onNotificationChanged;

		// Timer to auto-remove expired notifications
		_autoRemoveTimer = new Timer(_ =>
		{
			InvokeAsync(() =>
	{
			var now = DateTime.UtcNow;
			var expiredNotifications = NotificationService.Notifications
	.Where(n => (now - n.CreatedAt).TotalMilliseconds > n.DurationMs)
	.ToList();

			foreach (var notification in expiredNotifications)
			{
				NotificationService.Remove(notification.Id);
			}
		});
		}, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

		// Timer to refresh "time ago" display
		_refreshTimer = new Timer(_ =>
		{
			InvokeAsync(StateHasChanged);
		}, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
	}

	private void Dismiss(Guid id)
	{
		NotificationService.Remove(id);
	}

	private void HandleAction(ToastNotification notification)
	{
		if (!notification.HasAction || string.IsNullOrWhiteSpace(notification.ActionUrl))
		{
			return;
		}

		NotificationService.Remove(notification.Id);
		NavigationManager.NavigateTo(notification.ActionUrl);
	}

	private string GetToastClass(NotificationType type)
	{
		return type switch
		{
			NotificationType.Success => "theme-success",
			NotificationType.Error => "theme-danger",
			NotificationType.Warning => "theme-warning",
			NotificationType.Info => "theme-info",
			_ => ""
		};
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// Show the layer while there are toasts. A new toast shows it again, which also lifts
		// it above any dialog that opened since; re-renders that add nothing leave it be, as
		// re-showing restarts the toasts' entrance animation.
		var count = NotificationService.Notifications.Count();
		var hasToasts = count > 0;
		var arrived = count > _shownCount;
		_shownCount = count;
		if (hasToasts == _layerShown && !arrived)
		{
			return;
		}

		try
		{
			_interop ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModalDialog.InteropModulePath);
			if (_interop is null)
			{
				return;
			}

			await _interop.InvokeVoidAsync(hasToasts ? "raiseToastLayer" : "hideToastLayer");
			_layerShown = hasToasts;
		}
		catch (JSDisconnectedException)
		{
		}
	}

	public void Dispose()
	{
		_ = _interop?.DisposeAsync();
		if (_onNotificationChanged != null)
		{
			NotificationService.OnChange -= _onNotificationChanged;
			_onNotificationChanged = null;
		}
		_autoRemoveTimer?.Dispose();
		_refreshTimer?.Dispose();
	}
}
