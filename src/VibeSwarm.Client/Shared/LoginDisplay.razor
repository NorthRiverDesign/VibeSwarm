@using Microsoft.AspNetCore.Components.Authorization
@inject ChangePasswordModalService ChangePasswordModalService
@inject NotificationService NotificationService
@inject ThemeService ThemeService

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-end gap-3">
            @* Desktop: User info with gear dropdown on the right *@
            <div class="d-none lg:d-flex justify-content-between align-items-center w-100 gap-1">
                <div class="d-flex align-items-center gap-3 fg-secondary">
                    <i class="bi bi-person-circle"></i>
                    <span class="fw-semibold fg-body">@context.User.Identity?.Name</span>
                </div>
                <div class="d-flex align-items-center gap-5">
                    <NotificationsPanel OpenUpward="true" />
                    <QueueDropdownPanel OpenUpward="true" />
                    <div>
                        <button class="btn-link fg-secondary p-0 lh-1" type="button" data-bs-toggle="menu" data-bs-placement="top-end"
                                aria-expanded="false" title="User options">
                            <i class="bi bi-gear"></i>
                        </button>
                        <div class="menu" style="min-width: 16rem;">
                            <ThemeSelector SelectedTheme="_selectedTheme" IsLoading="_isUpdatingTheme"
                                           OnThemeSelected="HandleThemeSelected" />
                            <hr class="menu-divider">
                            <button class="menu-item" type="button" @onclick="ShowChangePasswordModal">
                                <i class="bi bi-key"></i>Change Password
                            </button>
                            <hr class="menu-divider">
                            <a class="menu-item" href="/logout">
                                <i class="bi bi-box-arrow-right"></i>Log Out
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @* Mobile: Compact dropdown with user icon *@
			<div class="lg:d-none mobile-header-dropdown">
				<button class="btn-link fg-secondary p-0 fs-lg d-flex lh-1 touch-manipulation mobile-header-icon" type="button"
						data-bs-toggle="menu" data-bs-placement="bottom-end" data-bs-display="static" aria-expanded="false" title="User menu" aria-label="User menu">
					<i class="bi bi-person-circle"></i>
				</button>
                <div class="menu" style="min-width: 16rem;">
                    <div class="menu-header">
                        <span class="fw-semibold">@context.User.Identity?.Name</span>
                    </div>
                    <hr class="menu-divider">
                    <ThemeSelector SelectedTheme="_selectedTheme" IsLoading="_isUpdatingTheme"
                                   OnThemeSelected="HandleThemeSelected" />
                    <hr class="menu-divider">
                    <button class="menu-item" type="button" @onclick="ShowChangePasswordModal">
                        <i class="bi bi-key"></i>Change Password
                    </button>
                    <hr class="menu-divider">
                    <a class="menu-item" href="/logout">
                        <i class="bi bi-box-arrow-right"></i>Log Out
                    </a>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="/login" class="btn-sm btn-solid theme-primary">Login</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ThemePreference _selectedTheme = ThemePreference.System;
    private bool _hasLoadedThemePreference;
    private bool _isUpdatingTheme;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasLoadedThemePreference)
        {
            return;
        }

        _hasLoadedThemePreference = true;
        _selectedTheme = await ThemeService.GetThemePreferenceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ShowChangePasswordModal()
    {
        ChangePasswordModalService.Show();
    }

    private async Task HandleThemeSelected(ThemePreference themePreference)
    {
        if (_isUpdatingTheme || _selectedTheme == themePreference)
        {
            return;
        }

        var previousTheme = _selectedTheme;
        _selectedTheme = themePreference;
        _isUpdatingTheme = true;

        try
        {
            await ThemeService.UpdateThemePreferenceAsync(themePreference);
        }
        catch (Exception ex)
        {
            _selectedTheme = previousTheme;
            NotificationService.ShowError(ex.Message, "Theme update failed");
        }
        finally
        {
            _isUpdatingTheme = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
