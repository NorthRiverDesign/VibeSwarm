@* Reusable empty state component for consistent empty UI across pages *@

<div class="d-flex flex-column align-items-center justify-content-center py-7 px-5 text-center bg-2 rounded-5"
    style="min-height: 200px">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <div class="fs-4xl fg-2 mb-5 opacity-50">
            <i class="bi bi-@Icon"></i>
        </div>
    }
    <div style="max-width: 320px">
        <h3 class="mb-3">@Title</h3>
        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="small fg-secondary mb-5">@Message</p>
        }
        @if (ChildContent != null)
        {
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                @ChildContent
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = "inbox";

    [Parameter]
    public string Title { get; set; } = "Nothing here yet";

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}