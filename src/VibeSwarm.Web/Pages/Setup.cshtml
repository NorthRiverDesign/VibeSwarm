@page "/setup"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@model VibeSwarm.Web.Pages.SetupModel
@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

	<head>
		<meta charset="utf-8" />
		<script>
			(function () {
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.setAttribute('data-bs-theme', prefersDark ? 'dark' : 'light');
			})();
		</script>
		<meta name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<title>Setup - VibeSwarm</title>
		<base href="~/" />
		<link href="lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
		<link href="css/bootstrap-icons.min.css" rel="stylesheet" />
		<link href="css/site.css" rel="stylesheet" />
	</head>

	<body>
		<div class="login-layout d-flex align-items-center justify-content-center"
			style="background-image: url('/img/login_bg.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; background-attachment: fixed;">
			<div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0, 0, 0, 0.5);">
			</div>
			<div class="login-content position-relative w-100 px-5" style="z-index: 1; max-width: 100%;">
				<div class="container-fluid">
					<div class="row justify-content-center">
						<div class="col-12 sm:col-10 md:col-8 lg:col-5 xl:col-4">
							<div class="text-center mb-7">
								<img src="/img/logo_color.png" alt="VibeSwarm Logo" class="img-fluid"
									style="max-width: 200px;" />
							</div>
							<div class="card shadow">
								<div class="card-body">
									<h3 class="text-center mb-3">
										<i class="bi bi-gear-fill me-3"></i>Initial Setup
									</h3>
									<p class="text-center fg-1 mb-7">Create your administrator account</p>

									@if (!string.IsNullOrEmpty(Model.ErrorMessage))
									{
										<div class="alert theme-danger" role="alert">
											<div class="flex-grow-1 min-w-0">
												<i class="bi bi-exclamation-circle me-3"></i>@Model.ErrorMessage
											</div>
										</div>
									}

									@if (Model.ValidationErrors?.Any() == true)
									{
										<div class="alert theme-danger" role="alert">
											<div class="flex-grow-1 min-w-0">
												<strong><i class="bi bi-exclamation-circle me-3"></i>Please fix the following
													errors:</strong>
												<ul class="mb-0 mt-3">
													@foreach (var error in Model.ValidationErrors)
													{
														<li>@error</li>
													}
												</ul>
											</div>
										</div>
									}

									<form method="post">
										<div class="mb-5">
											<label for="username" class="form-label">
												<i class="bi bi-person me-1"></i>Username
											</label>
											<input type="text" id="username" name="Username" class="form-control"
												placeholder="Enter admin username" value="@Model.Username" required
												pattern="^[a-zA-Z][a-zA-Z0-9._-]*$"
												title="Username must start with a letter and contain only letters, numbers, dots, underscores, or hyphens" />
											<div class="form-text">Username must start with a letter.</div>
										</div>

										<div class="mb-5">
											<label for="email" class="form-label">
												<i class="bi bi-envelope me-1"></i>Email <span
													class="fg-1">(optional)</span>
											</label>
											<input type="email" id="email" name="Email" class="form-control"
												placeholder="admin@example.com" value="@Model.Email" />
											<div class="form-text">Optional email for the admin account.</div>
										</div>

										<div class="mb-5">
											<label for="password" class="form-label">
												<i class="bi bi-lock me-1"></i>Password
											</label>
											<input type="password" id="password" name="Password" class="form-control"
												placeholder="Enter password" required minlength="8" />
										</div>

										<div class="mb-5">
											<label for="confirmPassword" class="form-label">
												<i class="bi bi-lock-fill me-1"></i>Confirm Password
											</label>
											<input type="password" id="confirmPassword" name="ConfirmPassword"
												class="form-control" placeholder="Confirm password" required
												minlength="8" />
										</div>

										<div class="alert theme-info mb-5">
											<div class="flex-grow-1 min-w-0">
												<strong><i class="bi bi-shield-check me-3"></i>Password
													Requirements:</strong>
												<ul class="mb-0 mt-3 small">
													<li>Minimum 8 characters</li>
													<li>At least one uppercase letter (A-Z)</li>
													<li>At least one lowercase letter (a-z)</li>
													<li>At least one digit (0-9)</li>
												</ul>
											</div>
										</div>

										<div class="d-grid">
											<button type="submit" class="btn-solid theme-primary btn-lg">
												<i class="bi bi-check-circle me-3"></i>Create Admin Account
											</button>
										</div>
									</form>

									<hr class="my-7" />

									<div class="text-center small fg-1">
										<p class="mb-1">
											<i class="bi bi-lightbulb me-1"></i>
											<strong>Tip:</strong> For future deployments, you can pre-configure admin
											credentials
										</p>
										<p class="mb-0">
											Set <code>DEFAULT_ADMIN_PASS</code> and optionally <code>DEFAULT_ADMIN_USER</code>
											to auto-create the first admin account and skip this setup screen.
										</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</body>

</html>
